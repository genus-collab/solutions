Cell["Square-lengths of the quantum idempotents.", "Text",ExpressionUUID->"81fe1422-e93a-4d0e-8776-ccbf70d8a251"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"sqrt\[CapitalDelta]", "[", "i_", "]"}], "=", 
  RowBox[{
   RowBox[{
    RowBox[{"Sqrt", "[", "  ", 
     RowBox[{
      RowBox[{"\[Epsilon]", "[", "1", "]"}], " ", 
      RowBox[{
       RowBox[{"\[Epsilon]", "[", "2", "]"}], "/", 
       RowBox[{"ee", "[", "3", "]"}]}]}], "]"}], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"3", " ", 
       RowBox[{"ee", "[", "3", "]"}]}], "+", 
      RowBox[{
       RowBox[{"ee", "[", "2", "]"}], " ", 
       RowBox[{
        RowBox[{"LLL", "[", "i", "]"}], "[", "y", "]"}]}]}], ")"}]}], "//", 
   "Simplify"}]}]], "Input",
 CellLabel->"In[64]:=",ExpressionUUID->"67a22f71-e8ed-4e30-b76e-6b855e7876a8"],

