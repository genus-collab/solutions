Cell[CellGroupData[{

Cell["Cyclic symmetrisation", "Section",ExpressionUUID->"0e48bb36-1dfa-476e-82f1-226b77349b7f"],

Cell["\<\
ToSymPolLL rewrites a cyclically symmetric polynomial in the LLL[i][y] as an \
explicit function of y (the odd generator o = 3 Sqrt[3] I y \
(eps1+eps2)^3/(1+27y)^2 is hardcoded in its output). CyclicQuotOpt is the \
workhorse for graph contributions; moncycproj is its lookup table of cyclic \
projections of LLL-monomials up to total degree MONMAX, loaded from the \
sidecar moncycproj.mx (the commented-out cell regenerates it from scratch). \
WARNING: the degy/degDelta arguments of CyclicQuotOpt are trusted - \
underestimating them silently gives wrong results.\
\>", "Text",ExpressionUUID->"29932730-218e-4341-8fdf-f9ba4e36d0ec"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ToSymPolLL", "[", "arg_", "]"}], ":=", 
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"arg", "===", "0"}], ",", "0", ",", "\[IndentingNewLine]", 
    RowBox[{"Block", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"argint", "=", "arg"}], ",", "par", ",", "exp", ",", "pol", 
        ",", "sol", ",", " ", "out", ",", "parodd", ",", "odd"}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"*", 
         RowBox[{"Do", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"Exponent", "[", 
                RowBox[{"argint", ",", 
                 RowBox[{
                  RowBox[{"LLL", "[", "ii", "]"}], "[", "y", "]"}]}], "]"}], 
               ">", "2"}], ",", 
              RowBox[{"argint", "=", 
               RowBox[{"LLpowreddiag", "[", 
                RowBox[{"argint", ",", 
                 RowBox[{
                  RowBox[{"LLL", "[", "ii", "]"}], "[", "y", "]"}]}], 
                "]"}]}]}], "]"}], ";"}], ",", 
           RowBox[{"{", 
            RowBox[{"ii", ",", "0", ",", "2"}], "}"}]}], "]"}]}], ";"}], 
       "**)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"exp", "=", 
        RowBox[{
         RowBox[{"Length", "[", 
          RowBox[{"CoefficientList", "[", 
           RowBox[{"argint", ",", 
            RowBox[{
             RowBox[{"LLL", "[", "0", "]"}], "[", "y", "]"}]}], "]"}], "]"}], 
         "-", "1"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"par", "=", 
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{"Flatten", "[", 
           RowBox[{
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"Partitions", "[", 
               RowBox[{"k", ",", "3"}], "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"k", ",", "0", ",", 
                RowBox[{"3", " ", "exp"}]}], "}"}]}], "]"}], ",", "1"}], 
           "]"}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"Length", "[", "#", "]"}], "<=", "exp"}], "&"}]}], 
         "]"}]}], ";", " ", "\[IndentingNewLine]", 
       RowBox[{"parodd", "=", 
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{"Flatten", "[", 
           RowBox[{
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"Partitions", "[", 
               RowBox[{"k", ",", "3"}], "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"k", ",", "0", ",", 
                RowBox[{"3", " ", 
                 RowBox[{"(", 
                  RowBox[{"exp", "-", "1"}], ")"}]}]}], "}"}]}], "]"}], ",", 
            "1"}], "]"}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"Length", "[", "#", "]"}], "<=", 
            RowBox[{"exp", "-", "2"}]}], "&"}]}], "]"}]}], ";", " ", 
       "\[IndentingNewLine]", 
       RowBox[{"odd", "=", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"LLL", "[", "0", "]"}], "[", "y", "]"}], "-", 
           RowBox[{
            RowBox[{"LLL", "[", "1", "]"}], "[", "y", "]"}]}], ")"}], 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"LLL", "[", "0", "]"}], "[", "y", "]"}], "-", 
           RowBox[{
            RowBox[{"LLL", "[", "2", "]"}], "[", "y", "]"}]}], ")"}], 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"LLL", "[", "1", "]"}], "[", "y", "]"}], "-", 
           RowBox[{
            RowBox[{"LLL", "[", "2", "]"}], "[", "y", "]"}]}], ")"}]}]}], ";",
        "\[IndentingNewLine]", 
       RowBox[{"pol", "=", 
        RowBox[{
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"AA", "[", "k", "]"}], 
            RowBox[{"Product", "[", 
             RowBox[{
              RowBox[{"SymmetricPolynomial", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"par", "[", 
                  RowBox[{"[", "k", "]"}], "]"}], "[", 
                 RowBox[{"[", "j", "]"}], "]"}], ",", 
                RowBox[{"Table", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"LLL", "[", "i", "]"}], "[", "y", "]"}], ",", 
                  RowBox[{"{", 
                   RowBox[{"i", ",", "0", ",", "2"}], "}"}]}], "]"}]}], "]"}],
               ",", 
              RowBox[{"{", 
               RowBox[{"j", ",", "1", ",", 
                RowBox[{"Length", "[", 
                 RowBox[{"par", "[", 
                  RowBox[{"[", "k", "]"}], "]"}], "]"}]}], "}"}]}], "]"}]}], 
           ",", 
           RowBox[{"{", 
            RowBox[{"k", ",", "1", ",", 
             RowBox[{"Length", "[", "par", "]"}]}], "}"}]}], "]"}], "+", 
         RowBox[{"odd", " ", 
          RowBox[{"Sum", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"AA", "[", 
              RowBox[{"k", "+", 
               RowBox[{"Length", "[", "par", "]"}]}], "]"}], 
             RowBox[{"Product", "[", 
              RowBox[{
               RowBox[{"SymmetricPolynomial", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"parodd", "[", 
                   RowBox[{"[", "k", "]"}], "]"}], "[", 
                  RowBox[{"[", "j", "]"}], "]"}], ",", 
                 RowBox[{"Table", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"LLL", "[", "i", "]"}], "[", "y", "]"}], ",", 
                   RowBox[{"{", 
                    RowBox[{"i", ",", "0", ",", "2"}], "}"}]}], "]"}]}], 
                "]"}], ",", 
               RowBox[{"{", 
                RowBox[{"j", ",", "1", ",", 
                 RowBox[{"Length", "[", 
                  RowBox[{"parodd", "[", 
                   RowBox[{"[", "k", "]"}], "]"}], "]"}]}], "}"}]}], "]"}]}], 
            ",", 
            RowBox[{"{", 
             RowBox[{"k", ",", "1", ",", 
              RowBox[{"Length", "[", "parodd", "]"}]}], "}"}]}], "]"}]}]}]}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"sol", "=", 
        RowBox[{
         RowBox[{"Solve", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"CoefficientList", "[", 
             RowBox[{
              RowBox[{"argint", "-", "pol"}], ",", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{
                 RowBox[{"LLL", "[", "0", "]"}], "[", "y", "]"}], ",", 
                RowBox[{
                 RowBox[{"LLL", "[", "1", "]"}], "[", "y", "]"}], ",", 
                RowBox[{
                 RowBox[{"LLL", "[", "2", "]"}], "[", "y", "]"}]}], "}"}]}], 
             "]"}], "==", "0"}], ",", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"AA", "[", "k", "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"k", ",", "1", ",", 
               RowBox[{
                RowBox[{"Length", "[", "par", "]"}], "+", 
                RowBox[{"Length", "[", "parodd", "]"}]}]}], "}"}]}], "]"}]}], 
          "]"}], "//", "Flatten"}]}], ";", " ", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"sol", "==", 
          RowBox[{"{", "}"}]}], ",", 
         RowBox[{
          RowBox[{
          "Print", "[", 
           "\"\<Error -- argument is not a cyclically symmetric polynomial in \
each LLL[i][y]\>\"", "]"}], ";", " ", 
          RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"out", "=", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"Sum", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"AA", "[", "k", "]"}], 
              RowBox[{"Product", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{"-", "1"}], ")"}], "^", 
                  RowBox[{
                   RowBox[{"par", "[", 
                    RowBox[{"[", "k", "]"}], "]"}], "[", 
                   RowBox[{"[", "j", "]"}], "]"}]}], " ", 
                 RowBox[{"e\[Alpha]", "[", 
                  RowBox[{
                   RowBox[{"par", "[", 
                    RowBox[{"[", "k", "]"}], "]"}], "[", 
                   RowBox[{"[", "j", "]"}], "]"}], "]"}], " ", 
                 RowBox[{
                  RowBox[{"L", "[", "y", "]"}], "^", "3"}]}], ",", 
                RowBox[{"{", 
                 RowBox[{"j", ",", "1", ",", 
                  RowBox[{"Length", "[", 
                   RowBox[{"par", "[", 
                    RowBox[{"[", "k", "]"}], "]"}], "]"}]}], "}"}]}], "]"}]}],
              ",", 
             RowBox[{"{", 
              RowBox[{"k", ",", "1", ",", 
               RowBox[{"Length", "[", "par", "]"}]}], "}"}]}], "]"}], "+", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"3", " ", 
              SqrtBox["3"], " ", "I", " ", 
              FractionBox[
               RowBox[{"y", " ", 
                SuperscriptBox[
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"\[Epsilon]", "[", "1", "]"}], "+", 
                   RowBox[{"\[Epsilon]", "[", "2", "]"}]}], ")"}], "3"]}], 
               SuperscriptBox[
                RowBox[{"(", 
                 RowBox[{"1", "+", 
                  RowBox[{"27", " ", "y"}]}], ")"}], "2"]]}], ")"}], 
            RowBox[{"Sum", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"AA", "[", 
                RowBox[{
                 RowBox[{"Length", "[", "par", "]"}], "+", "k"}], "]"}], 
               RowBox[{"Product", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{"-", "1"}], ")"}], "^", 
                   RowBox[{
                    RowBox[{"parodd", "[", 
                    RowBox[{"[", "k", "]"}], "]"}], "[", 
                    RowBox[{"[", "j", "]"}], "]"}]}], " ", 
                  RowBox[{"e\[Alpha]", "[", 
                   RowBox[{
                    RowBox[{"parodd", "[", 
                    RowBox[{"[", "k", "]"}], "]"}], "[", 
                    RowBox[{"[", "j", "]"}], "]"}], "]"}], " ", 
                  RowBox[{
                   RowBox[{"L", "[", "y", "]"}], "^", "3"}]}], ",", 
                 RowBox[{"{", 
                  RowBox[{"j", ",", "1", ",", 
                   RowBox[{"Length", "[", 
                    RowBox[{"parodd", "[", 
                    RowBox[{"[", "k", "]"}], "]"}], "]"}]}], "}"}]}], "]"}]}],
               ",", 
              RowBox[{"{", 
               RowBox[{"k", ",", "1", ",", 
                RowBox[{"Length", "[", "parodd", "]"}]}], "}"}]}], "]"}]}]}], 
          "/.", "sol"}], "//", "Simplify"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"*", 
          RowBox[{"Print", "[", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"AA", "[", "k", "]"}], "/.", "sol"}], ",", 
             RowBox[{"{", 
              RowBox[{"k", ",", "1", ",", 
               RowBox[{
                RowBox[{"Length", "[", "par", "]"}], "+", "1"}]}], "}"}]}], 
            "]"}], "]"}]}], ";"}], "**)"}], "\[IndentingNewLine]", "out"}]}], 
     "\[IndentingNewLine]", "]"}]}], "]"}]}]], "Input",
