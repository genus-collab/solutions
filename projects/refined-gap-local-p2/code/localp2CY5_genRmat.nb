          RowBox[{"polPFLdiag", "[", 
           RowBox[{"y", ",", "var"}], "]"}], ",", "var"}], "]"}], ",", 
        "var"}], "]"}]}], "//", "Factor"}]}], "]"}]}]], "Input",
