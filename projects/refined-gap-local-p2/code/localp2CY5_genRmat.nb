            RowBox[{"arg", ",", "z", ",", "k"}], "]"}], ",", 
           RowBox[{
            RowBox[{"LLL", "[", "i", "]"}], "[", "y", "]"}]}], "]"}], " ", 
         RowBox[{"z", "^", "k"}]}], "//", "Simplify"}], ",", 
       RowBox[{"{", 
        RowBox[{"k", ",", "0", ",", "ZMAX"}], "}"}]}], "]"}]}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[54]:=",ExpressionUUID->"28bec71e-55a8-4d27-8710-14ba2e5821f4"],

Cell["\<\
The fibrewise limit of the weights, taken globally from here on.\
\>", "Text",ExpressionUUID->"be8c1251-c457-48a9-a5f7-aba1787257d3"],

