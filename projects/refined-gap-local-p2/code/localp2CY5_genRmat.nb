           RowBox[{"y", ",", "var"}], "]"}], ",", "var"}], "]"}], ",", 
        "var"}], "]"}], "/", 
      RowBox[{"Collect", "[", 
       RowBox[{
        RowBox[{"PolynomialRemainder", "[", 
         RowBox[{
