     RowBox[{
      RowBox[{
       RowBox[{"ee", "[", "2", "]"}], "^", "2"}], "/", "3"}], "/", 
     RowBox[{"ee", "[", "3", "]"}]}]}], ";"}]}]], "Input",
 CellLabel->"In[15]:=",ExpressionUUID->"ff8e81a2-87b7-41e2-9377-bb17c6724752"],

