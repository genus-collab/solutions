Notebook[{

Cell[CellGroupData[{
Cell["Local P2 x C2: minimal genus <= 2 pipeline", "Title",ExpressionUUID->"082ff647-e89d-437a-8cb0-02bb64fc652f"],

Cell["\<\
Equivariant Gromov-Witten free energies F03, F04, F05 (genus 0, 3-5 points), \
F11 (genus 1) and F20 (genus 2) of K_P2 x C^2, extracted as the strict \
dependency chain from localp2final_CY5_v15.nb (the R-matrix coefficients cPP \
and the cyclic-projection table moncycproj are carried over as precomputed \
data; their derivations live in v15). Requires the sidecar file moncycproj.mx \
in the same directory. Evaluate linearly top to bottom. Approximate timings \
on the original machine: F03/F11 seconds-to-minutes, gr04[3] ~12 min, several \
gr05/gr20 terms take tens of minutes each (gr20 total is hours-scale).\
\>", "Text",ExpressionUUID->"042009e5-0c22-4269-889c-6743286ceca8"],

Cell[CellGroupData[{

Cell["Setup", "Section",ExpressionUUID->"d9d2e9fa-a521-4613-8032-45bdd29d1ddd"],

Cell["Degree cutoff of the instanton expansion.", "Text",ExpressionUUID->"fb7a0338-8d2e-4b2e-8894-efe09c30d0a4"],

Cell[BoxData[
 RowBox[{
  RowBox[{"DMAX", "=", "4"}], ";"}]], "Input",
 CellLabel->"In[1]:=",ExpressionUUID->"f9878670-7d0e-4cd6-a19a-105042890785"],

Cell["\<\
Replacement for Combinatorica Partitions[n,m] (partitions of n into parts <= \
m), used by ToSymPolLL below. v15 loaded the deprecated Combinatorica package \
for this single function.\
\>", "Text",ExpressionUUID->"323e4049-0629-4b9e-a574-f084b2ec71c0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Partitions", "[", 
   RowBox[{"n_Integer", ",", "m_Integer"}], "]"}], ":=", 
  RowBox[{"IntegerPartitions", "[", 
   RowBox[{"n", ",", "\[Infinity]", ",", 
    RowBox[{"Range", "[", "m", "]"}]}], "]"}]}]], "Input",
 CellLabel->"In[2]:=",ExpressionUUID->"e9c69240-d625-45b2-9f47-86c9c93f7aa0"],

Cell["\<\
Chiral ring relation (p+a0)(p+a1)(p+a2)=0 for the torus weights a_i on P2, \
and the topological metric in terms of the elementary symmetric polynomials \
ee[i] of the weights; eps[1], eps[2] are the weights on the C^2 factor.\
\>", "Text",ExpressionUUID->"c0f9bf5c-80f2-48b7-952b-7627287445b0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Replp3", "=", 
  RowBox[{
   RowBox[{"-", 
    RowBox[{"Expand", "[", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"p", "+", 
        RowBox[{"\[Alpha]", "[", "0", "]"}]}], ")"}], 
      RowBox[{"(", 
       RowBox[{"p", "+", 
        RowBox[{"\[Alpha]", "[", "1", "]"}]}], ")"}], 
      RowBox[{"(", 
       RowBox[{"p", "+", 
        RowBox[{"\[Alpha]", "[", "2", "]"}]}], ")"}]}], "]"}]}], "+", 
   RowBox[{"p", "^", "3"}]}]}]], "Input",
 CellLabel->"In[3]:=",ExpressionUUID->"e203ebaa-e06e-4eec-a778-cf339f6df091"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"-", 
    SuperscriptBox["p", "2"]}], " ", 
   RowBox[{"\[Alpha]", "[", "0", "]"}]}], "-", 
  RowBox[{
   SuperscriptBox["p", "2"], " ", 
   RowBox[{"\[Alpha]", "[", "1", "]"}]}], "-", 
  RowBox[{"p", " ", 
   RowBox[{"\[Alpha]", "[", "0", "]"}], " ", 
   RowBox[{"\[Alpha]", "[", "1", "]"}]}], "-", 
  RowBox[{
   SuperscriptBox["p", "2"], " ", 
   RowBox[{"\[Alpha]", "[", "2", "]"}]}], "-", 
  RowBox[{"p", " ", 
   RowBox[{"\[Alpha]", "[", "0", "]"}], " ", 
   RowBox[{"\[Alpha]", "[", "2", "]"}]}], "-", 
  RowBox[{"p", " ", 
   RowBox[{"\[Alpha]", "[", "1", "]"}], " ", 
   RowBox[{"\[Alpha]", "[", "2", "]"}]}], "-", 
  RowBox[{
   RowBox[{"\[Alpha]", "[", "0", "]"}], " ", 
   RowBox[{"\[Alpha]", "[", "1", "]"}], " ", 
   RowBox[{"\[Alpha]", "[", "2", "]"}]}]}]], "Output",
 CellChangeTimes->{3.9972464266630726`*^9, 3.9975212355275464`*^9},
 CellLabel->"Out[3]=",ExpressionUUID->"7131e8fe-e5d7-41ab-9051-9ea4976a914e"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 TagBox[
  RowBox[{"\[Eta]", "=", 
   RowBox[{"-", 
    RowBox[{"(", "\[NoBreak]", GridBox[{
       {
        RowBox[{"-", 
         FractionBox["1", 
          RowBox[{"3", " ", 
           RowBox[{"ee", "[", "3", "]"}], " ", 
           RowBox[{"\[Epsilon]", "[", "1", "]"}], " ", 
           RowBox[{"\[Epsilon]", "[", "2", "]"}]}]]}], "0", "0"},
       {"0", "0", 
        FractionBox["1", 
         RowBox[{"3", " ", 
          RowBox[{"\[Epsilon]", "[", "1", "]"}], " ", 
          RowBox[{"\[Epsilon]", "[", "2", "]"}]}]]},
       {"0", 
        FractionBox["1", 
         RowBox[{"3", " ", 
          RowBox[{"\[Epsilon]", "[", "1", "]"}], " ", 
          RowBox[{"\[Epsilon]", "[", "2", "]"}]}]], 
        FractionBox[
         RowBox[{"-", 
          RowBox[{"ee", "[", "1", "]"}]}], 
         RowBox[{"3", " ", 
          RowBox[{"\[Epsilon]", "[", "1", "]"}], " ", 
          RowBox[{"\[Epsilon]", "[", "2", "]"}]}]]}
      },
      GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
      GridBoxSpacings->{"Columns" -> {
          Offset[0.27999999999999997`], {
           Offset[0.7]}, 
          Offset[0.27999999999999997`]}, "Rows" -> {
          Offset[0.2], {
           Offset[0.4]}, 
          Offset[0.2]}}], "\[NoBreak]", ")"}]}]}],
  Function[BoxForm`e$, 
   MatrixForm[BoxForm`e$]]]], "Input",
 CellLabel->"In[4]:=",ExpressionUUID->"ff04490e-43ba-4621-9cd6-b943ba7a1892"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     FractionBox["1", 
      RowBox[{"3", " ", 
       RowBox[{"ee", "[", "3", "]"}], " ", 
       RowBox[{"\[Epsilon]", "[", "1", "]"}], " ", 
       RowBox[{"\[Epsilon]", "[", "2", "]"}]}]], ",", "0", ",", "0"}], "}"}], 
   ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", 
     RowBox[{"-", 
      FractionBox["1", 
       RowBox[{"3", " ", 
        RowBox[{"\[Epsilon]", "[", "1", "]"}], " ", 
        RowBox[{"\[Epsilon]", "[", "2", "]"}]}]]}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", 
     RowBox[{"-", 
      FractionBox["1", 
       RowBox[{"3", " ", 
        RowBox[{"\[Epsilon]", "[", "1", "]"}], " ", 
        RowBox[{"\[Epsilon]", "[", "2", "]"}]}]]}], ",", 
     FractionBox[
      RowBox[{"ee", "[", "1", "]"}], 
      RowBox[{"3", " ", 
       RowBox[{"\[Epsilon]", "[", "1", "]"}], " ", 
       RowBox[{"\[Epsilon]", "[", "2", "]"}]}]]}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.997246426694742*^9, 3.9975212355591707`*^9},
 CellLabel->"Out[4]=",ExpressionUUID->"3a3c1342-2501-4873-9850-d797d172ead5"]
}, Open  ]],

Cell[BoxData[
 RowBox[{
  RowBox[{"e\[Alpha]", "[", "i_", "]"}], ":=", 
  RowBox[{"SymmetricPolynomial", "[", 
   RowBox[{"i", ",", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"\[Alpha]", "[", "j", "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"j", ",", "0", ",", "2"}], "}"}]}], "]"}]}], "]"}]}]], "Input",
 CellLabel->"In[5]:=",ExpressionUUID->"6488b01e-49bc-454b-aaba-f95c1628ddf8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"$Assumptions", "=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"z", ">", "0"}], ",", " ", 
    RowBox[{"d", "\[Element]", "Integers"}], ",", " ", 
    RowBox[{"d", ">=", "0"}]}], "}"}]}]], "Input",
 CellLabel->"In[6]:=",ExpressionUUID->"03708669-5d4e-4931-b064-14d9e599588f"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"z", ">", "0"}], ",", 
   RowBox[{"d", "\[Element]", 
    TemplateBox[{},
     "Integers"]}], ",", 
   RowBox[{"d", "\[GreaterEqual]", "0"}]}], "}"}]], "Output",
 CellChangeTimes->{3.9972464267265596`*^9, 3.997521235670824*^9},
 CellLabel->"Out[6]=",ExpressionUUID->"774a4b52-50a5-40fe-908c-e5e1c9940619"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["The large-radius I-function and mirror map", "Section",ExpressionUUID->"feb5ced0-b342-48cd-ba15-4402adfd9888"],

Cell["\<\
Equivariant I-function of K_P2 (x C^2), its p^k z^-n coefficients II[k,n], \
the mirror map derivative C1 (closed hypergeometric form), L, and the inverse \
mirror map invmm.\
\>", "Text",ExpressionUUID->"2db8b889-6562-4629-8574-9b29486e8e48"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"ISummand", "[", 
   RowBox[{"d_", ",", "z_"}], "]"}], "=", 
  RowBox[{"z", " ", 
   RowBox[{"Product", "[", 
    RowBox[{
     RowBox[{"1", "/", 
      RowBox[{"Product", "[", 
       RowBox[{
        RowBox[{"p", "+", 
         RowBox[{"\[Alpha]", "[", "i", "]"}], "+", 
         RowBox[{"m", " ", "z"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"m", ",", "1", ",", "d"}], "}"}]}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "0", ",", "2"}], "}"}]}], "]"}], 
   RowBox[{"Product", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"-", "3"}], "p"}], "-", 
      RowBox[{"m", " ", "z"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"m", ",", "0", ",", 
       RowBox[{
        RowBox[{"3", "d"}], "-", "1"}]}], "}"}]}], "]"}], 
   RowBox[{"y", "^", 
    RowBox[{"(", "d", ")"}]}]}]}]], "Input",
 CellLabel->"In[7]:=",ExpressionUUID->"854304e7-04f2-4797-bb6b-4808be21ad3c"],

Cell[BoxData[
 FractionBox[
  RowBox[{"3", " ", "p", " ", 
   SuperscriptBox["y", "d"], " ", 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"-", "z"}], ")"}], 
    RowBox[{"3", " ", "d"}]], " ", 
   SuperscriptBox["z", 
    RowBox[{
     RowBox[{"-", "3"}], " ", "d"}]], " ", 
   RowBox[{"Pochhammer", "[", 
    RowBox[{
     RowBox[{"1", "+", 
      FractionBox[
       RowBox[{"3", " ", "p"}], "z"]}], ",", 
     RowBox[{
      RowBox[{"-", "1"}], "+", 
      RowBox[{"3", " ", "d"}]}]}], "]"}]}], 
  RowBox[{
   RowBox[{"Pochhammer", "[", 
    RowBox[{
     FractionBox[
      RowBox[{"p", "+", "z", "+", 
       RowBox[{"\[Alpha]", "[", "0", "]"}]}], "z"], ",", "d"}], "]"}], " ", 
   RowBox[{"Pochhammer", "[", 
    RowBox[{
     FractionBox[
      RowBox[{"p", "+", "z", "+", 
       RowBox[{"\[Alpha]", "[", "1", "]"}]}], "z"], ",", "d"}], "]"}], " ", 
   RowBox[{"Pochhammer", "[", 
    RowBox[{
     FractionBox[
      RowBox[{"p", "+", "z", "+", 
       RowBox[{"\[Alpha]", "[", "2", "]"}]}], "z"], ",", "d"}], 
    "]"}]}]]], "Output",
 CellChangeTimes->{3.9972464335591307`*^9, 3.9975212362574625`*^9},
 CellLabel->"Out[7]=",ExpressionUUID->"6509f2f8-35f2-4a78-ac00-e8e66466a276"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"IFun", "[", "y_", "]"}], "=", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"y", "^", 
     RowBox[{"(", 
      RowBox[{"p", "/", "z"}], ")"}]}], 
    RowBox[{"(", 
     RowBox[{"z", "+", 
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{"ISummand", "[", 
         RowBox[{"d", ",", "z"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"d", ",", "1", ",", "\[Infinity]"}], "}"}]}], "]"}]}], 
     ")"}]}], "//", "FullSimplify"}]}]], "Input",
 CellLabel->"In[8]:=",ExpressionUUID->"b18f3d87-870d-4b65-a2fe-6a00e18f8a9e"],

Cell[BoxData[
 RowBox[{
  SuperscriptBox["y", 
   RowBox[{"p", "/", "z"}]], " ", 
  RowBox[{"(", 
   RowBox[{"z", "-", 
    FractionBox[
     RowBox[{"3", " ", "p", " ", "y", " ", "z", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"3", " ", "p"}], "+", "z"}], ")"}], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"3", " ", "p"}], "+", 
        RowBox[{"2", " ", "z"}]}], ")"}], " ", 
      RowBox[{"HypergeometricPFQ", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", 
          RowBox[{"1", "+", 
           FractionBox["p", "z"]}], ",", 
          RowBox[{
           FractionBox["4", "3"], "+", 
           FractionBox["p", "z"]}], ",", 
          RowBox[{
           FractionBox["5", "3"], "+", 
           FractionBox["p", "z"]}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"2", "+", 
           FractionBox["p", "z"], "+", 
           FractionBox[
            RowBox[{"\[Alpha]", "[", "0", "]"}], "z"]}], ",", 
          RowBox[{"2", "+", 
           FractionBox["p", "z"], "+", 
           FractionBox[
            RowBox[{"\[Alpha]", "[", "1", "]"}], "z"]}], ",", 
          RowBox[{"2", "+", 
           FractionBox["p", "z"], "+", 
           FractionBox[
            RowBox[{"\[Alpha]", "[", "2", "]"}], "z"]}]}], "}"}], ",", 
        RowBox[{
         RowBox[{"-", "27"}], " ", "y"}]}], "]"}]}], 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"p", "+", "z", "+", 
        RowBox[{"\[Alpha]", "[", "0", "]"}]}], ")"}], " ", 
      RowBox[{"(", 
       RowBox[{"p", "+", "z", "+", 
        RowBox[{"\[Alpha]", "[", "1", "]"}]}], ")"}], " ", 
      RowBox[{"(", 
       RowBox[{"p", "+", "z", "+", 
        RowBox[{"\[Alpha]", "[", "2", "]"}]}], ")"}]}]]}], ")"}]}]], "Output",
 CellChangeTimes->{3.997246435162136*^9, 3.997521238985908*^9},
 CellLabel->"Out[8]=",ExpressionUUID->"a5d630f7-c4bf-4189-9a31-2f263adca08e"]
}, Open  ]],

Cell[BoxData[
 RowBox[{
  RowBox[{"II", "[", 
   RowBox[{"k_", ",", "n_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"Coefficient", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Collect", "[", 
       RowBox[{
        RowBox[{"SeriesCoefficient", "[", 
         RowBox[{
          RowBox[{"Series", "[", 
           RowBox[{
            RowBox[{"IFun", "[", "y", "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"z", ",", "\[Infinity]", ",", "2"}], "}"}]}], "]"}], ",",
           "n"}], "]"}], ",", "p"}], "]"}], "/.", 
      RowBox[{
       RowBox[{"p", "^", "3"}], "->", "Replp3"}]}], ",", "p", ",", "k"}], 
    "]"}], "//", "Simplify"}]}]], "Input",
 CellLabel->"In[9]:=",ExpressionUUID->"3a7eac10-0de5-429b-b015-11318d8e28d4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"C1", "[", "y_", "]"}], "=", 
  RowBox[{
   RowBox[{"y", " ", 
    RowBox[{"D", "[", 
     RowBox[{
      RowBox[{"II", "[", 
       RowBox[{"1", ",", "0"}], "]"}], ",", "y"}], "]"}]}], "//", 
   "FullSimplify"}]}]], "Input",
 CellLabel->"In[10]:=",ExpressionUUID->"8d63be27-1fad-4c45-b811-fbfe1df6c935"],

Cell[BoxData[
 RowBox[{"Hypergeometric2F1", "[", 
  RowBox[{
   FractionBox["1", "3"], ",", 
   FractionBox["2", "3"], ",", "1", ",", 
   RowBox[{
    RowBox[{"-", "27"}], " ", "y"}]}], "]"}]], "Output",
 CellChangeTimes->{3.997246439114458*^9, 3.99752124310023*^9},
 CellLabel->"Out[10]=",ExpressionUUID->"834de2ca-3202-4a37-a3ed-84f4704320dd"]
}, Open  ]],

Cell[BoxData[
 RowBox[{
  RowBox[{"L", "[", "y_", "]"}], ":=", 
  RowBox[{"Power", "[", 
   RowBox[{
    RowBox[{"1", "/", 
     RowBox[{"(", 
      RowBox[{"1", " ", "+", " ", 
       RowBox[{"27", " ", "y"}]}], ")"}]}], ",", 
    RowBox[{"1", "/", "3"}]}], "]"}]}]], "Input",
 CellLabel->"In[11]:=",ExpressionUUID->"34bfa601-1285-4439-8b51-40f6015a386d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"invmm", "=", 
  RowBox[{
   RowBox[{
    RowBox[{"Series", "[", 
     RowBox[{
      RowBox[{"Exp", "[", 
       RowBox[{"II", "[", 
        RowBox[{"1", ",", "0"}], "]"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"y", ",", "0", ",", 
        RowBox[{"4", "DMAX"}]}], "}"}]}], "]"}], "/.", 
    RowBox[{"y", "->", "Q"}]}], "//", "InverseSeries"}]}]], "Input",
 CellLabel->"In[12]:=",ExpressionUUID->"f8a9d4aa-b586-4ea0-b39b-9497532f0fee"],

