Cell["\<\
Zagier-Zinger relations (the only part of the v15 bigrepl needed downstream) \
and the cubic polPF whose roots are the canonical coordinates.\
\>", "Text",ExpressionUUID->"8346a5e9-46c1-4b51-9edb-f584c05a3186"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"bigrepl", "=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     RowBox[{"cc2", "[", "y", "]"}], "->", 
     RowBox[{
      RowBox[{
       RowBox[{"ll", "[", "y", "]"}], "^", "3"}], "/", 
      RowBox[{
       RowBox[{"c1", "[", "y", "]"}], "^", "2"}]}]}], ",", 
    RowBox[{
     RowBox[{"dd2", "[", "y", "]"}], "->", 
     RowBox[{
      RowBox[{
       RowBox[{"ee", "[", "1", "]"}], "/", "2"}], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"cc2", "[", "y", "]"}], "-", 
        RowBox[{
         RowBox[{"ll", "[", "y", "]"}], "^", "3"}]}], ")"}]}]}]}], 
   "}"}]}]], "Input",
 CellLabel->"In[13]:=",ExpressionUUID->"7a613ddf-112f-4185-8c91-6773bef08045"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{"cc2", "[", "y", "]"}], "\[Rule]", 
