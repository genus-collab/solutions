    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"ee", "[", "2", "]"}], "^", "2"}], "/", "3"}], "/", 
     RowBox[{"ee", "[", "3", "]"}]}]}], ";"}]}]], "Input",
 CellLabel->"In[15]:=",ExpressionUUID->"7e866263-e586-4e51-a9bd-0b626abbe899"],

