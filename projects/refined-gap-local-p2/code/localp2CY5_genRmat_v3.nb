               RowBox[{
                RowBox[{"Length", "[", "par", "]"}], "+", 
                RowBox[{"Length", "[", "parodd", "]"}]}]}], "}"}]}], "]"}]}], 
          "]"}], "//", "Flatten"}]}], ";", " ", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"sol", "==", 
          RowBox[{"{", "}"}]}], ",", 
         RowBox[{
          RowBox[{
          "Print", "[", 
           "\"\<Error -- argument is not a cyclically symmetric polynomial in \
each LLL[i][y]\>\"", "]"}], ";", " ", 
          RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"out", "=", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"Sum", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"AA", "[", "k", "]"}], 
              RowBox[{"Product", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{"-", "1"}], ")"}], "^", 
                  RowBox[{
                   RowBox[{"par", "[", 
                    RowBox[{"[", "k", "]"}], "]"}], "[", 
                   RowBox[{"[", "j", "]"}], "]"}]}], " ", 
                 RowBox[{"e\[Alpha]", "[", 
                  RowBox[{
