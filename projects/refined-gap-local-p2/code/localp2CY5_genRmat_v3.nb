    RowBox[{"(", 
     RowBox[{
      RowBox[{"\[Epsilon]", "[", "1", "]"}], "+", 
      RowBox[{"\[Epsilon]", "[", "2", "]"}]}], ")"}], "/", "3"}]}], ";", 
  RowBox[{"ee", "=", "e\[Alpha]"}], ";"}]], "Input",
 CellLabel->"In[55]:=",ExpressionUUID->"59ef36cf-9bab-4d55-83f2-c59862a88471"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Dilaton leaves, marked leaves and edge terms", "Section",ExpressionUUID->"de5aa4af-d445-4828-b912-438d45c88088"],

Cell[BoxData[
 RowBox[{"Do", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"Dilaton", "[", 
     RowBox[{"i", ",", "n"}], "]"}], "=", 
    RowBox[{"LLpowreddiag", "[", 
     RowBox[{
      RowBox[{"Coefficient", "[", " ", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{
          RowBox[{"PPdiag", "[", 
           RowBox[{"0", ",", "i"}], "]"}], "[", 
          RowBox[{"-", "z"}], "]"}]}], ",", "z", ",", 
        RowBox[{"n", "-", "1"}]}], " ", "]"}], ",", 
      RowBox[{
       RowBox[{"LLL", "[", "i", "]"}], "[", "y", "]"}]}], "]"}]}], ",", 
   RowBox[{"{", 
    RowBox[{"i", ",", "0", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"n", ",", "1", ",", 
     RowBox[{"ZMAX", "+", "1"}]}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.9975217623026114`*^9, 
  3.9975217707461553`*^9}},ExpressionUUID->"eb84eaee-5c18-467a-bfdb-\
a035c30ab005"],

Cell[BoxData[
 RowBox[{"Do", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"Leaf", "[", 
     RowBox[{"i", ",", "n", ",", "a"}], "]"}], "=", " ", 
    RowBox[{"Coefficient", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"PPdiag", "[", 
          RowBox[{"a", ",", "i"}], "]"}], "[", 
         RowBox[{"-", "z"}], "]"}], "/.", 
        RowBox[{
         RowBox[{"d2", "[", "y_", "]"}], "->", 
         RowBox[{
          RowBox[{"ee", "[", "1", "]"}], 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"1", "/", "2"}], " ", 
             RowBox[{"c2", "[", "y", "]"}]}], "-", 
            RowBox[{
             RowBox[{"1", "/", "2"}], 
             RowBox[{
              RowBox[{"L", "[", "y", "]"}], "^", "3"}]}]}], ")"}]}]}]}], "/.", 
       RowBox[{
        RowBox[{"c2", "[", "y", "]"}], "->", 
        RowBox[{
         RowBox[{
          RowBox[{"L", "[", "y", "]"}], "^", "3"}], "/", 
         RowBox[{
          RowBox[{"c1", "[", "y", "]"}], "^", "2"}]}]}]}], ",", "z", ",", 
      "n"}], "]"}]}], ",", 
   RowBox[{"{", 
    RowBox[{"i", ",", "0", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"n", ",", "0", ",", "ZMAX"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"a", ",", "0", ",", "2"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.9975217747500205`*^9, 3.997521780598743*^9}, {
  3.9975228250467377`*^9, 3.9975228280823107`*^9}},
 CellLabel->"In[58]:=",ExpressionUUID->"7e271219-3211-4add-a867-1c1c9a0401d9"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Do", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"PreEdgeTerm", "[", 
      RowBox[{"i", ",", "j"}], "]"}], "=", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"(", " ", 
           RowBox[{
            RowBox[{"KroneckerDelta", "[", 
             RowBox[{"i", ",", "j"}], "]"}], "-", 
            RowBox[{"Sum", "[", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"PPdiag", "[", 
                 RowBox[{"a", ",", "i"}], "]"}], "[", 
                RowBox[{"-", "ww"}], "]"}], 
               RowBox[{
                RowBox[{"Inverse", "[", "\[Eta]", "]"}], "[", 
                RowBox[{"[", 
                 RowBox[{
                  RowBox[{"a", "+", "1"}], ",", 
                  RowBox[{"b", "+", "1"}]}], "]"}], "]"}], 
               RowBox[{
                RowBox[{"PPdiag", "[", 
                 RowBox[{"b", ",", "j"}], "]"}], "[", 
                RowBox[{"-", "zz"}], "]"}]}], ",", 
              RowBox[{"{", 
               RowBox[{"a", ",", "0", ",", "2"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"b", ",", "0", ",", "2"}], "}"}]}], "]"}]}], ")"}], "/.", 
          RowBox[{
           RowBox[{"d2", "[", "y_", "]"}], "->", 
           RowBox[{
            RowBox[{"ee", "[", "1", "]"}], 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"1", "/", "2"}], " ", 
               RowBox[{"c2", "[", "y", "]"}]}], "-", 
              RowBox[{
               RowBox[{"1", "/", "2"}], 
               RowBox[{
                RowBox[{"L", "[", "y", "]"}], "^", "3"}]}]}], ")"}]}]}]}], "/.", 
         RowBox[{
          RowBox[{"c2", "[", "y", "]"}], "->", 
          RowBox[{
           RowBox[{
            RowBox[{"L", "[", "y", "]"}], "^", "3"}], "/", 
           RowBox[{
            RowBox[{"c1", "[", "y", "]"}], "^", "2"}]}]}]}], 
        "\[IndentingNewLine]", "//.", "bigrepl"}], " ", "/.", 
       RowBox[{
        RowBox[{"LL", "[", "ll_", "]"}], "->", 
        RowBox[{
         RowBox[{"LLL", "[", "ll", "]"}], "[", "y", "]"}]}]}], "/.", 
      RowBox[{"ll", "->", "L"}]}]}], ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "0", ",", "2"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"j", ",", "0", ",", "2"}], "}"}]}], "]"}], ";"}]], "Input",
 CellLabel->"In[59]:=",ExpressionUUID->"76684214-3643-4eec-94c5-b031c6a6a7c9"],

Cell["\<\
Divide id - P(-w)* P(-z) by (z+w) at the level of coefficients. This single \
loop covers all (i, j; m, n) needed below - including (i,j)=(1,1), which v15 \
computed in a session whose loop is not saved in the notebook.\
\>", "Text",ExpressionUUID->"b52e7dcc-0474-4b78-b3f4-a82ac93a4017"],

Cell[BoxData[
 RowBox[{"Do", "[", 
  RowBox[{
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"precoeff", "=", 
       RowBox[{"CoefficientList", "[", 
        RowBox[{
         RowBox[{"PreEdgeTerm", "[", 
          RowBox[{
           RowBox[{
           "ij", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], ",", 
           RowBox[{
           "ij", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}], 
          "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"ww", ",", "zz"}], "}"}]}], "]"}]}], "}"}], ",", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"EdgeTerm", "[", 
         RowBox[{
          RowBox[{
          "ij", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], ",", 
          RowBox[{
          "ij", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], ",", 
          RowBox[{
          "mn", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], ",", 
          RowBox[{
          "mn", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}], 
         "]"}], "=", 
        RowBox[{"Together", "[", 
         RowBox[{
          UnderoverscriptBox["\[Sum]", 
           RowBox[{"k", "=", "0"}], 
           RowBox[{
           "mn", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]], 
          RowBox[{
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{"-", "1"}], ")"}], "k"], " ", 
           RowBox[{"precoeff", "\[LeftDoubleBracket]", 
            RowBox[{
             RowBox[{
              RowBox[{
              "mn", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
              "+", "k", "+", "2"}], ",", 
             RowBox[{
              RowBox[{
              "mn", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], 
              "-", "k", "+", "1"}]}], "\[RightDoubleBracket]"}]}]}], "]"}]}], 
       ",", 
       RowBox[{"{", 
        RowBox[{"mn", ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", "0"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"1", ",", "0"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"2", ",", "0"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"0", ",", "1"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"1", ",", "1"}], "}"}]}], "}"}]}], "}"}]}], "]"}]}], 
    "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"ij", ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "1"}], "}"}]}], "}"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[32]:=",ExpressionUUID->"d85434a6-bf1e-4e7a-b270-b10d6ba32585"],

