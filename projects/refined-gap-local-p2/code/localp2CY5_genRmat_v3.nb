Notebook[{

Cell[CellGroupData[{
Cell["Local P2 x C2: minimal genus <= 2 pipeline", "Title",ExpressionUUID->"37302a6a-3789-42c2-a665-9216f867dda1"],

Cell["\<\
Equivariant Gromov-Witten free energies F03, F04, F05 (genus 0, 3-5 points), \
F11 (genus 1) and F20 (genus 2) of K_P2 x C^2, extracted as the strict \
dependency chain from localp2final_CY5_v15.nb (the R-matrix coefficients cPP \
and the cyclic-projection table moncycproj are carried over as precomputed \
data; their derivations live in v15). Requires the sidecar file moncycproj.mx \
in the same directory. Evaluate linearly top to bottom. Approximate timings \
on the original machine: F03/F11 seconds-to-minutes, gr04[3] ~12 min, several \
gr05/gr20 terms take tens of minutes each (gr20 total is hours-scale).\
\>", "Text",ExpressionUUID->"30f8b277-652a-4ec5-8fd6-68330918a78c"],

Cell[CellGroupData[{

Cell["Setup", "Section",ExpressionUUID->"d089b2ba-b6fe-438b-bf1d-fde956c63b7e"],

Cell["Degree cutoff of the instanton expansion.", "Text",ExpressionUUID->"99e9bad1-2301-4dfa-85b5-fc51c63956ae"],

Cell[BoxData[
 RowBox[{
  RowBox[{"DMAX", "=", "4"}], ";"}]], "Input",
 CellLabel->"In[1]:=",ExpressionUUID->"dc3a956b-883f-40e8-8cce-c23c7346f3fb"],

Cell["\<\
Replacement for Combinatorica Partitions[n,m] (partitions of n into parts <= \
m), used by ToSymPolLL below. v15 loaded the deprecated Combinatorica package \
for this single function.\
\>", "Text",ExpressionUUID->"f60aa579-a1e5-49f2-9ba8-910a7fd52995"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Partitions", "[", 
   RowBox[{"n_Integer", ",", "m_Integer"}], "]"}], ":=", 
  RowBox[{"IntegerPartitions", "[", 
   RowBox[{"n", ",", "\[Infinity]", ",", 
    RowBox[{"Range", "[", "m", "]"}]}], "]"}]}]], "Input",
 CellLabel->"In[2]:=",ExpressionUUID->"833743b1-638d-4737-9410-76a1583d1682"],

Cell["\<\
Chiral ring relation (p+a0)(p+a1)(p+a2)=0 for the torus weights a_i on P2, \
and the topological metric in terms of the elementary symmetric polynomials \
ee[i] of the weights; eps[1], eps[2] are the weights on the C^2 factor.\
\>", "Text",ExpressionUUID->"e0ab8e9d-8ded-4b3f-9395-75a25bc42b6c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Replp3", "=", 
  RowBox[{
   RowBox[{"-", 
    RowBox[{"Expand", "[", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"p", "+", 
        RowBox[{"\[Alpha]", "[", "0", "]"}]}], ")"}], 
      RowBox[{"(", 
       RowBox[{"p", "+", 
        RowBox[{"\[Alpha]", "[", "1", "]"}]}], ")"}], 
      RowBox[{"(", 
       RowBox[{"p", "+", 
        RowBox[{"\[Alpha]", "[", "2", "]"}]}], ")"}]}], "]"}]}], "+", 
   RowBox[{"p", "^", "3"}]}]}]], "Input",
 CellLabel->"In[3]:=",ExpressionUUID->"abc23d58-a8e8-4e6d-aaa7-0ff97e2fa4df"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"-", 
    SuperscriptBox["p", "2"]}], " ", 
   RowBox[{"\[Alpha]", "[", "0", "]"}]}], "-", 
  RowBox[{
   SuperscriptBox["p", "2"], " ", 
   RowBox[{"\[Alpha]", "[", "1", "]"}]}], "-", 
  RowBox[{"p", " ", 
   RowBox[{"\[Alpha]", "[", "0", "]"}], " ", 
   RowBox[{"\[Alpha]", "[", "1", "]"}]}], "-", 
  RowBox[{
   SuperscriptBox["p", "2"], " ", 
   RowBox[{"\[Alpha]", "[", "2", "]"}]}], "-", 
  RowBox[{"p", " ", 
   RowBox[{"\[Alpha]", "[", "0", "]"}], " ", 
   RowBox[{"\[Alpha]", "[", "2", "]"}]}], "-", 
  RowBox[{"p", " ", 
   RowBox[{"\[Alpha]", "[", "1", "]"}], " ", 
   RowBox[{"\[Alpha]", "[", "2", "]"}]}], "-", 
  RowBox[{
   RowBox[{"\[Alpha]", "[", "0", "]"}], " ", 
   RowBox[{"\[Alpha]", "[", "1", "]"}], " ", 
   RowBox[{"\[Alpha]", "[", "2", "]"}]}]}]], "Output",
 CellChangeTimes->{3.9972464266630726`*^9, 3.9975212355275464`*^9},
 CellLabel->"Out[3]=",ExpressionUUID->"747164c9-0a14-4c7c-84ee-234479953cad"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 TagBox[
  RowBox[{"\[Eta]", "=", 
   RowBox[{"-", 
    RowBox[{"(", "\[NoBreak]", GridBox[{
       {
        RowBox[{"-", 
         FractionBox["1", 
          RowBox[{"3", " ", 
           RowBox[{"ee", "[", "3", "]"}], " ", 
           RowBox[{"\[Epsilon]", "[", "1", "]"}], " ", 
           RowBox[{"\[Epsilon]", "[", "2", "]"}]}]]}], "0", "0"},
       {"0", "0", 
        FractionBox["1", 
         RowBox[{"3", " ", 
          RowBox[{"\[Epsilon]", "[", "1", "]"}], " ", 
          RowBox[{"\[Epsilon]", "[", "2", "]"}]}]]},
       {"0", 
        FractionBox["1", 
         RowBox[{"3", " ", 
          RowBox[{"\[Epsilon]", "[", "1", "]"}], " ", 
          RowBox[{"\[Epsilon]", "[", "2", "]"}]}]], 
        FractionBox[
         RowBox[{"-", 
          RowBox[{"ee", "[", "1", "]"}]}], 
         RowBox[{"3", " ", 
          RowBox[{"\[Epsilon]", "[", "1", "]"}], " ", 
          RowBox[{"\[Epsilon]", "[", "2", "]"}]}]]}
      },
      GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
      GridBoxSpacings->{"Columns" -> {
          Offset[0.27999999999999997`], {
           Offset[0.7]}, 
          Offset[0.27999999999999997`]}, "Rows" -> {
          Offset[0.2], {
           Offset[0.4]}, 
          Offset[0.2]}}], "\[NoBreak]", ")"}]}]}],
  Function[BoxForm`e$, 
   MatrixForm[BoxForm`e$]]]], "Input",
 CellLabel->"In[4]:=",ExpressionUUID->"c52353d7-0e09-4955-84ca-b1b281249908"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     FractionBox["1", 
      RowBox[{"3", " ", 
       RowBox[{"ee", "[", "3", "]"}], " ", 
       RowBox[{"\[Epsilon]", "[", "1", "]"}], " ", 
       RowBox[{"\[Epsilon]", "[", "2", "]"}]}]], ",", "0", ",", "0"}], "}"}], 
   ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", 
     RowBox[{"-", 
      FractionBox["1", 
       RowBox[{"3", " ", 
        RowBox[{"\[Epsilon]", "[", "1", "]"}], " ", 
        RowBox[{"\[Epsilon]", "[", "2", "]"}]}]]}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", 
     RowBox[{"-", 
      FractionBox["1", 
       RowBox[{"3", " ", 
        RowBox[{"\[Epsilon]", "[", "1", "]"}], " ", 
        RowBox[{"\[Epsilon]", "[", "2", "]"}]}]]}], ",", 
     FractionBox[
      RowBox[{"ee", "[", "1", "]"}], 
      RowBox[{"3", " ", 
       RowBox[{"\[Epsilon]", "[", "1", "]"}], " ", 
       RowBox[{"\[Epsilon]", "[", "2", "]"}]}]]}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.997246426694742*^9, 3.9975212355591707`*^9},
 CellLabel->"Out[4]=",ExpressionUUID->"5873ebdd-4b91-4773-bb7d-cb5505db8051"]
}, Open  ]],

Cell[BoxData[
 RowBox[{
  RowBox[{"e\[Alpha]", "[", "i_", "]"}], ":=", 
  RowBox[{"SymmetricPolynomial", "[", 
   RowBox[{"i", ",", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"\[Alpha]", "[", "j", "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"j", ",", "0", ",", "2"}], "}"}]}], "]"}]}], "]"}]}]], "Input",
 CellLabel->"In[5]:=",ExpressionUUID->"7025c0aa-861d-4cec-b10f-b3e7f27adc69"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"$Assumptions", "=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"z", ">", "0"}], ",", " ", 
    RowBox[{"d", "\[Element]", "Integers"}], ",", " ", 
    RowBox[{"d", ">=", "0"}]}], "}"}]}]], "Input",
 CellLabel->"In[6]:=",ExpressionUUID->"bb8bbbb6-3eb7-4011-9546-4ccb63254720"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"z", ">", "0"}], ",", 
   RowBox[{"d", "\[Element]", 
    TemplateBox[{},
     "Integers"]}], ",", 
   RowBox[{"d", "\[GreaterEqual]", "0"}]}], "}"}]], "Output",
 CellChangeTimes->{3.9972464267265596`*^9, 3.997521235670824*^9},
 CellLabel->"Out[6]=",ExpressionUUID->"5cd7520c-26bb-470f-b73b-ad2862566e71"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["The large-radius I-function and mirror map", "Section",ExpressionUUID->"b2cd36d3-cede-49c7-b0fc-31d0eddb3a1a"],

Cell["\<\
Equivariant I-function of K_P2 (x C^2), its p^k z^-n coefficients II[k,n], \
the mirror map derivative C1 (closed hypergeometric form), L, and the inverse \
mirror map invmm.\
\>", "Text",ExpressionUUID->"0afe0544-f936-4570-8a7d-4130d45af968"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"ISummand", "[", 
   RowBox[{"d_", ",", "z_"}], "]"}], "=", 
  RowBox[{"z", " ", 
   RowBox[{"Product", "[", 
    RowBox[{
     RowBox[{"1", "/", 
      RowBox[{"Product", "[", 
       RowBox[{
        RowBox[{"p", "+", 
         RowBox[{"\[Alpha]", "[", "i", "]"}], "+", 
         RowBox[{"m", " ", "z"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"m", ",", "1", ",", "d"}], "}"}]}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "0", ",", "2"}], "}"}]}], "]"}], 
   RowBox[{"Product", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"-", "3"}], "p"}], "-", 
      RowBox[{"m", " ", "z"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"m", ",", "0", ",", 
       RowBox[{
        RowBox[{"3", "d"}], "-", "1"}]}], "}"}]}], "]"}], 
   RowBox[{"y", "^", 
    RowBox[{"(", "d", ")"}]}]}]}]], "Input",
 CellLabel->"In[7]:=",ExpressionUUID->"1c9f85d7-f83c-4816-918e-f6725d5a10bd"],

Cell[BoxData[
 FractionBox[
  RowBox[{"3", " ", "p", " ", 
   SuperscriptBox["y", "d"], " ", 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"-", "z"}], ")"}], 
    RowBox[{"3", " ", "d"}]], " ", 
   SuperscriptBox["z", 
    RowBox[{
     RowBox[{"-", "3"}], " ", "d"}]], " ", 
   RowBox[{"Pochhammer", "[", 
    RowBox[{
     RowBox[{"1", "+", 
      FractionBox[
       RowBox[{"3", " ", "p"}], "z"]}], ",", 
     RowBox[{
      RowBox[{"-", "1"}], "+", 
      RowBox[{"3", " ", "d"}]}]}], "]"}]}], 
  RowBox[{
   RowBox[{"Pochhammer", "[", 
    RowBox[{
     FractionBox[
      RowBox[{"p", "+", "z", "+", 
       RowBox[{"\[Alpha]", "[", "0", "]"}]}], "z"], ",", "d"}], "]"}], " ", 
   RowBox[{"Pochhammer", "[", 
    RowBox[{
     FractionBox[
      RowBox[{"p", "+", "z", "+", 
       RowBox[{"\[Alpha]", "[", "1", "]"}]}], "z"], ",", "d"}], "]"}], " ", 
   RowBox[{"Pochhammer", "[", 
    RowBox[{
     FractionBox[
      RowBox[{"p", "+", "z", "+", 
       RowBox[{"\[Alpha]", "[", "2", "]"}]}], "z"], ",", "d"}], 
    "]"}]}]]], "Output",
 CellChangeTimes->{3.9972464335591307`*^9, 3.9975212362574625`*^9},
 CellLabel->"Out[7]=",ExpressionUUID->"80bebb97-c5ef-4155-ac55-c252d3d53073"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"IFun", "[", "y_", "]"}], "=", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"y", "^", 
     RowBox[{"(", 
      RowBox[{"p", "/", "z"}], ")"}]}], 
    RowBox[{"(", 
     RowBox[{"z", "+", 
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{"ISummand", "[", 
         RowBox[{"d", ",", "z"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"d", ",", "1", ",", "\[Infinity]"}], "}"}]}], "]"}]}], 
     ")"}]}], "//", "FullSimplify"}]}]], "Input",
 CellLabel->"In[8]:=",ExpressionUUID->"374690b9-91c0-4da8-a96b-80876d8ac76b"],

Cell[BoxData[
 RowBox[{
  SuperscriptBox["y", 
   RowBox[{"p", "/", "z"}]], " ", 
  RowBox[{"(", 
   RowBox[{"z", "-", 
    FractionBox[
     RowBox[{"3", " ", "p", " ", "y", " ", "z", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"3", " ", "p"}], "+", "z"}], ")"}], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"3", " ", "p"}], "+", 
        RowBox[{"2", " ", "z"}]}], ")"}], " ", 
      RowBox[{"HypergeometricPFQ", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", 
          RowBox[{"1", "+", 
           FractionBox["p", "z"]}], ",", 
          RowBox[{
           FractionBox["4", "3"], "+", 
           FractionBox["p", "z"]}], ",", 
          RowBox[{
           FractionBox["5", "3"], "+", 
           FractionBox["p", "z"]}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"2", "+", 
           FractionBox["p", "z"], "+", 
           FractionBox[
            RowBox[{"\[Alpha]", "[", "0", "]"}], "z"]}], ",", 
          RowBox[{"2", "+", 
           FractionBox["p", "z"], "+", 
           FractionBox[
            RowBox[{"\[Alpha]", "[", "1", "]"}], "z"]}], ",", 
          RowBox[{"2", "+", 
           FractionBox["p", "z"], "+", 
           FractionBox[
            RowBox[{"\[Alpha]", "[", "2", "]"}], "z"]}]}], "}"}], ",", 
        RowBox[{
         RowBox[{"-", "27"}], " ", "y"}]}], "]"}]}], 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"p", "+", "z", "+", 
        RowBox[{"\[Alpha]", "[", "0", "]"}]}], ")"}], " ", 
      RowBox[{"(", 
       RowBox[{"p", "+", "z", "+", 
        RowBox[{"\[Alpha]", "[", "1", "]"}]}], ")"}], " ", 
      RowBox[{"(", 
       RowBox[{"p", "+", "z", "+", 
        RowBox[{"\[Alpha]", "[", "2", "]"}]}], ")"}]}]]}], ")"}]}]], "Output",
 CellChangeTimes->{3.997246435162136*^9, 3.997521238985908*^9},
 CellLabel->"Out[8]=",ExpressionUUID->"f61b7c1c-944b-4aa3-bd11-39d997ce0954"]
}, Open  ]],

Cell[BoxData[
 RowBox[{
  RowBox[{"II", "[", 
   RowBox[{"k_", ",", "n_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"Coefficient", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Collect", "[", 
       RowBox[{
        RowBox[{"SeriesCoefficient", "[", 
         RowBox[{
          RowBox[{"Series", "[", 
           RowBox[{
            RowBox[{"IFun", "[", "y", "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"z", ",", "\[Infinity]", ",", "2"}], "}"}]}], "]"}], ",",
           "n"}], "]"}], ",", "p"}], "]"}], "/.", 
      RowBox[{
       RowBox[{"p", "^", "3"}], "->", "Replp3"}]}], ",", "p", ",", "k"}], 
    "]"}], "//", "Simplify"}]}]], "Input",
 CellLabel->"In[9]:=",ExpressionUUID->"ef3cf5f2-268f-455c-94ba-76c07465bb19"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"C1", "[", "y_", "]"}], "=", 
  RowBox[{
   RowBox[{"y", " ", 
    RowBox[{"D", "[", 
     RowBox[{
      RowBox[{"II", "[", 
       RowBox[{"1", ",", "0"}], "]"}], ",", "y"}], "]"}]}], "//", 
   "FullSimplify"}]}]], "Input",
 CellLabel->"In[10]:=",ExpressionUUID->"6483566b-8b83-48df-bb05-4e4def798e60"],

Cell[BoxData[
 RowBox[{"Hypergeometric2F1", "[", 
  RowBox[{
   FractionBox["1", "3"], ",", 
   FractionBox["2", "3"], ",", "1", ",", 
   RowBox[{
    RowBox[{"-", "27"}], " ", "y"}]}], "]"}]], "Output",
 CellChangeTimes->{3.997246439114458*^9, 3.99752124310023*^9},
 CellLabel->"Out[10]=",ExpressionUUID->"a59db81c-8c4f-42c4-b130-7daa26b5d8bf"]
}, Open  ]],

Cell[BoxData[
 RowBox[{
  RowBox[{"L", "[", "y_", "]"}], ":=", 
  RowBox[{"Power", "[", 
   RowBox[{
    RowBox[{"1", "/", 
     RowBox[{"(", 
      RowBox[{"1", " ", "+", " ", 
       RowBox[{"27", " ", "y"}]}], ")"}]}], ",", 
    RowBox[{"1", "/", "3"}]}], "]"}]}]], "Input",
 CellLabel->"In[11]:=",ExpressionUUID->"99816c8e-1bed-44e1-b7f5-f68dcce0153f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"invmm", "=", 
  RowBox[{
   RowBox[{
    RowBox[{"Series", "[", 
     RowBox[{
      RowBox[{"Exp", "[", 
       RowBox[{"II", "[", 
        RowBox[{"1", ",", "0"}], "]"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"y", ",", "0", ",", 
        RowBox[{"4", "DMAX"}]}], "}"}]}], "]"}], "/.", 
    RowBox[{"y", "->", "Q"}]}], "//", "InverseSeries"}]}]], "Input",
 CellLabel->"In[12]:=",ExpressionUUID->"d67f5528-ed83-4233-bf09-d5e642a87c4e"],

