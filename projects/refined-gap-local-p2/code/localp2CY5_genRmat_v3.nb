          RowBox[{
           RowBox[{
            RowBox[{"LLL", "[", "1", "]"}], "[", "y", "]"}], "-", 
           RowBox[{
            RowBox[{"LLL", "[", "2", "]"}], "[", "y", "]"}]}], ")"}]}]}], ";",
        "\[IndentingNewLine]", 
       RowBox[{"pol", "=", 
