Cell["\<\
Zagier-Zinger relations (the only part of the v15 bigrepl needed downstream) \
and the cubic polPF whose roots are the canonical coordinates.\
\>", "Text",ExpressionUUID->"3b28ed43-79df-44cd-aaa2-73f2112d698a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"bigrepl", "=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     RowBox[{"cc2", "[", "y", "]"}], "->", 
     RowBox[{
      RowBox[{
       RowBox[{"ll", "[", "y", "]"}], "^", "3"}], "/", 
      RowBox[{
       RowBox[{"c1", "[", "y", "]"}], "^", "2"}]}]}], ",", 
    RowBox[{
     RowBox[{"dd2", "[", "y", "]"}], "->", 
     RowBox[{
      RowBox[{
       RowBox[{"ee", "[", "1", "]"}], "/", "2"}], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"cc2", "[", "y", "]"}], "-", 
        RowBox[{
         RowBox[{"ll", "[", "y", "]"}], "^", "3"}]}], ")"}]}]}]}], 
   "}"}]}]], "Input",
 CellLabel->"In[13]:=",ExpressionUUID->"fc10cec0-820a-4133-9d6d-165955b77899"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{"cc2", "[", "y", "]"}], "\[Rule]", 
    FractionBox[
     SuperscriptBox[
