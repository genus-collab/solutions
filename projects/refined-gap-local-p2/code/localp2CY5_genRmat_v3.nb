            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"Partitions", "[", 
               RowBox[{"k", ",", "3"}], "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"k", ",", "0", ",", 
                RowBox[{"3", " ", 
                 RowBox[{"(", 
