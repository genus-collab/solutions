            RowBox[{"LLL", "[", "i", "]"}], "[", "y", "]"}]}], "]"}], " ", 
         RowBox[{"z", "^", "k"}]}], "//", "Simplify"}], ",", 
       RowBox[{"{", 
        RowBox[{"k", ",", "0", ",", "ZMAX"}], "}"}]}], "]"}]}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[54]:=",ExpressionUUID->"ba85dbd0-6581-420c-bbcc-5ca534f1cc32"],

Cell["\<\
The fibrewise limit of the weights, taken globally from here on.\
\>", "Text",ExpressionUUID->"039d6a80-fbee-4654-8cc6-9a658fbaeb0d"],

