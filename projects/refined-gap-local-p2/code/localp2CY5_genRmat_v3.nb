           "]"}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"Length", "[", "#", "]"}], "<=", "exp"}], "&"}]}], 
         "]"}]}], ";", " ", "\[IndentingNewLine]", 
       RowBox[{"parodd", "=", 
