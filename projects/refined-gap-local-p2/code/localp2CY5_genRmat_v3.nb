Cell[BoxData[
 RowBox[{
  RowBox[{"sqrt\[CapitalDelta]", "[", "i_", "]"}], "=", 
  RowBox[{
   RowBox[{
    RowBox[{"Sqrt", "[", "  ", 
     RowBox[{
      RowBox[{"\[Epsilon]", "[", "1", "]"}], " ", 
      RowBox[{
       RowBox[{"\[Epsilon]", "[", "2", "]"}], "/", 
       RowBox[{"ee", "[", "3", "]"}]}]}], "]"}], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"3", " ", 
       RowBox[{"ee", "[", "3", "]"}]}], "+", 
      RowBox[{
       RowBox[{"ee", "[", "2", "]"}], " ", 
       RowBox[{
        RowBox[{"LLL", "[", "i", "]"}], "[", "y", "]"}]}]}], ")"}]}], "//", 
   "Simplify"}]}]], "Input",
 CellLabel->"In[64]:=",ExpressionUUID->"4a86dba4-1675-4dbd-b126-52e8d1cdd17a"],

