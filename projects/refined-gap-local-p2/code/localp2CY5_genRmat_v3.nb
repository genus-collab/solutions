                    RowBox[{"[", "k", "]"}], "]"}], "[", 
                   RowBox[{"[", "j", "]"}], "]"}], "]"}], " ", 
                 RowBox[{
                  RowBox[{"L", "[", "y", "]"}], "^", "3"}]}], ",", 
