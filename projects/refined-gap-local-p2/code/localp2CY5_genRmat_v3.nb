Cell[BoxData[
 RowBox[{
  RowBox[{"CyclicQuotOpt", "[", 
   RowBox[{"arg_", ",", " ", "degy_", ",", "deg\[CapitalDelta]_"}], "]"}], ":=",
   "\[IndentingNewLine]", 
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "num", ",", "den", ",", " ", "denc", ",", "summand", ",", " ", "sum", 
      ",", "degLL"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"num", "=", 
      RowBox[{"Numerator", "[", "arg", "]"}]}], ";", 
     RowBox[{"den", "=", 
      RowBox[{"Denominator", "[", "arg", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"denc", "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Head", "[", "den", "]"}], "==", "Times"}], ",", " ", 
        RowBox[{"Product", "[", 
         RowBox[{
          RowBox[{"ToSymPolLL", "[", 
           RowBox[{"Product", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"den", "[", 
               RowBox[{"[", "m", "]"}], "]"}], " ", "/.", 
              RowBox[{
               RowBox[{"LLL", "[", "ll_", "]"}], "->", 
               RowBox[{"LLL", "[", 
                RowBox[{"Mod", "[", 
                 RowBox[{
                  RowBox[{"ll", "+", "kk"}], ",", "3"}], "]"}], "]"}]}]}], 
             ",", 
             RowBox[{"{", 
              RowBox[{"kk", ",", "0", ",", "2"}], "}"}]}], "]"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"m", ",", "1", ",", 
            RowBox[{"Length", "[", "den", "]"}]}], "}"}]}], "]"}], ",", " ", 
        RowBox[{"ToSymPolLL", "[", "den", "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
     "Print", "[", 
      "\"\<Cyclic symmetrisation of the denominator OK. Result: \>\"", "]"}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", "denc", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"summand", "=", 
      RowBox[{"num", " ", 
       RowBox[{"(", 
        RowBox[{"den", "/.", 
         RowBox[{
          RowBox[{
           RowBox[{"LLL", "[", "ll_", "]"}], "[", "y", "]"}], "->", 
          RowBox[{
           RowBox[{"LLL", "[", 
            RowBox[{"Mod", "[", 
             RowBox[{
              RowBox[{"ll", "+", "1"}], ",", "3"}], "]"}], "]"}], "[", "y", 
           "]"}]}]}], ")"}], " ", 
       RowBox[{"(", 
        RowBox[{"den", " ", "/.", 
         RowBox[{
          RowBox[{
           RowBox[{"LLL", "[", "ll_", "]"}], "[", "y", "]"}], "->", 
          RowBox[{
           RowBox[{"LLL", "[", 
            RowBox[{"Mod", "[", 
             RowBox[{
              RowBox[{"ll", "+", "2"}], ",", "3"}], "]"}], "]"}], "[", "y", 
           "]"}]}]}], ")"}]}]}], " ", ";", "\[IndentingNewLine]", 
     RowBox[{"degLL", "=", 
      RowBox[{"Max", "[", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Exponent", "[", 
          RowBox[{"summand", ",", 
           RowBox[{
            RowBox[{"LLL", "[", "i", "]"}], "[", "y", "]"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "0", ",", "2"}], "}"}]}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Max degree in LLL[i] is: \>\"", " ", "<>", 
       RowBox[{"ToString", "[", "degLL", "]"}], " ", "<>", "\"\<.\>\""}], 
      "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"degLL", ">", "MONMAX"}], ",", " ", 
       RowBox[{
        RowBox[{
        "Print", "[", 
         "\"\<Degree exceeds bounds. Try using a higher value for MONMAX. \
Aborting...\>\"", "]"}], ";", " ", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", 
     RowBox[{
     "Print", " ", "[", 
      "\"\<Starting cyclic symmetrisation of the numerator...\>\"", "]"}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"sum", "=", 
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Factor", "[", 
           RowBox[{
            RowBox[{"Factor", "[", 
             RowBox[{"Coefficient", "[", 
              RowBox[{
               RowBox[{"Coefficient", "[", 
                RowBox[{
                 RowBox[{"Coefficient", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"1", "+", 
                    RowBox[{"27", " ", "y"}]}], ")"}], "^", 
                    "deg\[CapitalDelta]"}], " ", 
                    RowBox[{"summand", "/", "denc"}]}], ",", " ", 
                   RowBox[{
                    RowBox[{"LLL", "[", "2", "]"}], "[", "y", "]"}], ",", 
                   RowBox[{"m", "[", "2", "]"}]}], "]"}], ",", 
                 RowBox[{
                  RowBox[{"LLL", "[", "1", "]"}], "[", "y", "]"}], ",", 
                 RowBox[{"m", "[", "1", "]"}]}], "]"}], ",", 
               RowBox[{
                RowBox[{"LLL", "[", "0", "]"}], "[", "y", "]"}], ",", 
               RowBox[{"m", "[", "0", "]"}]}], "]"}], "]"}], " ", 
            RowBox[{"moncycproj", "[", 
             RowBox[{"[", 
              RowBox[{
               RowBox[{
                RowBox[{"m", "[", "0", "]"}], "+", "1"}], ",", 
               RowBox[{
                RowBox[{"m", "[", "1", "]"}], "+", "1"}], ",", 
               RowBox[{
                RowBox[{"m", "[", "2", "]"}], "+", "1"}]}], "]"}], "]"}]}], 
           "]"}], "/.", 
          RowBox[{
           RowBox[{
            RowBox[{"c1", "'"}], "[", "y", "]"}], "->", "cc1p"}]}], "/.", 
         RowBox[{
          RowBox[{"c1", "[", "y", "]"}], "->", "cc1"}]}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"m", "[", "0", "]"}], ",", "0", ",", " ", "degLL"}], "}"}], 
        ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"m", "[", "1", "]"}], ",", "0", ",", "  ", "degLL"}], "}"}],
         ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"m", "[", "2", "]"}], ",", "0", ",", " ", "degLL"}], 
         "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
     "Print", "[", 
      "\"\<Cyclic symmetrisation of the numerator OK. Interpolating...\>\"", 
      "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"InterpolatingPolynomial", "[", 
          RowBox[{
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"sum", "/.", 
              RowBox[{"y", "->", "n"}]}], ",", 
             RowBox[{"{", 
              RowBox[{"n", ",", "1", ",", 
               RowBox[{"degy", "+", "1"}]}], "}"}]}], "]"}], ",", "y"}], 
          "]"}], "/", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", "+", 
            RowBox[{"27", " ", "y"}]}], ")"}], "^", "deg\[CapitalDelta]"}]}], 
        "/.", 
        RowBox[{"cc1", "->", 
         RowBox[{"c1", "[", "y", "]"}]}]}], "/.", 
