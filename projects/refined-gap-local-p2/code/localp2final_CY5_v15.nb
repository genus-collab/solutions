Cell["\<\
Small z and y expansion of the PF equations. Note that these are linear in \
the indeterminates SS[0,i,k,m]\
\>", "Text",
 CellChangeTimes->{{3.9041928581905236`*^9, 
  3.9041929068107967`*^9}},ExpressionUUID->"24b97853-d13e-498b-9674-\
4fe266bef17d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Do", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"eq", "[", "i", "]"}], "=", 
     RowBox[{"Take", "[", 
      RowBox[{
       RowBox[{"CoefficientList", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"PFasp", "[", "i", "]"}], 
              RowBox[{"Exp", "[", 
               RowBox[{
                RowBox[{"-", 
                 RowBox[{"\[Mu]", "[", 
                  RowBox[{"i", ",", "y"}], "]"}]}], "/", "z"}], "]"}]}], "//",
              "Expand"}], ")"}], "/.", 
           RowBox[{"\[Mu]", "->", "\[Mu]p"}]}], "//.", 
          RowBox[{"\[Mu]repl", "[", "i", "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"z", ",", "y"}], "}"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", 
         RowBox[{"DMAX", "+", "1"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", 
         RowBox[{"DMAX", "+", "1"}]}], "}"}]}], "]"}]}], ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "0", ",", "2"}], "}"}]}], "]"}], ";"}]], "Input",
 CellChangeTimes->CompressedData["
1:eJwdyk0ow3EAxvGNgyy1Gq0ddlmKLM3mJRSrLeSwljasvcS2iGahRIpmCZta
