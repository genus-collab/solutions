Cell[BoxData[
 RowBox[{
  RowBox[{"Do", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"in", "[", "k", "]"}], "=", 
     RowBox[{"Delete", "[", 
      RowBox[{
       RowBox[{"Delete", "[", 
        RowBox[{
         RowBox[{"BinaryReadList", "[", 
          RowBox[{"\"\<StableGraph-\>\"", "<>", 
           RowBox[{"ToString", "[", "k", "]"}], "<>", "\"\<.bin\>\""}], "]"}],
          ",", "1"}], "]"}], ",", 
       RowBox[{"-", "1"}]}], "]"}]}], ",", 
    RowBox[{"{", 
     RowBox[{"k", ",", "2", ",", "7"}], "}"}]}], "]"}], ";"}]], "Input",
 CellChangeTimes->{{3.9027214032612815`*^9, 3.9027214051607256`*^9}, {
  3.9027214662944417`*^9, 3.9027215049828124`*^9}, {3.902721739100135*^9, 
