Cell["Small z-asymptotics of the I-function.", "Text",
 CellChangeTimes->{{3.9041927739904466`*^9, 
  3.9041927818149967`*^9}},ExpressionUUID->"42629ecd-9e1c-4f2d-95d9-\
26ac56c6c206"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ZMAX", "=", "4"}], ";"}]], "Input",
 CellChangeTimes->{{3.902895404718131*^9, 3.902895406316783*^9}},
 CellLabel->
  "In[127]:=",ExpressionUUID->"f22409d3-f70d-454e-8111-507579f2e49f"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"IAs", "[", "i_", "]"}], "[", 
   RowBox[{"y_", ",", "z_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"1", "/", 
    RowBox[{"Sqrt", "[", 
     RowBox[{"3", " ", 
      RowBox[{"\[Epsilon]", "[", "1", "]"}], " ", 
      RowBox[{"\[Epsilon]", "[", "2", "]"}], " ", 
      RowBox[{"\[Alpha]", "[", "i", "]"}], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"\[Alpha]", "[", "i", "]"}], "-", 
        RowBox[{"\[Alpha]", "[", 
         RowBox[{"Mod", "[", 
          RowBox[{
           RowBox[{"i", "+", "1"}], ",", "3"}], "]"}], "]"}]}], ")"}], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"\[Alpha]", "[", "i", "]"}], "-", 
        RowBox[{"\[Alpha]", "[", 
         RowBox[{"Mod", "[", 
          RowBox[{
           RowBox[{"i", "+", "2"}], ",", "3"}], "]"}], "]"}]}], ")"}]}], 
     "]"}]}], 
   RowBox[{"Exp", "[", 
    RowBox[{
     RowBox[{"\[Mu]", "[", 
      RowBox[{"i", ",", "y"}], "]"}], "/", "z"}], "]"}], " ", 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"SS", "[", 
       RowBox[{"0", ",", "i", ",", "k", ",", "n"}], "]"}], 
      RowBox[{"z", "^", "k"}], " ", 
      RowBox[{"y", "^", "n"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"k", ",", "0", ",", "ZMAX"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"n", ",", "0", ",", "DMAX"}], "}"}]}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.9028952142822185`*^9, 3.902895370597492*^9}, {
   3.9028954092685738`*^9, 3.902895421048473*^9}, {3.902897040510338*^9, 
   3.9028970429012423`*^9}, {3.902897125265443*^9, 3.90289719839954*^9}, {
   3.902974973862617*^9, 3.902974980894167*^9}, {3.902975174528672*^9, 
   3.9029751846185846`*^9}, 3.9029773048159676`*^9, {3.9029836303195896`*^9, 
   3.9029836347985697`*^9}, 3.902983774719184*^9, {3.9029838505160165`*^9, 
   3.9029838508147902`*^9}, 3.902983903590664*^9, {3.902984087972277*^9, 
   3.9029840904503746`*^9}, {3.902984664193939*^9, 3.902984689318241*^9}, {
   3.904212589204412*^9, 3.9042126026127453`*^9}, {3.904218710939434*^9, 
   3.90421871442308*^9}, {3.9042188317623053`*^9, 3.904218833459798*^9}},
 CellLabel->
  "In[128]:=",ExpressionUUID->"d6ccf22a-9040-4340-bca4-0a23d4802e6b"],

Cell["Plugging that into the Picard-Fuchs equations.", "Text",
 CellChangeTimes->{{3.904192802109536*^9, 
  3.9041928273297014`*^9}},ExpressionUUID->"1496ac2d-79cc-45f8-a1b5-\
24ca060b6b16"],

Cell[BoxData[
 RowBox[{
  RowBox[{"PFasp", "[", "i_", "]"}], ":=", 
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"coeff", "=", 
       RowBox[{"CoefficientList", "[", 
        RowBox[{
         RowBox[{"Series", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"z", " ", "DY"}], "+", 
              RowBox[{"\[Alpha]", "[", "0", "]"}], "-", 
              RowBox[{"\[Alpha]", "[", "i", "]"}]}], ")"}], 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"z", " ", "DY"}], "+", 
              RowBox[{"\[Alpha]", "[", "1", "]"}], "-", 
              RowBox[{"\[Alpha]", "[", "i", "]"}]}], ")"}], 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"z", " ", "DY"}], "+", 
              RowBox[{"\[Alpha]", "[", "2", "]"}], "-", 
              RowBox[{"\[Alpha]", "[", "i", "]"}]}], ")"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"DY", ",", "0", ",", "3"}], "}"}]}], "]"}], ",", "DY"}], 
        "]"}]}], ",", 
      RowBox[{"coeff2", "=", 
       RowBox[{"CoefficientList", "[", 
        RowBox[{
         RowBox[{"Series", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"3", "z", " ", "DY"}], " ", "-", 
              RowBox[{"3", 
               RowBox[{"\[Alpha]", "[", "i", "]"}]}]}], ")"}], 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"3", "z", " ", "DY"}], " ", "+", "z", "-", 
              RowBox[{"3", 
               RowBox[{"\[Alpha]", "[", "i", "]"}]}]}], ")"}], 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"3", "z", " ", "DY"}], "+", 
              RowBox[{"2", " ", "z"}], " ", "-", 
              RowBox[{"3", 
               RowBox[{"\[Alpha]", "[", "i", "]"}]}]}], ")"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"DY", ",", "0", ",", "3"}], "}"}]}], "]"}], ",", "DY"}], 
        "]"}]}]}], "}"}], ",", 
    RowBox[{
     RowBox[{
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"coeff", "[", 
          RowBox[{"[", 
           RowBox[{"n", "+", "1"}], "]"}], "]"}], " ", 
         RowBox[{"D", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"IAs", "[", "i", "]"}], "[", 
            RowBox[{
             RowBox[{"Exp", "[", "Y", "]"}], ",", "z"}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"Y", ",", "n"}], "}"}]}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"n", ",", "0", ",", "3"}], "}"}]}], "]"}], "+", 
      RowBox[{"y", " ", 
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"coeff2", "[", 
           RowBox[{"[", 
            RowBox[{"n", "+", "1"}], "]"}], "]"}], " ", 
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"IAs", "[", "i", "]"}], "[", 
             RowBox[{
              RowBox[{"Exp", "[", "Y", "]"}], ",", "z"}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"Y", ",", "n"}], "}"}]}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"n", ",", "0", ",", "3"}], "}"}]}], "]"}]}]}], "/.", 
     RowBox[{"Y", "->", 
      RowBox[{"Log", "[", "y", "]"}]}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.886773676939819*^9, 3.886773702156082*^9}, {
   3.886773737815839*^9, 3.886773768992055*^9}, {3.8867739319828653`*^9, 
   3.886774050146352*^9}, {3.8867740839240046`*^9, 3.8867740883326654`*^9}, {
   3.886774152143503*^9, 3.886774180549451*^9}, {3.8867742232558594`*^9, 
   3.8867742606203947`*^9}, {3.8867743474595537`*^9, 3.886774396622711*^9}, {
   3.8867744724060974`*^9, 3.886774479817512*^9}, {3.886774561737418*^9, 
   3.886774579987275*^9}, {3.886774631411436*^9, 3.8867746466534534`*^9}, {
   3.8867748453725524`*^9, 3.8867748507922297`*^9}, {3.886774886333685*^9, 
   3.886774911235173*^9}, {3.886775001920538*^9, 3.886775008047534*^9}, {
   3.8867750844445047`*^9, 3.88677508723639*^9}, {3.886775178636933*^9, 
   3.8867752060127854`*^9}, {3.8867754939657288`*^9, 3.8867755371782155`*^9}, 
   3.886777695255985*^9, {3.886777833977463*^9, 3.886777888359317*^9}, {
   3.8867781049755936`*^9, 3.8867781438319874`*^9}, {3.8867782539561014`*^9, 
   3.8867782757107353`*^9}, {3.8867783297702684`*^9, 
   3.8867783314185085`*^9}, {3.8867785315104356`*^9, 
   3.8867785411907644`*^9}, {3.8867785839615097`*^9, 
   3.8867785917244625`*^9}, {3.8867786400193615`*^9, 3.886778659472232*^9}, {
   3.886778789095273*^9, 3.886778827827734*^9}, {3.8867806281850524`*^9, 
   3.886780635806428*^9}, {3.886780678527869*^9, 3.8867808801915593`*^9}, {
   3.8867809555396285`*^9, 3.886780959586966*^9}, {3.886781576377483*^9, 
   3.886781641204235*^9}, {3.8887432731047955`*^9, 3.8887432805648193`*^9}, {
   3.8909066488514233`*^9, 3.8909066976920476`*^9}, {3.9028951372958555`*^9, 
   3.902895140503289*^9}, {3.902895431891857*^9, 3.9028954775673695`*^9}, {
   3.9028970613173275`*^9, 3.9028970942344894`*^9}, {3.902897295893383*^9, 
   3.9028974149138803`*^9}, {3.9029071982427397`*^9, 3.902907198824913*^9}, {
   3.902975137421528*^9, 3.9029751417176485`*^9}, {3.9029766594706006`*^9, 
   3.902976681217273*^9}, {3.9029769054683905`*^9, 3.902976907340699*^9}, {
   3.902982535388647*^9, 3.9029825394621973`*^9}, {3.9029836379863496`*^9, 
   3.902983640644019*^9}},
 CellLabel->
