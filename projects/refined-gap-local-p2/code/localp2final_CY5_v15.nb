Cell[BoxData[
 RowBox[{
  RowBox[{"Do", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"PP", "[", 
       RowBox[{"0", ",", "i"}], "]"}], "[", "z_", "]"}], "=", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"1", "/", 
         RowBox[{"Sqrt", "[", 
          RowBox[{"3", " ", 
           RowBox[{"\[Epsilon]", "[", "1", "]"}], " ", 
           RowBox[{"\[Epsilon]", "[", "2", "]"}], " ", 
           RowBox[{"\[Alpha]", "[", "i", "]"}], " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"\[Alpha]", "[", "i", "]"}], "-", 
             RowBox[{"\[Alpha]", "[", 
              RowBox[{"Mod", "[", 
               RowBox[{
