   3.910344478225828*^9, 3.9103444901268244`*^9}, {3.9104565319121776`*^9, 
   3.9104566174970045`*^9}, {3.9104977202117867`*^9, 
   3.9104977395510187`*^9}, {3.910870000588167*^9, 3.9108700542685995`*^9}, {
   3.910884567157878*^9, 3.9108845693018436`*^9}, {3.9108847693591614`*^9, 
   3.9108847905895853`*^9}, {3.910885355006963*^9, 3.910885355171445*^9}, 
   3.910932979576502*^9, {3.910933095412428*^9, 3.9109331142602153`*^9}, 
   3.910934965158388*^9, 3.910935059540686*^9, 3.910935269253422*^9, 
   3.9109375720545745`*^9, {3.910944025897721*^9, 3.910944053673687*^9}, {
   3.91096203229984*^9, 3.910962154268383*^9}},
 CellLabel->
