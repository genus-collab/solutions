             RowBox[{"\[Alpha]", "[", "i", "]"}], "-", 
             RowBox[{"\[Alpha]", "[", 
              RowBox[{"Mod", "[", 
               RowBox[{
                RowBox[{"i", "+", "2"}], ",", "3"}], "]"}], "]"}]}], ")"}]}], 
          "]"}]}], 
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"y", "^", "m"}], " ", 
           RowBox[{"SS", "[", 
            RowBox[{"0", ",", "i", ",", "k", ",", "m"}], "]"}], " ", 
           RowBox[{"z", "^", "k"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"m", ",", "0", ",", "DMAX"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"k", ",", "0", ",", "ZMAX"}], "}"}]}], "]"}]}], "/.", 
       RowBox[{"SSrepl", "[", 
        RowBox[{"0", ",", "i"}], "]"}]}], "/.", 
      RowBox[{
       RowBox[{"SS", "[", 
        RowBox[{"0", ",", "l_", ",", "r_", ",", "0"}], "]"}], "->", 
       RowBox[{"qrrc", "[", 
        RowBox[{"l", ",", "r"}], "]"}]}]}]}], ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "0", ",", "2"}], "}"}]}], "]"}], ";"}]], "Input",
