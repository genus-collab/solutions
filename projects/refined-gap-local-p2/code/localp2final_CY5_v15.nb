}, Open  ]],

Cell[BoxData[
 RowBox[{
  RowBox[{"CyclicProj", "[", "arg_", "]"}], ":=", 
  RowBox[{
   RowBox[{"1", "/", "3"}], " ", 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{"arg", "/.", 
      RowBox[{
       RowBox[{
        RowBox[{"LLL", "[", "ll_", "]"}], "[", "y", "]"}], "->", 
       RowBox[{
        RowBox[{"LLL", "[", 
         RowBox[{"Mod", "[", 
          RowBox[{
           RowBox[{"ll", "+", "kk"}], ",", "3"}], "]"}], "]"}], "[", "y", 
        "]"}]}]}], ",", 
     RowBox[{"{", 
      RowBox[{"kk", ",", "1", ",", "3"}], "}"}]}], " ", "]"}]}]}]], "Input",
 CellChangeTimes->{{3.911362463581642*^9, 3.9113624716302304`*^9}},
 CellLabel->
  "In[218]:=",ExpressionUUID->"c8ea5efa-6f85-482e-a157-a2b69089ec2b"],

Cell["\<\
The next routine is commented out -- its result is input in the next section.\
\
\>", "Text",
 CellChangeTimes->{{3.911440273279217*^9, 
  3.91144029004335*^9}},ExpressionUUID->"e1523be1-4a48-46ee-83b1-\
ebc59f35c1f1"],

Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{"*", 
   RowBox[{"AbsoluteTiming", "[", 
    RowBox[{
     RowBox[{"moncycproj", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"ToSymPolLL", "[", 
         RowBox[{"CyclicProj", "[", 
          RowBox[{"Product", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"LLL", "[", "i", "]"}], "[", "y", "]"}], "^", 
             RowBox[{"m", "[", "i", "]"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", "0", ",", "2"}], "}"}]}], "]"}], "]"}], "]"}], 
        ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"m", "[", "0", "]"}], ",", "0", ",", "MONMAX"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"m", "[", "1", "]"}], ",", "0", ",", "MONMAX"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"m", "[", "2", "]"}], ",", "0", ",", "MONMAX"}], "}"}]}], 
       "]"}]}], ";"}], "]"}]}], "**)"}]], "Input",
 CellChangeTimes->{{3.9109629853573713`*^9, 3.910963104884763*^9}, {
  3.9109659600790005`*^9, 3.9109659627213125`*^9}, {3.9110271878368444`*^9, 
  3.911027248594091*^9}, {3.911028637321932*^9, 3.9110286405811944`*^9}, {
  3.911029359311192*^9, 3.9110293659047594`*^9}, {3.91103827386082*^9, 
  3.9110382762871227`*^9}, {3.911283747004936*^9, 3.9112837487086253`*^9}, {
  3.9112841166430507`*^9, 3.911284120138711*^9}},
 CellLabel->
  "In[219]:=",ExpressionUUID->"7a6641fb-febd-4aba-841b-8bcd6242283e"],

Cell[TextData[{
 "This routine is the heart of the computations of stable graph \
contributions. It takes ",
 StyleBox["arg ",
  FontSlant->"Italic"],
 "a rational function of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    RowBox[{"(", 
     RowBox[{
      RowBox[{"LLL", "[", "i", "]"}], "[", "y", "]"}], ")"}], "i"], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "142850f1-9d4e-4f9d-82c8-55ea49628c54"],
 " as input, and it considers its cyclic symmetrisation. It first computes \
the denominator in the symmetrisation as a function of y by invoking \
ToSymPolLL -- this is always relatively fast -- and then the numerator, which \
is often extremely cumbersome. In order to do this, we expand it as a (very \
large) polynomial of LLL[i][y] and replace each monomial using the list \
moncycproj above to compute the cyclically-invariant projection. The \
resulting polynomial in y is usually too big for Mathematica to Simplify (up \
to hundreds of MB). The trick here is to use the fact that 1) the denominator \
is always of the form (1+27 ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"y", ")"}], "n"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "72af6ff4-eb17-4094-947b-5908cdc3b39e"],
 " for some very large ",
 StyleBox["n; ",
  FontSlant->"Italic"],
 "2) the numerator contains (1+27 ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"y", ")"}], 
    RowBox[{"n", "-", "deg\[CapitalDelta]"}]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ac05dc2f-8729-4f3d-888b-2a041598379c"],
 " as a factor, where the argument deg\[CapitalDelta] is the order of the \
pole of ",
 StyleBox["arg",
  FontSlant->"Italic"],
 " at the discriminant; 3) as a result, (1+27 ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"y", ")"}], "deg\[CapitalDelta]"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a0c7e858-60bb-4505-bf45-297abf4534e5"],
 " x ",
 "numerator/denominator is a polynomial in y of relatively small degree degy: \
to compute it, it suffices to interpolate the crazy-big expression for the \
numerator at a small number (=degy+1) of values for the argument y."
}], "Text",
 CellChangeTimes->{{3.9114403094062705`*^9, 3.91144050419089*^9}, {
  3.9114418145703106`*^9, 
  3.91144229452242*^9}},ExpressionUUID->"88d2d552-5e44-41a5-92f3-\
35daab3e6ec0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"CyclicQuotOpt", "[", 
   RowBox[{"arg_", ",", " ", "degy_", ",", "deg\[CapitalDelta]_"}], "]"}], ":=",
   "\[IndentingNewLine]", 
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "num", ",", "den", ",", " ", "denc", ",", "summand", ",", " ", "sum", 
      ",", "degLL"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"num", "=", 
      RowBox[{"Numerator", "[", "arg", "]"}]}], ";", 
     RowBox[{"den", "=", 
      RowBox[{"Denominator", "[", "arg", "]"}]}], ";", "\[IndentingNewLine]", 
     
     RowBox[{"denc", "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Head", "[", "den", "]"}], "==", "Times"}], ",", " ", 
        RowBox[{"Product", "[", 
         RowBox[{
          RowBox[{"ToSymPolLL", "[", 
           RowBox[{"Product", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"den", "[", 
               RowBox[{"[", "m", "]"}], "]"}], " ", "/.", 
              RowBox[{
               RowBox[{"LLL", "[", "ll_", "]"}], "->", 
               RowBox[{"LLL", "[", 
                RowBox[{"Mod", "[", 
                 RowBox[{
                  RowBox[{"ll", "+", "kk"}], ",", "3"}], "]"}], "]"}]}]}], 
             ",", 
             RowBox[{"{", 
              RowBox[{"kk", ",", "0", ",", "2"}], "}"}]}], "]"}], "]"}], ",", 
          
          RowBox[{"{", 
           RowBox[{"m", ",", "1", ",", 
            RowBox[{"Length", "[", "den", "]"}]}], "}"}]}], "]"}], ",", " ", 
        RowBox[{"ToSymPolLL", "[", "den", "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
     "Print", "[", 
      "\"\<Cyclic symmetrisation of the denominator OK. Result: \>\"", "]"}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", "denc", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"summand", "=", 
      RowBox[{"num", " ", 
       RowBox[{"(", 
        RowBox[{"den", "/.", 
         RowBox[{
          RowBox[{
           RowBox[{"LLL", "[", "ll_", "]"}], "[", "y", "]"}], "->", 
          RowBox[{
           RowBox[{"LLL", "[", 
            RowBox[{"Mod", "[", 
             RowBox[{
              RowBox[{"ll", "+", "1"}], ",", "3"}], "]"}], "]"}], "[", "y", 
           "]"}]}]}], ")"}], " ", 
       RowBox[{"(", 
        RowBox[{"den", " ", "/.", 
         RowBox[{
          RowBox[{
           RowBox[{"LLL", "[", "ll_", "]"}], "[", "y", "]"}], "->", 
          RowBox[{
           RowBox[{"LLL", "[", 
            RowBox[{"Mod", "[", 
             RowBox[{
              RowBox[{"ll", "+", "2"}], ",", "3"}], "]"}], "]"}], "[", "y", 
           "]"}]}]}], ")"}]}]}], " ", ";", "\[IndentingNewLine]", 
     RowBox[{"degLL", "=", 
      RowBox[{"Max", "[", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Exponent", "[", 
          RowBox[{"summand", ",", 
           RowBox[{
            RowBox[{"LLL", "[", "i", "]"}], "[", "y", "]"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "0", ",", "2"}], "}"}]}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Max degree in LLL[i] is: \>\"", " ", "<>", 
       RowBox[{"ToString", "[", "degLL", "]"}], " ", "<>", "\"\<.\>\""}], 
      "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"degLL", ">", "MONMAX"}], ",", " ", 
       RowBox[{
        RowBox[{
        "Print", "[", 
         "\"\<Degree exceeds bounds. Try using a higher value for MONMAX. \
Aborting...\>\"", "]"}], ";", " ", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", 
     RowBox[{
     "Print", " ", "[", 
      "\"\<Starting cyclic symmetrisation of the numerator...\>\"", "]"}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"sum", "=", 
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Factor", "[", 
           RowBox[{
            RowBox[{"Factor", "[", 
             RowBox[{"Coefficient", "[", 
              RowBox[{
               RowBox[{"Coefficient", "[", 
                RowBox[{
                 RowBox[{"Coefficient", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"1", "+", 
                    RowBox[{"27", " ", "y"}]}], ")"}], "^", 
                    "deg\[CapitalDelta]"}], " ", 
                    RowBox[{"summand", "/", "denc"}]}], ",", " ", 
                   RowBox[{
                    RowBox[{"LLL", "[", "2", "]"}], "[", "y", "]"}], ",", 
                   RowBox[{"m", "[", "2", "]"}]}], "]"}], ",", 
                 RowBox[{
                  RowBox[{"LLL", "[", "1", "]"}], "[", "y", "]"}], ",", 
                 RowBox[{"m", "[", "1", "]"}]}], "]"}], ",", 
               RowBox[{
                RowBox[{"LLL", "[", "0", "]"}], "[", "y", "]"}], ",", 
               RowBox[{"m", "[", "0", "]"}]}], "]"}], "]"}], " ", 
            RowBox[{"moncycproj", "[", 
             RowBox[{"[", 
              RowBox[{
               RowBox[{
                RowBox[{"m", "[", "0", "]"}], "+", "1"}], ",", 
               RowBox[{
                RowBox[{"m", "[", "1", "]"}], "+", "1"}], ",", 
               RowBox[{
                RowBox[{"m", "[", "2", "]"}], "+", "1"}]}], "]"}], "]"}]}], 
           "]"}], "/.", 
          RowBox[{
           RowBox[{
            RowBox[{"c1", "'"}], "[", "y", "]"}], "->", "cc1p"}]}], "/.", 
         RowBox[{
          RowBox[{"c1", "[", "y", "]"}], "->", "cc1"}]}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"m", "[", "0", "]"}], ",", "0", ",", " ", "degLL"}], "}"}], 
        ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"m", "[", "1", "]"}], ",", "0", ",", "  ", "degLL"}], "}"}],
         ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"m", "[", "2", "]"}], ",", "0", ",", " ", "degLL"}], 
         "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
     "Print", "[", 
      "\"\<Cyclic symmetrisation of the numerator OK. Interpolating...\>\"", 
      "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"InterpolatingPolynomial", "[", 
          RowBox[{
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"sum", "/.", 
              RowBox[{"y", "->", "n"}]}], ",", 
             RowBox[{"{", 
              RowBox[{"n", ",", "1", ",", 
               RowBox[{"degy", "+", "1"}]}], "}"}]}], "]"}], ",", "y"}], 
          "]"}], "/", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", "+", 
            RowBox[{"27", " ", "y"}]}], ")"}], "^", "deg\[CapitalDelta]"}]}], 
        "/.", 
        RowBox[{"cc1", "->", 
         RowBox[{"c1", "[", "y", "]"}]}]}], "/.", 
       RowBox[{"cc1p", "->", 
        RowBox[{
         RowBox[{"c1", "'"}], "[", "y", "]"}]}]}], "  ", "//", "Factor"}]}]}],
    "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.911035608543429*^9, 3.911035695173278*^9}, {
  3.9110383226549053`*^9, 3.9110383535848126`*^9}, {3.9110383952273912`*^9, 
  3.911038818177353*^9}, {3.9110388513140836`*^9, 3.9110388603835444`*^9}, {
  3.9110388932561054`*^9, 3.911038976113021*^9}, {3.9110390311595984`*^9, 
  3.9110391136736984`*^9}, {3.91103916948602*^9, 3.911039170024824*^9}, {
  3.911039203073797*^9, 3.9110392607043056`*^9}, {3.9110392941515164`*^9, 
  3.911039335118125*^9}, {3.911039453275263*^9, 3.911039598857268*^9}, {
  3.911039714355036*^9, 3.911039766083871*^9}, {3.911039903787261*^9, 
  3.911039921579608*^9}, {3.9112757038243885`*^9, 3.9112758293831296`*^9}},
 CellLabel->
  "In[220]:=",ExpressionUUID->"760cb97a-5df2-45c6-a7f3-7143fc61094c"],

Cell["Symplecticity checks (commented out):", "Text",
 CellChangeTimes->{{3.9114423090783134`*^9, 3.91144231373348*^9}, {
  3.9972439809799967`*^9, 
  3.9972439833319044`*^9}},ExpressionUUID->"dec8e335-823e-4831-ba9a-\
ed3b6d8646e7"],

Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"*", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"Series", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"(", " ", 
               RowBox[{
                RowBox[{"KroneckerDelta", "[", 
                 RowBox[{"a", ",", "b"}], "]"}], "-", 
                RowBox[{"Sum", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{
                    RowBox[{"Normal", "[", 
                    RowBox[{
                    RowBox[{"PP", "[", 
                    RowBox[{"b", ",", "i"}], "]"}], "[", "ww", "]"}], "]"}], 
                    RowBox[{
                    RowBox[{"Inverse", "[", "\[Eta]", "]"}], "[", 
                    RowBox[{"[", 
                    RowBox[{
                    RowBox[{"a", "+", "1"}], ",", 
                    RowBox[{"c", "+", "1"}]}], "]"}], "]"}], 
                    RowBox[{"Normal", "[", 
                    RowBox[{
                    RowBox[{"PP", "[", 
                    RowBox[{"c", ",", "i"}], "]"}], "[", "z", "]"}], "]"}]}], 
                   "/.", 
                   RowBox[{"ww", "->", 
                    RowBox[{"-", "z"}]}]}], ",", 
                  RowBox[{"{", 
                   RowBox[{"i", ",", "0", ",", "2"}], "}"}], ",", 
                  RowBox[{"{", 
                   RowBox[{"c", ",", "0", ",", "2"}], "}"}]}], "]"}]}], ")"}],
               "/.", 
              RowBox[{"ll", "->", "L"}]}], ",", 
             RowBox[{"{", 
              RowBox[{"z", ",", "0", ",", "2"}], "}"}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"a", ",", "0", ",", "2"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"b", ",", "0", ",", "2"}], "}"}]}], "]"}]}], "/.", 
        RowBox[{
         RowBox[{"d2", "[", "y_", "]"}], "->", 
         RowBox[{
          RowBox[{"ee", "[", "1", "]"}], 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"1", "/", "2"}], " ", 
             RowBox[{"c2", "[", "y", "]"}]}], "-", 
            RowBox[{
             RowBox[{"1", "/", "2"}], 
             RowBox[{
              RowBox[{"L", "[", "y", "]"}], "^", "3"}]}]}], ")"}]}]}]}], "/.", 
       RowBox[{
        RowBox[{"c2", "[", "y", "]"}], "->", 
        RowBox[{
         RowBox[{
