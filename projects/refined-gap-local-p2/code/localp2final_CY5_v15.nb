Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Do", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"SSrepl", "[", 
      RowBox[{"0", ",", "i"}], "]"}], "=", 
     RowBox[{
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"Flatten", "[", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"SS", "[", 
               RowBox[{"0", ",", "i", ",", "k", ",", "m"}], "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"k", ",", "0", ",", "DMAX"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"m", ",", "1", ",", "DMAX"}], "}"}]}], "]"}], "]"}], 
           "[", 
           RowBox[{"[", "n", "]"}], "]"}], "->", 
          RowBox[{
           RowBox[{"solSS", "[", "i", "]"}], "[", 
           RowBox[{"[", "n", "]"}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"n", ",", "1", ",", 
