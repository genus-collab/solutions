Cell[CellGroupData[{

Cell["Stable graph sums", "Subsection",
 CellChangeTimes->{{3.90669201022537*^9, 
  3.906692012618493*^9}},ExpressionUUID->"ce478cd1-e663-4906-abbb-\
43ad29444721"],

Cell[CellGroupData[{

Cell["some calculations about the odd generator", "Subsubsection",
 CellChangeTimes->{{3.907821995538076*^9, 3.9078220008430705`*^9}, {
  3.9114389466207256`*^9, 
  3.9114389474446282`*^9}},ExpressionUUID->"6000d068-7033-47ae-8144-\
0daf07fda210"],

Cell[TextData[{
 "All graph terms are rational functions of LLL[i][y], and in the fibrewise \
limit, they are actually ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["S", "3"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "06dea591-4958-43c8-bcbb-925898095493"],
 "-invariant (i.e. symmetric) rational functions in them. Since symmetric \
polynomials in LLL[i][y] are coefficients of polPFL[y, LLL[i][y]], they are \
in particular rational functions of y. It will be useful in the following to \
consider ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Mu]", "3"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "df5e69c6-13b5-4aa7-8329-b897111aa52e"],
 "-invariant (i.e. cyclically symmetric) rational functions of LLL[i][y]: it \
turns out that these are also rational functions of y. To see it, consider \
the ideal generated by the symmetric polynomials in ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    RowBox[{"{", 
     RowBox[{
      RowBox[{"LLL", "[", "i", "]"}], "[", "y", "]"}], "}"}], "i"], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d3174928-0b1e-4585-bc72-04dbfbbb62dd"],
 ", i=0,1,2:"
}], "Text",
 CellChangeTimes->{{3.9114389512189302`*^9, 
  3.9114392108115873`*^9}},ExpressionUUID->"1f24300c-1d14-41cb-a083-\
d456d0ec150c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ngrb", "=", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"SymmetricPolynomial", "[", 
      RowBox[{"k", ",", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"LLL", "[", "i", "]"}], "[", "y", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "0", ",", "2"}], "}"}]}], "]"}]}], "]"}], "-", 
     " ", 
     RowBox[{"Coefficient", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"polPFLdiag", "[", 
         RowBox[{"y", ",", "XX"}], "]"}], "/", 
        RowBox[{"(", 
         RowBox[{"1", "+", 
          RowBox[{"27", "y"}]}], ")"}]}], ",", "XX", ",", 
       RowBox[{"3", "-", "k"}]}], "]"}]}], ",", 
    RowBox[{"{", 
     RowBox[{"k", ",", "1", ",", "3"}], "}"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.90782113040948*^9, 3.9078211558540096`*^9}, {
  3.9078214445702276`*^9, 3.9078214465582237`*^9}, {3.9109616084422026`*^9, 
  3.9109616219529886`*^9}, {3.9109616532729206`*^9, 3.9109617285700502`*^9}},
 CellLabel->
  "In[211]:=",ExpressionUUID->"4ea59de4-2c94-4abd-af4f-48a0b523a843"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{"-", 
     FractionBox[
      RowBox[{
       RowBox[{"\[Epsilon]", "[", "1", "]"}], "+", 
       RowBox[{"\[Epsilon]", "[", "2", "]"}]}], 
      RowBox[{"1", "+", 
       RowBox[{"27", " ", "y"}]}]]}], "+", 
    RowBox[{
     RowBox[{"LLL", "[", "0", "]"}], "[", "y", "]"}], "+", 
