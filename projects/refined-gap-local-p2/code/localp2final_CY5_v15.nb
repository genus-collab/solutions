Cell[BoxData[
 RowBox[{"Do", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"\[Mu]repl", "[", "i", "]"}], "=", "\[IndentingNewLine]", 
    RowBox[{"Block", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"explpol", ",", " ", 
        RowBox[{"out", "=", 
         RowBox[{"{", "}"}]}]}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"explpol", " ", "=", " ", 
        RowBox[{"Series", "[", 
         RowBox[{
          RowBox[{"lpol", "/.", 
           RowBox[{"XX", "->", 
            RowBox[{
             RowBox[{"-", 
              RowBox[{"\[Alpha]", "[", "i", "]"}]}], "+", 
             RowBox[{"y", " ", 
              RowBox[{"D", "[", 
               RowBox[{
                RowBox[{"\[Mu]p", "[", 
                 RowBox[{"i", ",", "y"}], "]"}], ",", "y"}], "]"}]}]}]}]}], 
          ",", 
          RowBox[{"{", 
           RowBox[{"y", ",", "0", ",", 
            RowBox[{"2", "DMAX"}]}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Do", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"AppendTo", "[", 
          RowBox[{"out", ",", 
           RowBox[{"Flatten", "[", 
            RowBox[{"Solve", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"SeriesCoefficient", "[", 
                RowBox[{"explpol", ",", "k"}], "]"}], "==", "0"}], ",", 
              RowBox[{"\[Mu]pexp", "[", 
               RowBox[{"i", ",", "k"}], "]"}]}], "]"}], "]"}]}], "]"}], 
         "\[IndentingNewLine]", ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", "1", ",", "DMAX"}], "}"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"out", "//", "Flatten"}], "//", "Simplify"}]}]}], "]"}]}], 
   "\[IndentingNewLine]", ",", 
   RowBox[{"{", 
    RowBox[{"i", ",", "0", ",", "2"}], "}"}]}], "]"}]], "Input",
