Cell[TextData[{
 "A replacement rule expressing the ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["n", "th"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "36fa214f-ef9d-41e8-b0bf-97b09feaa97e"],
 " y-derivative of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["L", "i"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "03e06046-990f-4f93-a4c0-fa837bde00d6"],
 ", where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"polPFL", "[", 
     RowBox[{"y", ",", 
      SubscriptBox["L", "i"]}], "]"}], "=", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "4d593ace-2804-4fdf-81e3-26fe57aebfac"],
 ", as a rational function in (y, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["L", "i"], ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "4cbe85f3-208d-4493-8512-fa9c5824f5b9"],
 ", presented in the minimal form."
}], "Text",
 CellChangeTimes->{{3.9113888422920685`*^9, 
  3.91138892179996*^9}},ExpressionUUID->"872a1051-ebe8-4086-bc52-\
7dc869808042"],

