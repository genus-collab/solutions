Cell[TextData[{
 "The next function takes as input a cyclically symmetric polynomial ",
 StyleBox["arg ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[" ", TraditionalForm]],ExpressionUUID->
  "8fda2d76-6089-4d9c-a0e9-423d2ad4abb8"],
 "in ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"LLL", "[", "0", "]"}], "[", "y", "]"}], ",", 
     RowBox[{
      RowBox[{"LLL", "[", "1", "]"}], "[", "y", "]"}], ",", 
     RowBox[{
      RowBox[{"LLL", "[", "2", "]"}], "[", "y", "]"}]}], "}"}], 
   TraditionalForm]],ExpressionUUID->"3d5e8e6e-4614-47bd-ace3-828bc8a32fb6"],
 " and writes it as a polynomial in the generators of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{
     RowBox[{
      RowBox[{"C", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"LLL", "[", "0", "]"}], "[", "y", "]"}], ",", 
        RowBox[{
         RowBox[{"LLL", "[", "1", "]"}], "[", "y", "]"}], ",", 
        RowBox[{
         RowBox[{"LLL", "[", "2", "]"}], "[", "y", "]"}]}]}], "}"}], "]"}], 
    SubscriptBox["\[Mu]", "3"]], TraditionalForm]],ExpressionUUID->
  "f35bff90-6d58-467e-a660-f8704ff956cc"],
 ", and therefore as an algebraic function of y."
}], "Text",
 CellChangeTimes->{{3.9055049180576415`*^9, 3.905505026174115*^9}, {
  3.90774514436724*^9, 3.907745153077854*^9}, {3.9077453194034157`*^9, 
  3.9077453231070375`*^9}, {3.90781842281501*^9, 3.907818494240959*^9}, {
  3.9078274709149113`*^9, 3.9078274711598763`*^9}, {3.908337917168092*^9, 
  3.908337917360116*^9}, {3.908342860687111*^9, 
  3.908342862078375*^9}},ExpressionUUID->"8632e1a6-ff27-4312-84f6-\
67d9ad7a1188"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ToSymPolLL", "[", "arg_", "]"}], ":=", 
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"arg", "===", "0"}], ",", "0", ",", "\[IndentingNewLine]", 
    RowBox[{"Block", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"argint", "=", "arg"}], ",", "par", ",", "exp", ",", "pol", 
        ",", "sol", ",", " ", "out", ",", "parodd", ",", "odd"}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"*", 
         RowBox[{"Do", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"Exponent", "[", 
                RowBox[{"argint", ",", 
                 RowBox[{
                  RowBox[{"LLL", "[", "ii", "]"}], "[", "y", "]"}]}], "]"}], 
               ">", "2"}], ",", 
              RowBox[{"argint", "=", 
               RowBox[{"LLpowreddiag", "[", 
                RowBox[{"argint", ",", 
                 RowBox[{
                  RowBox[{"LLL", "[", "ii", "]"}], "[", "y", "]"}]}], 
                "]"}]}]}], "]"}], ";"}], ",", 
           RowBox[{"{", 
            RowBox[{"ii", ",", "0", ",", "2"}], "}"}]}], "]"}]}], ";"}], 
       "**)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"exp", "=", 
        RowBox[{
         RowBox[{"Length", "[", 
          RowBox[{"CoefficientList", "[", 
           RowBox[{"argint", ",", 
            RowBox[{
             RowBox[{"LLL", "[", "0", "]"}], "[", "y", "]"}]}], "]"}], "]"}], 
         "-", "1"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"par", "=", 
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{"Flatten", "[", 
           RowBox[{
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"Partitions", "[", 
               RowBox[{"k", ",", "3"}], "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"k", ",", "0", ",", 
                RowBox[{"3", " ", "exp"}]}], "}"}]}], "]"}], ",", "1"}], 
           "]"}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"Length", "[", "#", "]"}], "<=", "exp"}], "&"}]}], 
         "]"}]}], ";", " ", "\[IndentingNewLine]", 
       RowBox[{"parodd", "=", 
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{"Flatten", "[", 
           RowBox[{
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"Partitions", "[", 
               RowBox[{"k", ",", "3"}], "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"k", ",", "0", ",", 
                RowBox[{"3", " ", 
                 RowBox[{"(", 
                  RowBox[{"exp", "-", "1"}], ")"}]}]}], "}"}]}], "]"}], ",", 
            "1"}], "]"}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"Length", "[", "#", "]"}], "<=", 
            RowBox[{"exp", "-", "2"}]}], "&"}]}], "]"}]}], ";", " ", 
       "\[IndentingNewLine]", 
       RowBox[{"odd", "=", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"LLL", "[", "0", "]"}], "[", "y", "]"}], "-", 
           RowBox[{
            RowBox[{"LLL", "[", "1", "]"}], "[", "y", "]"}]}], ")"}], 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"LLL", "[", "0", "]"}], "[", "y", "]"}], "-", 
           RowBox[{
            RowBox[{"LLL", "[", "2", "]"}], "[", "y", "]"}]}], ")"}], 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"LLL", "[", "1", "]"}], "[", "y", "]"}], "-", 
           RowBox[{
            RowBox[{"LLL", "[", "2", "]"}], "[", "y", "]"}]}], ")"}]}]}], ";",
        "\[IndentingNewLine]", 
       RowBox[{"pol", "=", 
        RowBox[{
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"AA", "[", "k", "]"}], 
            RowBox[{"Product", "[", 
             RowBox[{
              RowBox[{"SymmetricPolynomial", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"par", "[", 
                  RowBox[{"[", "k", "]"}], "]"}], "[", 
                 RowBox[{"[", "j", "]"}], "]"}], ",", 
                RowBox[{"Table", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"LLL", "[", "i", "]"}], "[", "y", "]"}], ",", 
                  RowBox[{"{", 
                   RowBox[{"i", ",", "0", ",", "2"}], "}"}]}], "]"}]}], "]"}],
               ",", 
              RowBox[{"{", 
               RowBox[{"j", ",", "1", ",", 
                RowBox[{"Length", "[", 
                 RowBox[{"par", "[", 
                  RowBox[{"[", "k", "]"}], "]"}], "]"}]}], "}"}]}], "]"}]}], 
           ",", 
           RowBox[{"{", 
            RowBox[{"k", ",", "1", ",", 
             RowBox[{"Length", "[", "par", "]"}]}], "}"}]}], "]"}], "+", 
         RowBox[{"odd", " ", 
          RowBox[{"Sum", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"AA", "[", 
              RowBox[{"k", "+", 
               RowBox[{"Length", "[", "par", "]"}]}], "]"}], 
             RowBox[{"Product", "[", 
              RowBox[{
               RowBox[{"SymmetricPolynomial", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"parodd", "[", 
                   RowBox[{"[", "k", "]"}], "]"}], "[", 
                  RowBox[{"[", "j", "]"}], "]"}], ",", 
                 RowBox[{"Table", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"LLL", "[", "i", "]"}], "[", "y", "]"}], ",", 
                   RowBox[{"{", 
                    RowBox[{"i", ",", "0", ",", "2"}], "}"}]}], "]"}]}], 
                "]"}], ",", 
               RowBox[{"{", 
                RowBox[{"j", ",", "1", ",", 
                 RowBox[{"Length", "[", 
                  RowBox[{"parodd", "[", 
                   RowBox[{"[", "k", "]"}], "]"}], "]"}]}], "}"}]}], "]"}]}], 
            ",", 
            RowBox[{"{", 
             RowBox[{"k", ",", "1", ",", 
              RowBox[{"Length", "[", "parodd", "]"}]}], "}"}]}], "]"}]}]}]}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"sol", "=", 
        RowBox[{
         RowBox[{"Solve", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"CoefficientList", "[", 
             RowBox[{
              RowBox[{"argint", "-", "pol"}], ",", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{
                 RowBox[{"LLL", "[", "0", "]"}], "[", "y", "]"}], ",", 
                RowBox[{
                 RowBox[{"LLL", "[", "1", "]"}], "[", "y", "]"}], ",", 
                RowBox[{
                 RowBox[{"LLL", "[", "2", "]"}], "[", "y", "]"}]}], "}"}]}], 
             "]"}], "==", "0"}], ",", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"AA", "[", "k", "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"k", ",", "1", ",", 
               RowBox[{
                RowBox[{"Length", "[", "par", "]"}], "+", 
                RowBox[{"Length", "[", "parodd", "]"}]}]}], "}"}]}], "]"}]}], 
          "]"}], "//", "Flatten"}]}], ";", " ", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"sol", "==", 
          RowBox[{"{", "}"}]}], ",", 
         RowBox[{
          RowBox[{
          "Print", "[", 
           "\"\<Error -- argument is not a cyclically symmetric polynomial in \
each LLL[i][y]\>\"", "]"}], ";", " ", 
          RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
       
       RowBox[{"out", "=", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"Sum", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"AA", "[", "k", "]"}], 
              RowBox[{"Product", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{"-", "1"}], ")"}], "^", 
                  RowBox[{
                   RowBox[{"par", "[", 
                    RowBox[{"[", "k", "]"}], "]"}], "[", 
                   RowBox[{"[", "j", "]"}], "]"}]}], " ", 
                 RowBox[{"e\[Alpha]", "[", 
                  RowBox[{
                   RowBox[{"par", "[", 
                    RowBox[{"[", "k", "]"}], "]"}], "[", 
                   RowBox[{"[", "j", "]"}], "]"}], "]"}], " ", 
                 RowBox[{
                  RowBox[{"L", "[", "y", "]"}], "^", "3"}]}], ",", 
                RowBox[{"{", 
                 RowBox[{"j", ",", "1", ",", 
                  RowBox[{"Length", "[", 
                   RowBox[{"par", "[", 
                    RowBox[{"[", "k", "]"}], "]"}], "]"}]}], "}"}]}], "]"}]}],
              ",", 
             RowBox[{"{", 
              RowBox[{"k", ",", "1", ",", 
               RowBox[{"Length", "[", "par", "]"}]}], "}"}]}], "]"}], "+", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"3", " ", 
              SqrtBox["3"], " ", "I", " ", 
              FractionBox[
               RowBox[{"y", " ", 
                SuperscriptBox[
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"\[Epsilon]", "[", "1", "]"}], "+", 
                   RowBox[{"\[Epsilon]", "[", "2", "]"}]}], ")"}], "3"]}], 
               SuperscriptBox[
                RowBox[{"(", 
                 RowBox[{"1", "+", 
                  RowBox[{"27", " ", "y"}]}], ")"}], "2"]]}], ")"}], 
            RowBox[{"Sum", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"AA", "[", 
                RowBox[{
                 RowBox[{"Length", "[", "par", "]"}], "+", "k"}], "]"}], 
               RowBox[{"Product", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{"-", "1"}], ")"}], "^", 
                   RowBox[{
                    RowBox[{"parodd", "[", 
                    RowBox[{"[", "k", "]"}], "]"}], "[", 
                    RowBox[{"[", "j", "]"}], "]"}]}], " ", 
                  RowBox[{"e\[Alpha]", "[", 
                   RowBox[{
                    RowBox[{"parodd", "[", 
                    RowBox[{"[", "k", "]"}], "]"}], "[", 
                    RowBox[{"[", "j", "]"}], "]"}], "]"}], " ", 
                  RowBox[{
                   RowBox[{"L", "[", "y", "]"}], "^", "3"}]}], ",", 
                 RowBox[{"{", 
                  RowBox[{"j", ",", "1", ",", 
                   RowBox[{"Length", "[", 
                    RowBox[{"parodd", "[", 
                    RowBox[{"[", "k", "]"}], "]"}], "]"}]}], "}"}]}], "]"}]}],
               ",", 
              RowBox[{"{", 
               RowBox[{"k", ",", "1", ",", 
                RowBox[{"Length", "[", "parodd", "]"}]}], "}"}]}], "]"}]}]}], 
          "/.", "sol"}], "//", "Simplify"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"*", 
          RowBox[{"Print", "[", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"AA", "[", "k", "]"}], "/.", "sol"}], ",", 
             RowBox[{"{", 
              RowBox[{"k", ",", "1", ",", 
               RowBox[{
                RowBox[{"Length", "[", "par", "]"}], "+", "1"}]}], "}"}]}], 
            "]"}], "]"}]}], ";"}], "**)"}], "\[IndentingNewLine]", "out"}]}], 
     "\[IndentingNewLine]", "]"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9055048986088333`*^9, 3.905504916337314*^9}, {
