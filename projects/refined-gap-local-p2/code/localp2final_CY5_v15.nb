Cell["\<\
The degree zero part of the prepotential. The \"integrand\" reads\
\>", "Text",
 CellChangeTimes->{{3.498829687882512*^9, 3.498829701725057*^9}, {
  3.498829766322032*^9, 
  3.498829787813214*^9}},ExpressionUUID->"89815545-3043-4f71-a62a-\
ee8e1085c268"],

Cell[BoxData[
 RowBox[{
  RowBox[{"exp", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"Expand", "[", 
      RowBox[{
       RowBox[{"Expand", "[", 
        RowBox[{
         RowBox[{"Expand", "[", 
          RowBox[{
           RowBox[{"Expand", "[", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"t", "[", "1", "]"}], "+", 
               RowBox[{
                RowBox[{"t", "[", "2", "]"}], " ", "p"}], "+", 
               RowBox[{
                RowBox[{"t", "[", "3", "]"}], " ", 
                RowBox[{"p", "^", "2"}]}]}], ")"}], "^", "3"}], "]"}], "/.", 
           RowBox[{
            RowBox[{"p", "^", "6"}], "\[Rule]", 
            RowBox[{
             RowBox[{"p", "^", "3"}], "Replp3"}]}]}], "]"}], "/.", 
         RowBox[{
          RowBox[{"p", "^", "5"}], "\[Rule]", 
          RowBox[{
           RowBox[{"p", "^", "2"}], "Replp3"}]}]}], "]"}], "/.", 
       RowBox[{
        RowBox[{"p", "^", "4"}], "\[Rule]", 
        RowBox[{"p", " ", "Replp3"}]}]}], "]"}], "/.", 
     RowBox[{
      RowBox[{"p", "^", "3"}], "\[Rule]", "Replp3"}]}], "//", "Simplify"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.49882971730359*^9, 3.49882973937385*^9}, {
   3.498832827176909*^9, 3.49883283417225*^9}, 3.498832899307195*^9},
 CellLabel->"In[27]:=",ExpressionUUID->"646ff468-aa11-4e20-a620-19bf94b84b0d"],

Cell["and the integral yields", "Text",
 CellChangeTimes->{{3.498829813299915*^9, 
  3.498829817853494*^9}},ExpressionUUID->"4cdf6e95-e033-468e-b220-\
56c1b9da0fe6"],

Cell[BoxData[
 RowBox[{
  RowBox[{"PrepCl", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"Series", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{"exp", " ", "/", 
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"\[Alpha]", "[", "2", "]"}], "-", 
                    RowBox[{"\[Alpha]", "[", "1", "]"}]}], ")"}]}], "/", 
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"\[Alpha]", "[", "0", "]"}], "-", 
                   RowBox[{"\[Alpha]", "[", "1", "]"}]}], ")"}]}], "/", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"-", "3"}], " ", "p"}], ")"}]}], "/.", 
               RowBox[{"p", "\[Rule]", 
                RowBox[{"-", 
                 RowBox[{"\[Alpha]", "[", "1", "]"}]}]}]}], ")"}], "+", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{"exp", "/", 
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"\[Alpha]", "[", "1", "]"}], "-", 
                    RowBox[{"\[Alpha]", "[", "2", "]"}]}], ")"}]}], "/", 
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"\[Alpha]", "[", "0", "]"}], "-", 
                   RowBox[{"\[Alpha]", "[", "2", "]"}]}], ")"}]}], "/", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"-", "3"}], " ", "p"}], ")"}]}], "/.", 
               RowBox[{"p", "\[Rule]", 
                RowBox[{"-", 
                 RowBox[{"\[Alpha]", "[", "2", "]"}]}]}]}], ")"}], "+", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{"exp", "/", 
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"\[Alpha]", "[", "1", "]"}], "-", 
                    RowBox[{"\[Alpha]", "[", "0", "]"}]}], ")"}]}], "/", 
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"\[Alpha]", "[", "2", "]"}], "-", 
                   RowBox[{"\[Alpha]", "[", "0", "]"}]}], ")"}]}], "/", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"-", "3"}], " ", "p"}], ")"}]}], "/.", 
               RowBox[{"p", "\[Rule]", 
                RowBox[{"-", 
                 RowBox[{"\[Alpha]", "[", "0", "]"}]}]}]}], ")"}]}], ")"}], 
           "/", "6"}], " ", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"t", "[", "1", "]"}], ",", "0", ",", "3"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"t", "[", "2", "]"}], ",", "0", ",", "3"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"t", "[", "3", "]"}], ",", "0", ",", "3"}], "}"}]}], 
         "]"}], "//", "Normal"}], "//", "Simplify"}], ")"}], "/", 
     RowBox[{"\[Epsilon]", "[", "1", "]"}]}], "/", 
    RowBox[{"\[Epsilon]", "[", "2", "]"}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.498829808827068*^9, 3.498829859485175*^9}, {
   3.498832669140959*^9, 3.498832676589089*^9}, {3.498832856069595*^9, 
   3.498832872892274*^9}, {3.498832912006626*^9, 3.498832998252487*^9}, {
   3.8866782504765654`*^9, 3.8866783137735186`*^9}, {3.886770148678728*^9, 
   3.886770151647185*^9}, {3.888743055092143*^9, 3.888743077017825*^9}, {
