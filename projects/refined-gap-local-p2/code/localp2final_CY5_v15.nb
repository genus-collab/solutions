Cell[BoxData[
 TagBox[
  RowBox[{"(", "\[NoBreak]", GridBox[{
     {
      FractionBox["1", 
       RowBox[{"3", " ", 
        RowBox[{"\[Alpha]", "[", "0", "]"}], " ", 
        RowBox[{"\[Alpha]", "[", "1", "]"}], " ", 
        RowBox[{"\[Alpha]", "[", "2", "]"}], " ", 
        RowBox[{"\[Epsilon]", "[", "1", "]"}], " ", 
        RowBox[{"\[Epsilon]", "[", "2", "]"}]}]], "0", "0"},
     {"0", "0", 
      RowBox[{"-", 
       FractionBox["1", 
        RowBox[{"3", " ", 
         RowBox[{"\[Epsilon]", "[", "1", "]"}], " ", 
         RowBox[{"\[Epsilon]", "[", "2", "]"}]}]]}]},
     {"0", 
      RowBox[{"-", 
       FractionBox["1", 
