Cell[CellGroupData[{

Cell["reprise", "Subsubsection",
 CellChangeTimes->{{3.910446990791462*^9, 
  3.9104469930444665`*^9}},ExpressionUUID->"42b0c147-f5e8-476f-b11a-\
090d7df543f8"],

Cell[TextData[{
 "The next function takes ",
 StyleBox["exp",
  FontSlant->"Italic"],
 " a rational function in variables (y, ",
 StyleBox["var",
  FontSlant->"Italic"],
 "), where ",
 StyleBox["var ",
  FontSlant->"Italic"],
 "satisfies polPFL[y,var]=0; it reduces it modulo polPFL in the minimal form \
P[y,",
 StyleBox["var",
  FontSlant->"Italic"],
 "]/Q[y,",
 StyleBox["var",
  FontSlant->"Italic"],
 "] where deg P and deg Q \[LessEqual]2 ."
}], "Text",
 CellChangeTimes->{{3.911388529857043*^9, 3.9113885614556313`*^9}, {
  3.911388714897128*^9, 3.9113888203076305`*^9}, {3.911388916359711*^9, 
  3.911388917135662*^9}},ExpressionUUID->"75928157-bf93-44ef-9068-\
cd3b7401360a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"LLpowred", "[", 
   RowBox[{"exp_", ",", "var_"}], "]"}], ":=", 
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"temp", "=", 
      RowBox[{"exp", "//", "Together"}]}], "}"}], ",", 
    RowBox[{
     RowBox[{
      RowBox[{"Collect", "[", 
       RowBox[{
        RowBox[{"PolynomialRemainder", "[", 
         RowBox[{
          RowBox[{"Numerator", "[", "temp", "]"}], ",", 
          RowBox[{"polPFL", "[", 
           RowBox[{"y", ",", "var"}], "]"}], ",", "var"}], "]"}], ",", 
        "var"}], "]"}], "/", 
      RowBox[{"Collect", "[", 
       RowBox[{
        RowBox[{"PolynomialRemainder", "[", 
         RowBox[{
          RowBox[{"Denominator", "[", "temp", "]"}], ",", 
          RowBox[{"polPFL", "[", 
           RowBox[{"y", ",", "var"}], "]"}], ",", "var"}], "]"}], ",", 
        "var"}], "]"}]}], "//", "Factor"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9049099063641047`*^9, 3.9049099938342466`*^9}, {
   3.9049116855020294`*^9, 3.9049117774332905`*^9}, 3.904964634261459*^9, {
   3.9075572464742813`*^9, 3.9075573012145452`*^9}, {3.91044627218449*^9, 
   3.910446272500658*^9}, {3.910449301636713*^9, 3.910449302124539*^9}},
 CellLabel->
  "In[165]:=",ExpressionUUID->"ad2b4274-1a29-4d3b-a22e-6a854e0d4927"],

