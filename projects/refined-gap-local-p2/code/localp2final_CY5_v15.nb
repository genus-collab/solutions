Cell[TextData[{
 "Compute the automorphism group of a stable graph, with input as above. As \
IGBliss can only handle simple graph, the function creates a simple graph by \
first removing multiple edges (by taking the sign of the adjacency matrix); \
computes the order of the automorphism group of the corresponding \
genus-coloured simple graph; the output multiplies that by a factor ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Product]", "v"], TraditionalForm]],ExpressionUUID->
  "eea22476-fa84-45dd-aa34-23b770ca8920"],
 "(2^|loops(v)| |loops(v)|! (",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Product]", 
    RowBox[{"w", "->", "v"}]], TraditionalForm]],ExpressionUUID->
  "cbef0e4e-4ec1-4c56-8358-3a01f341f451"],
 "|edges(v->w)|!)) to get the order for the original non-simple stable graph. \
 "
}], "Text",
 CellChangeTimes->{{3.9028921198494825`*^9, 3.902892397594264*^9}, {
  3.9028939491588163`*^9, 
  3.9028939495180373`*^9}},ExpressionUUID->"f1f93ea8-91c6-4fd6-b48d-\
b536ff8a9414"],

Cell[BoxData[
 RowBox[{
  RowBox[{"aut", "[", "tab__", "]"}], ":=", 
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"a", "=", 
       RowBox[{"tab", "[", 
        RowBox[{"[", 
         RowBox[{"-", "1"}], "]"}], "]"}]}], ",", "sa", ",", " ", "saut"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"sa", "=", 
      RowBox[{"Sign", "[", "a", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"saut", "=", 
      RowBox[{"IGBlissAutomorphismCount", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"sa", "//", "AdjacencyGraph"}], ",", 
         RowBox[{"\"\<VertexColors\>\"", "->", 
          RowBox[{"tab", "[", 
           RowBox[{"[", "2", "]"}], "]"}]}]}], "}"}], "]"}]}], ";", 
     RowBox[{"saut", " ", 
      RowBox[{"Product", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"a", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "j"}], "]"}], "]"}], "!"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", 
          RowBox[{"Length", "[", "a", "]"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", "1", ",", 
          RowBox[{"i", "-", "1"}]}], "}"}]}], "]"}], " ", 
      RowBox[{"Product", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"2", "^", 
          RowBox[{"a", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", "i"}], "]"}], "]"}]}], " ", 
         RowBox[{
          RowBox[{"a", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", "i"}], "]"}], "]"}], "!"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", 
          RowBox[{"Length", "[", "a", "]"}]}], "}"}]}], "]"}]}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.902888978667119*^9, 3.902888981145564*^9}, {
   3.9028890227412195`*^9, 3.902889060537402*^9}, {3.9028891923684874`*^9, 
   3.9028894278678093`*^9}, {3.9028894587965937`*^9, 3.902889479802184*^9}, 
   3.902889543521463*^9, {3.902889931880265*^9, 3.9028900087717075`*^9}, {
   3.9028901584213953`*^9, 3.902890196963851*^9}, {3.9028918535271554`*^9, 
   3.9028918639681625`*^9}, {3.902891898259935*^9, 3.9028919014819603`*^9}},
 CellLabel->
  "In[130]:=",ExpressionUUID->"8455f18d-ffb9-44ab-a67b-f613d4a4dc98"],

Cell["\<\
A list sorted by order of automorphism group. It\[CloseCurlyQuote]s pretty \
inefficient.\
\>", "Text",
 CellChangeTimes->{{3.9028939632586007`*^9, 
  3.902893987906993*^9}},ExpressionUUID->"395a95f0-6cfa-4d99-8ab8-\
4266b6770cae"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Do", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"grlist", "[", "l", "]"}], "=", 
      RowBox[{"SortBy", "[", 
       RowBox[{
        RowBox[{"graphlist", "[", 
         RowBox[{"in", "[", "l", "]"}], "]"}], ",", "aut"}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"l", ",", "2", ",", "6"}], "}"}]}], "]"}], ";"}], "//", 
  "AbsoluteTiming"}]], "Input",
 CellChangeTimes->{{3.9028895021206803`*^9, 3.902889511598764*^9}, {
