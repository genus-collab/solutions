Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Do", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"cch", "[", 
       RowBox[{"0", ",", "i", ",", "j"}], "]"}], "=", 
      RowBox[{
       RowBox[{
        RowBox[{"Inverse", "[", "\[Eta]", "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"1", ",", "1"}], "]"}], "]"}], " ", 
       RowBox[{"\[Eta]", "[", 
        RowBox[{"[", 
         RowBox[{
          RowBox[{"i", "+", "1"}], ",", 
          RowBox[{"j", "+", "1"}]}], "]"}], "]"}]}]}], ";", " ", 
     RowBox[{
      RowBox[{"cch", "[", 
       RowBox[{"i", ",", "0", ",", "j"}], "]"}], "=", 
      RowBox[{"KroneckerDelta", "[", 
       RowBox[{"i", ",", "j"}], "]"}]}]}], ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "0", ",", "2"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"j", ",", "0", ",", "2"}], "}"}]}], "]"}], ";", 
  RowBox[{
   RowBox[{"cch", "[", 
    RowBox[{"1", ",", "1", ",", "1"}], "]"}], "=", 
   RowBox[{
    RowBox[{"dd2", "[", "y", "]"}], "/", 
    RowBox[{"c1", "[", "y", "]"}]}]}], ";", 
  RowBox[{
   RowBox[{"cch", "[", 
    RowBox[{"2", ",", "1", ",", "1"}], "]"}], "=", 
   RowBox[{
    RowBox[{"cc2", "[", "y", "]"}], "/", 
    RowBox[{"c1", "[", "y", "]"}]}]}], ";", 
  RowBox[{
   RowBox[{"cch", "[", 
    RowBox[{"2", ",", "1", ",", "2"}], "]"}], "=", 
   RowBox[{
    RowBox[{
     RowBox[{"-", 
      RowBox[{"ee", "[", "1", "]"}]}], 
     RowBox[{
      RowBox[{"cc2", "[", "y", "]"}], "/", 
      RowBox[{"c1", "[", "y", "]"}]}]}], "+", 
    RowBox[{
     RowBox[{"dd2", "[", "y", "]"}], "/", 
     RowBox[{"c1", "[", "y", "]"}]}]}]}]}]], "Input",
 CellChangeTimes->{{3.891090504078042*^9, 3.891090553381711*^9}, {
