Cell[TextData[{
 "The asymptotic form of the ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["i", "th"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "2eadf463-f5d7-4737-9b0c-18d4beb3f83e"],
 " localised component of the I-function, up to order ZMAX."
}], "Text",
 CellChangeTimes->{{3.9113889389823833`*^9, 
  3.9113889552224736`*^9}},ExpressionUUID->"05c59779-f290-4a34-909c-\
