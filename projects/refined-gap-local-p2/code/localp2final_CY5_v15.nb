           RowBox[{
            RowBox[{"\[Delta]", "[", "1", "]"}], "+", 
            RowBox[{"\[Delta]", "[", "2", "]"}], "+", 
            RowBox[{"\[Delta]", "[", "0", "]"}]}], ",", 
           RowBox[{"p", "/.", "ReplPToCan"}], ",", " ", 
           RowBox[{
            RowBox[{"p", "^", "2"}], "/.", "ReplPToCan"}]}], "}"}]}], ",", 
