Cell[TextData[{
 "In the following, I\[CloseCurlyQuote]ll restrict the weights as above and \
extract the limit as ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Delta]", "->", "0"}], TraditionalForm]],ExpressionUUID->
  "63c3b3dd-fa79-4493-b330-5319995c7a1b"],
 " of each Taylor coefficient in ",
 StyleBox["z ",
  FontSlant->"Italic"],
 "of the R-matrix applied to the identity. It turns out to be more expedient \
to extract leading order in \[Delta] of the numerator and denominator for \
each coefficient, and to divide the former by the latter. Here goes:"
}], "Text",
 CellChangeTimes->{{3.911410256933564*^9, 3.911410355504182*^9}, {
  3.911410390943698*^9, 3.911410410963854*^9}, {3.911438855596854*^9, 
