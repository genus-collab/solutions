Cell["\<\
The deformed chiral ring is generated by (1,p,p^2), with the relation (p+\
\[Lambda]1)(p+\[Lambda]2)(p+\[Lambda]3)=0. That is:\
\>", "Text",
 CellChangeTimes->{{3.498829600754525*^9, 
  3.498829667771834*^9}},ExpressionUUID->"764c2047-60b6-4c9a-9f58-\
d420b6862dc8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Replp3", "=", 
  RowBox[{
   RowBox[{"-", 
    RowBox[{"Expand", "[", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"p", "+", 
        RowBox[{"\[Alpha]", "[", "0", "]"}]}], ")"}], 
      RowBox[{"(", 
       RowBox[{"p", "+", 
        RowBox[{"\[Alpha]", "[", "1", "]"}]}], ")"}], 
      RowBox[{"(", 
       RowBox[{"p", "+", 
        RowBox[{"\[Alpha]", "[", "2", "]"}]}], ")"}]}], "]"}]}], "+", 
   RowBox[{"p", "^", "3"}]}]}]], "Input",
 CellChangeTimes->{{3.498829672907199*^9, 3.498829674269137*^9}, {
   3.4988327894079*^9, 3.498832796604968*^9}, {3.8866783401790204`*^9, 
