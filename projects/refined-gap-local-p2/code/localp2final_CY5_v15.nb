Cell[TextData[{
 "To compute the edge term, we first compute ",
 Cell[BoxData[
  FormBox[
   RowBox[{"id", "-", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"P", "(", 
       RowBox[{"-", "w"}], ")"}], "*"], 
     RowBox[{"P", "(", 
      RowBox[{"-", "z"}], ")"}]}]}], TraditionalForm]],ExpressionUUID->
  "711daf09-21fb-4163-b1db-58ddf77da7bb"]
}], "Text",
 CellChangeTimes->{{3.911410789270224*^9, 
  3.9114108272950945`*^9}},ExpressionUUID->"c4c14f99-d10c-4a11-8b95-\
16b4540c8bb4"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Do", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"PreEdgeTerm", "[", 
      RowBox[{"i", ",", "j"}], "]"}], "=", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"(", " ", 
           RowBox[{
            RowBox[{"KroneckerDelta", "[", 
             RowBox[{"i", ",", "j"}], "]"}], "-", 
            RowBox[{"Sum", "[", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"PPdiag", "[", 
                 RowBox[{"a", ",", "i"}], "]"}], "[", 
                RowBox[{"-", "ww"}], "]"}], 
               RowBox[{
                RowBox[{"Inverse", "[", "\[Eta]", "]"}], "[", 
                RowBox[{"[", 
                 RowBox[{
                  RowBox[{"a", "+", "1"}], ",", 
                  RowBox[{"b", "+", "1"}]}], "]"}], "]"}], 
               RowBox[{
                RowBox[{"PPdiag", "[", 
                 RowBox[{"b", ",", "j"}], "]"}], "[", 
                RowBox[{"-", "zz"}], "]"}]}], ",", 
              RowBox[{"{", 
               RowBox[{"a", ",", "0", ",", "2"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"b", ",", "0", ",", "2"}], "}"}]}], "]"}]}], ")"}], "/.", 
          RowBox[{
           RowBox[{"d2", "[", "y_", "]"}], "->", 
           RowBox[{
            RowBox[{"ee", "[", "1", "]"}], 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"1", "/", "2"}], " ", 
               RowBox[{"c2", "[", "y", "]"}]}], "-", 
              RowBox[{
               RowBox[{"1", "/", "2"}], 
               RowBox[{
                RowBox[{"L", "[", "y", "]"}], "^", "3"}]}]}], ")"}]}]}]}], "/.", 
         RowBox[{
          RowBox[{"c2", "[", "y", "]"}], "->", 
          RowBox[{
           RowBox[{
            RowBox[{"L", "[", "y", "]"}], "^", "3"}], "/", 
           RowBox[{
            RowBox[{"c1", "[", "y", "]"}], "^", "2"}]}]}]}], 
        "\[IndentingNewLine]", "//.", "bigrepl"}], " ", "/.", 
       RowBox[{
        RowBox[{"LL", "[", "ll_", "]"}], "->", 
        RowBox[{
         RowBox[{"LLL", "[", "ll", "]"}], "[", "y", "]"}]}]}], "/.", 
      RowBox[{"ll", "->", "L"}]}]}], ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "0", ",", "2"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"j", ",", "0", ",", "2"}], "}"}]}], "]"}], ";"}]], "Input",
 CellChangeTimes->{{3.905933735565776*^9, 3.905933844076683*^9}, {
