   RowBox[{"\[Alpha]", "[", "0", "]"}]}], "-", 
  RowBox[{
   SuperscriptBox["p", "2"], " ", 
   RowBox[{"\[Alpha]", "[", "1", "]"}]}], "-", 
  RowBox[{"p", " ", 
