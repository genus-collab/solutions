         TagBox[
          RowBox[{"(", "l", ")"}],
          Derivative],
         MultilineFunction->None], "[", "y", "]"}], "->", 
       RowBox[{"LLpowred", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"ImplRepl", "[", 
             RowBox[{"y", ",", 
              RowBox[{
               RowBox[{"LLL", "[", "i", "]"}], "[", "y", "]"}]}], "]"}], "/.", 
            RowBox[{"P", "->", "polPFL"}]}], ")"}], "[", 
          RowBox[{"[", "l", "]"}], "]"}], ",", 
         RowBox[{
          RowBox[{"LLL", "[", "i", "]"}], "[", "y", "]"}]}], "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"l", ",", "1", ",", "3"}], "}"}]}], "]"}], "//", 
    "Simplify"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9048788621391354`*^9, 3.9048789603156*^9}, {
