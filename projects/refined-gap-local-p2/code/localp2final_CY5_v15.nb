 RowBox[{
  RowBox[{"Clear", "[", "\[Eta]", "]"}], ";", 
  RowBox[{
   RowBox[{"eta", "[", 
    RowBox[{"i_", ",", "j_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"D", "[", 
     RowBox[{
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"D", "[", 
         RowBox[{"PrepCl", ",", 
          RowBox[{"t", "[", "1", "]"}]}], "]"}], ",", 
