Cell[TextData[{
 "Same as above, but for cyclically symmetric rational functions in ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"LLL", "[", "0", "]"}], "[", "y", "]"}], ",", 
     RowBox[{
      RowBox[{"LLL", "[", "1", "]"}], "[", "y", "]"}], ",", 
     RowBox[{
      RowBox[{"LLL", "[", "2", "]"}], "[", "y", "]"}]}], "}"}], 
   TraditionalForm]],ExpressionUUID->"6576791e-563c-47a4-bf9d-6020ae187bd4"],
 "."
}], "Text",
 CellChangeTimes->{{3.9055061267389736`*^9, 3.905506141663026*^9}, {
  3.907745583553594*^9, 
  3.9077455855053415`*^9}},ExpressionUUID->"84d17eb2-cf22-4760-a7ed-\
8c0a17ec1f14"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ToSymRatLL", "[", "arg_", "]"}], ":=", "\[IndentingNewLine]", 
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", "frac", "}"}], ",", " ", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"frac", "=", 
      RowBox[{"arg", "//", "Together"}]}], ";", " ", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"ToSymPolLL", "[", 
       RowBox[{"frac", "//", "Numerator"}], "]"}], "/", 
      RowBox[{"ToSymPolLL", "[", 
       RowBox[{"frac", "//", "Denominator"}], "]"}]}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9055061713943*^9, 3.905506225598247*^9}, {
  3.9055071183221807`*^9, 3.9055071678370943`*^9}, {3.9055072199944305`*^9, 
  3.9055072459807577`*^9}, {3.905507991261714*^9, 3.9055079912811456`*^9}, {
  3.9077456660570345`*^9, 3.9077456772962046`*^9}, {3.9078224708501024`*^9, 
  3.9078224856944084`*^9}},
 CellLabel->
  "In[216]:=",ExpressionUUID->"36c4c673-9c22-4768-9dbd-85a966986ec1"],

Cell["\<\
Variables such as EdgeTerm[i,j,m,n] soon take up hundreds of Mb of RAM, and \
graph sums involving symmetric functions of them are too cumbersome for \
ToSymRatLL and ToSymPolLL to swallow. An efficient workaround is implemented \
here: we generate a table of cyclically symmetric combination of monomials in \
(LLL[0][y], LLL[1][y], LLL[2][y]), up to order MONMAX in each variable. \
\>", "Text",
 CellChangeTimes->{{3.9114401080057817`*^9, 
  3.9114402656118364`*^9}},ExpressionUUID->"860c0984-b5d8-47c1-b024-\
ab7aa82d9577"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"MONMAX", "=", "12"}]], "Input",
 CellChangeTimes->{{3.9109630926258535`*^9, 3.9109631340605674`*^9}, {
   3.9109631682298417`*^9, 3.9109631682875996`*^9}, {3.910963221744561*^9, 
   3.9109632221585665`*^9}, {3.910963369538834*^9, 3.910963369932449*^9}, {
   3.9109636222311363`*^9, 3.910963622677143*^9}, {3.910964187771218*^9, 
   3.9109641878403654`*^9}, 3.9110271940485916`*^9, {3.9110272577655983`*^9, 
   3.911027296890088*^9}, {3.911029311123727*^9, 3.9110293114258137`*^9}, {
   3.911029379202511*^9, 3.911029379484968*^9}, {3.91102942570813*^9, 
   3.911029426615657*^9}, {3.9110322398162527`*^9, 3.9110322399471865`*^9}, {
   3.9112837440376377`*^9, 3.911283744460967*^9}, {3.911284114667035*^9, 
   3.911284114731962*^9}},
 CellLabel->
  "In[217]:=",ExpressionUUID->"65fe426d-6c03-410f-8bf3-9f82728a9823"],

Cell[BoxData["12"], "Output",
 CellChangeTimes->{{3.910963095267054*^9, 3.91096313423964*^9}, 
   3.910963169956685*^9, 3.9109632226777477`*^9, 3.910963371617007*^9, 
   3.9109636232387023`*^9, 3.9109641882092395`*^9, 3.9109671630020466`*^9, 
   3.911015748741891*^9, {3.911027258098259*^9, 3.9110272978260756`*^9}, 
   3.9110293117289944`*^9, 3.9110294271233196`*^9, 3.9110322402763147`*^9, 
   3.911032997382612*^9, 3.9110340998874197`*^9, 3.9112760173547955`*^9, 
   3.911284115080364*^9, 3.9113075657408867`*^9, 3.911363261263343*^9, 
   3.979207260105785*^9},
 CellLabel->
