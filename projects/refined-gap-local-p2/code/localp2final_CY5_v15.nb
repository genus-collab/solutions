Cell["\<\
The next routine checks that the Picard-Fuchs equations are effectively \
satisfied by the ansatz. Takes about half an hour; it\[CloseCurlyQuote]s \
commented out.\
\>", "Text",
 CellChangeTimes->{{3.9113890360284977`*^9, 3.911389049475202*^9}, {
  3.9114097956629076`*^9, 
  3.911409829457975*^9}},ExpressionUUID->"5dfccfd9-de7b-4b5c-9f40-\
401f778597ab"],

Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{
   RowBox[{"*", 
    RowBox[{"Table", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Block", "[", 
       RowBox[{
        RowBox[{"{", "temp", "}"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"temp", "=", 
          RowBox[{
           RowBox[{
            RowBox[{"Numerator", "[", 
             RowBox[{"LLpowred", "[", 
              RowBox[{
               RowBox[{"Coefficient", "[", 
                RowBox[{"pf", ",", "z", ",", "k"}], "]"}], ",", 
               RowBox[{
                RowBox[{"LLL", "[", "i", "]"}], "[", "y", "]"}]}], "]"}], 
             "]"}], "/.", 
            RowBox[{"S0", "->", "S0ans"}]}], "/.", "PFAsRepl"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"Print", "[", 
          RowBox[{"\"\<Step 1 done, k=\>\"", " ", "<>", " ", 
           RowBox[{"ToString", "[", "k", "]"}]}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"temp", "=", 
          RowBox[{
           RowBox[{"temp", "//", "Together"}], "//", "Numerator"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"Print", "[", 
          RowBox[{"\"\<Step 2 done, k=\>\"", " ", "<>", " ", 
           RowBox[{"ToString", "[", "k", "]"}]}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"temp", "=", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"temp", " ", "//.", "LLDerrepl"}], "//", "Together"}], "//",
            "Numerator"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"Print", "[", 
          RowBox[{"\"\<Step 3 done, k=\>\"", " ", "<>", " ", 
           RowBox[{"ToString", "[", "k", "]"}]}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"LLpowred", "[", 
          RowBox[{"temp", ",", 
           RowBox[{
            RowBox[{"LLL", "[", "i", "]"}], "[", "y", "]"}]}], "]"}]}]}], 
       "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]", ",", 
      RowBox[{"{", 
