Cell["\<\
Fixing a bug in the input: remove spurious carriage returns (ASCII 13) in \
genus 6 and 7:\
\>", "Text",
 CellChangeTimes->{{3.9028094725900664`*^9, 3.9028094954841185`*^9}, {
  3.902890827022438*^9, 
  3.902890835177963*^9}},ExpressionUUID->"ce715ab2-e582-4c9c-9fb7-\
97685110c2bc"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"in", "[", "7", "]"}], "=", 
   RowBox[{"DeleteCases", "[", 
    RowBox[{
     RowBox[{"in", "[", "7", "]"}], ",", "13"}], "]"}]}], ";", " ", 
  RowBox[{
   RowBox[{"in", "[", "6", "]"}], "=", 
   RowBox[{"DeleteCases", "[", 
    RowBox[{
     RowBox[{"in", "[", "6", "]"}], ",", "13"}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.902764748983982*^9, 3.9027647500294967`*^9}, {
  3.9027648785958905`*^9, 3.902764896071355*^9}},
 CellLabel->
  "In[127]:=",ExpressionUUID->"68b31bac-b111-4183-b7b2-ee833c87dcd1"],

Cell["\<\
Inputs a diagonal and upper block; outputs symmetric matrix having those as \
diagonal and upper-triangular part.\
\>", "Text",
 CellChangeTimes->{{3.902891240381896*^9, 
  3.9028912769675713`*^9}},ExpressionUUID->"6ba7fa18-685d-46d0-9272-\
3d146bec4636"],

Cell[BoxData[
 RowBox[{
  RowBox[{"tabtoadj", "[", 
   RowBox[{"diag__", ",", "up__"}], "]"}], ":=", 
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"K", "=", 
       RowBox[{"Length", "[", "diag", "]"}]}], ",", "Adj", ",", "adj"}], 
     "}"}], ",", " ", 
    RowBox[{
     RowBox[{"Adj", "=", 
      RowBox[{"Array", "[", 
       RowBox[{"adj", ",", 
        RowBox[{"{", 
         RowBox[{"K", ",", "K"}], "}"}]}], "]"}]}], ";", " ", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"adj", "[", 
          RowBox[{"j", ",", "j"}], "]"}], "=", 
         RowBox[{"diag", "[", 
          RowBox[{"[", "j", "]"}], "]"}]}], ";", " ", 
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"adj", "[", 
            RowBox[{"i", ",", "j"}], "]"}], "=", 
           RowBox[{
            RowBox[{"adj", "[", 
             RowBox[{"j", ",", "i"}], "]"}], "=", 
            RowBox[{"up", "[", 
             RowBox[{"[", 
              RowBox[{"j", ",", 
               RowBox[{"i", "-", "j"}]}], "]"}], "]"}]}]}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", 
            RowBox[{"j", "+", "1"}], ",", "K"}], "}"}]}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "1", ",", "K"}], "}"}]}], "]"}], ";", " ", 
     "Adj"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.902764970441999*^9, 3.902764972133295*^9}, {
  3.90288998926036*^9, 3.902889989732424*^9}, {3.9028911135329494`*^9, 
  3.902891225407193*^9}},
 CellLabel->
  "In[128]:=",ExpressionUUID->"ad6d634a-a221-42d4-b823-0fa544f83c66"],

Cell[TextData[{
 "Inputs raw binary data for each stable graph; outputs a table in the form\n\
{K=number of components, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     SubscriptBox["g", "1"], ",", "...", ",", " ", 
     SubscriptBox["g", "K"]}], " ", "}"}], TraditionalForm]],ExpressionUUID->
  "ab6d8e26-d8c9-4611-8958-ec5bcb1408fc"],
 " = genera/colourings, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     SubscriptBox["m", "1"], ",", "...", ",", " ", 
     SubscriptBox["m", "K"]}], " ", "}"}], TraditionalForm]],ExpressionUUID->
  "54c6a85e-fb94-48d5-b9b9-bac88821a3fd"],
 " = markings/leaves,  ",
 Cell[BoxData[
  FormBox["adj", TraditionalForm]],ExpressionUUID->
  "f4d6263b-24c8-4f07-977b-e6f93455575e"],
 "= nodes/adjacency matrix}"
}], "Text",
 CellChangeTimes->{{3.902890859057649*^9, 3.902891088414254*^9}, {
   3.9028913095904584`*^9, 3.9028913126611185`*^9}, 3.9028913734554167`*^9, {
   3.9028914342594395`*^9, 
   3.902891459173254*^9}},ExpressionUUID->"3db160df-0d33-46cc-b4e7-\
bd7f63ba2c86"],

Cell[BoxData[
 RowBox[{
  RowBox[{"graphlist", "[", "raw__", "]"}], ":=", 
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"count", "=", "1"}], ",", "K", ",", " ", "g", ",", "m", ",", 
      "l", ",", "atab", ",", "a", ",", 
      RowBox[{"out", "=", 
       RowBox[{"{", "}"}]}], ",", 
      RowBox[{"count2", "=", "0"}], ",", "adj"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"While", "[", 
      RowBox[{
       RowBox[{"count", "<=", 
        RowBox[{"Length", "[", "raw", "]"}]}], ",", " ", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"K", "==", "9"}], "&&", 
           RowBox[{
            RowBox[{"raw", "[", 
             RowBox[{"[", "count", "]"}], "]"}], ">", "K"}]}], ",", 
          RowBox[{"count", "++"}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"K", "=", " ", 
         RowBox[{"raw", "[", 
          RowBox[{"[", "count", "]"}], "]"}]}], ";", " ", 
        "\[IndentingNewLine]", 
        RowBox[{"g", "=", 
         RowBox[{"Take", "[", 
          RowBox[{"raw", ",", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"count", "+", "1"}], ",", " ", 
             RowBox[{"count", "+", "K"}]}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"m", "=", 
         RowBox[{"Take", "[", 
          RowBox[{"raw", ",", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"count", "+", "K", "+", "1"}], ",", " ", 
             RowBox[{"count", "+", 
              RowBox[{"2", "K"}]}]}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"l", "=", 
         RowBox[{"Take", "[", 
          RowBox[{"raw", ",", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"count", "+", 
              RowBox[{"2", "K"}], "+", "1"}], ",", " ", 
             RowBox[{"count", "+", 
              RowBox[{"3", "K"}]}]}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"a", "=", 
         RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"K", ">", "1"}], ",", 
          RowBox[{
           RowBox[{"atab", "=", 
            RowBox[{"Take", "[", 
             RowBox[{"raw", ",", " ", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"count", "+", 
                 RowBox[{"3", "K"}], "+", "1"}], ",", " ", 
                RowBox[{"count", "+", 
                 RowBox[{"3", "K"}], "+", 
                 RowBox[{"K", 
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{"K", "-", "1"}], ")"}], "/", "2"}]}]}]}], "}"}]}],
              "]"}]}], ";", 
           RowBox[{"Do", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"a", "=", 
               RowBox[{"Join", "[", 
                RowBox[{"a", ",", 
                 RowBox[{"{", 
                  RowBox[{"Take", "[", 
                   RowBox[{"atab", ",", 
                    RowBox[{"K", "-", "j"}]}], "]"}], "}"}]}], "]"}]}], ";", 
              " ", 
              RowBox[{"atab", "=", 
               RowBox[{"Delete", "[", 
                RowBox[{"atab", ",", 
                 RowBox[{"Partition", "[", 
                  RowBox[{
                   RowBox[{"Range", "[", 
                    RowBox[{"K", "-", "j"}], "]"}], ",", "1"}], "]"}]}], 
                "]"}]}], ";"}], ",", 
             RowBox[{"{", 
              RowBox[{"j", ",", "1", ",", 
               RowBox[{"K", "-", "1"}]}], "}"}]}], "]"}], ";"}]}], "]"}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"adj", "=", 
         RowBox[{"tabtoadj", "[", 
          RowBox[{"l", ",", "a"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"AppendTo", "[", 
         RowBox[{"out", ",", 
          RowBox[{"{", 
           RowBox[{"K", ",", "g", ",", "l", ",", "adj"}], "}"}]}], "]"}], ";",
         " ", "\[IndentingNewLine]", 
        RowBox[{"count", "+=", " ", 
         RowBox[{
          RowBox[{"3", "K"}], "+", 
          RowBox[{"Length", "[", 
           RowBox[{"a", "//", "Flatten"}], "]"}], "+", "1"}]}], ";", " ", 
        RowBox[{"count2", "++"}], ";"}]}], " ", "]"}], ";", " ", "out"}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.9027217331628275`*^9, 3.902722005721919*^9}, {
   3.9027220379266367`*^9, 3.902722055621348*^9}, {3.9027220934759555`*^9, 
   3.902722176244071*^9}, {3.902722230266004*^9, 3.9027222641875834`*^9}, {
   3.9027222981504498`*^9, 3.902722308436324*^9}, {3.902722338728089*^9, 
   3.902722339786894*^9}, {3.9027223942118435`*^9, 3.902722424248669*^9}, {
   3.9027225081298404`*^9, 3.902722538708276*^9}, {3.9027226749500017`*^9, 
   3.902722704043115*^9}, {3.90272305550329*^9, 3.9027230780631976`*^9}, {
   3.902742168053233*^9, 3.902742193047192*^9}, {3.902742265940092*^9, 
   3.902742267344924*^9}, {3.902742469907467*^9, 3.9027425374347687`*^9}, {
   3.902742585275119*^9, 3.902742591182479*^9}, {3.902742636740595*^9, 
   3.902742741864794*^9}, {3.902743638827553*^9, 3.902743682790064*^9}, {
   3.9027437628418736`*^9, 3.9027437631057887`*^9}, {3.902743910935033*^9, 
   3.9027439386718025`*^9}, {3.902744000057169*^9, 3.9027440195004234`*^9}, {
   3.9027440499290657`*^9, 3.9027440512304764`*^9}, {3.9027440843008833`*^9, 
