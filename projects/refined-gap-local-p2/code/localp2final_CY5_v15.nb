Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"IAs", "[", "y_", "]"}], "=", 
   RowBox[{
    RowBox[{"Exp", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"\[Mu]\[Mu]", "[", "i", "]"}], "[", "y", "]"}], " ", "/", 
      "z"}], "]"}], 
    RowBox[{"(", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"S0", "[", 
          RowBox[{"i", ",", "k"}], "]"}], "[", "y", "]"}], " ", 
        RowBox[{"z", "^", "k"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"k", ",", "0", ",", 
         RowBox[{"ZMAX", "+", "1"}]}], "}"}]}], "]"}], ")"}]}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.9098066613204*^9, 3.9098067495631876`*^9}, {
   3.909806832112308*^9, 3.909806910734267*^9}, {3.909807329255642*^9, 
   3.909807343413612*^9}, 3.90980749347267*^9, {3.9098184564851923`*^9, 
   3.909818457891489*^9}, {3.9098186824779997`*^9, 3.909818684689951*^9}, {
   3.909900046476905*^9, 3.9099000552929583`*^9}, {3.909900255653248*^9, 
   3.909900260361142*^9}, 3.909904645360921*^9, {3.9099066450063715`*^9, 
   3.909906646434868*^9}, {3.9102380919971237`*^9, 3.910238093705404*^9}, 
   3.9102381819895153`*^9, {3.9104495835187907`*^9, 3.910449585649687*^9}},
 CellLabel->
  "In[170]:=",ExpressionUUID->"7ae3f634-c93f-499f-9fd6-be449a279430"],

Cell["\<\
The Picard-Fuchs operator applied to the asymptotic expansion of the \
I-function.\
\>", "Text",
 CellChangeTimes->{{3.911388960373541*^9, 
  3.9113889828776503`*^9}},ExpressionUUID->"a07d9816-f939-49bd-ad5d-\
3ce50f69aea6"],

Cell[BoxData[
 RowBox[{
  RowBox[{"pf", "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{
            RowBox[{"\[Mu]\[Mu]", "[", "i", "]"}], "[", "y", "]"}]}], " ", 
          "/", "z"}], "]"}], 
        RowBox[{"Block", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"coeff", "=", 
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{"(", "z", ")"}], " ", "^", "k"}], " ", 
                RowBox[{"ee", "[", 
                 RowBox[{"3", "-", "k"}], "]"}]}], ",", 
               RowBox[{"{", 
                RowBox[{"k", ",", "0", ",", "3"}], "}"}]}], "]"}]}], ",", 
            RowBox[{"coeff2", "=", 
             RowBox[{"CoefficientList", "[", 
              RowBox[{
               RowBox[{"Series", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{"3", "z", " ", "DY"}], " ", ")"}], 
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"3", "z", " ", "DY"}], " ", "+", "z"}], ")"}], 
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"3", "z", " ", "DY"}], "+", 
                    RowBox[{"2", " ", "z"}]}], " ", ")"}]}], ",", 
                 RowBox[{"{", 
                  RowBox[{"DY", ",", "0", ",", "3"}], "}"}]}], "]"}], ",", 
               "DY"}], "]"}]}]}], "}"}], ",", 
          RowBox[{
           RowBox[{"Sum", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"coeff", "[", 
               RowBox[{"[", 
                RowBox[{"n", "+", "1"}], "]"}], "]"}], " ", 
              RowBox[{"D", "[", 
               RowBox[{
                RowBox[{"IAs", "[", 
                 RowBox[{"Exp", "[", "Y", "]"}], "]"}], ",", 
                RowBox[{"{", 
                 RowBox[{"Y", ",", "n"}], "}"}]}], "]"}]}], ",", 
             RowBox[{"{", 
              RowBox[{"n", ",", "0", ",", "3"}], "}"}]}], "]"}], "+", 
           RowBox[{"y", " ", 
            RowBox[{"Sum", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"coeff2", "[", 
                RowBox[{"[", 
                 RowBox[{"n", "+", "1"}], "]"}], "]"}], " ", 
               RowBox[{"D", "[", 
                RowBox[{
                 RowBox[{"IAs", "[", 
                  RowBox[{"Exp", "[", "Y", "]"}], "]"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"Y", ",", "n"}], "}"}]}], "]"}]}], ",", 
              RowBox[{"{", 
               RowBox[{"n", ",", "0", ",", "3"}], "}"}]}], "]"}]}]}]}], 
         "]"}]}], "/.", 
       RowBox[{"Y", "->", 
        RowBox[{"Log", "[", "y", "]"}]}]}], "/.", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"\[Mu]\[Mu]", "[", "i", "]"}], "'"}], "[", "y", "]"}], "->", 
           RowBox[{
            RowBox[{
             RowBox[{"LLL", "[", "i", "]"}], "[", "y", "]"}], "/", "y"}]}], 
          ",", 
          RowBox[{"{", 
           RowBox[{"y", ",", "n"}], "}"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"n", ",", "0", ",", "3"}], "}"}]}], "]"}]}], "//.", 
     "LLDerrepl"}], "//", "Expand"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.909805992411893*^9, 3.9098060618388777`*^9}, {
   3.909806761641465*^9, 3.9098068043424883`*^9}, 3.9098068942101765`*^9, {
   3.9098069272871227`*^9, 3.9098069323020973`*^9}, {3.9098073688740377`*^9, 
   3.909807370437247*^9}, {3.9098074959834414`*^9, 3.9098075003103933`*^9}, {
   3.9098077738015757`*^9, 3.9098077740435643`*^9}, {3.9098184636608067`*^9, 
   3.909818468313985*^9}, 3.9098210591292877`*^9, {3.9099000762393756`*^9, 
   3.9099001648740435`*^9}, {3.9099002492932453`*^9, 
   3.9099002670819244`*^9}, {3.909904584381648*^9, 3.909904609847243*^9}, {
   3.9099046490759945`*^9, 3.9099046492864122`*^9}, {3.910193808611768*^9, 
   3.9101938166212106`*^9}, 3.9101968931862774`*^9},
 CellLabel->
  "In[171]:=",ExpressionUUID->"c8d147f2-739a-47a7-913f-1a80866127da"],

Cell["Ansatz for the solution of pf=0.", "Text",
 CellChangeTimes->{{3.91138898845254*^9, 
  3.911388997845148*^9}},ExpressionUUID->"72ecd290-1166-4e9d-ad91-\
5362d738040f"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"S0ans", "[", 
     RowBox[{"i_", ",", "k_"}], "]"}], "[", "y_", "]"}], ":=", 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"pp", "[", "k", "]"}], "[", "l", "]"}], "[", "m", "]"}], " ", 
      
      RowBox[{
       RowBox[{
        RowBox[{"LLL", "[", "i", "]"}], "[", "y", "]"}], "^", "l"}], " ", 
      RowBox[{
       RowBox[{
        RowBox[{"y", "^", "m"}], "/", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"3", " ", 
            RowBox[{"ee", "[", "3", "]"}]}], "+", 
           RowBox[{
            RowBox[{"ee", "[", "2", "]"}], " ", 
            RowBox[{
             RowBox[{"LLL", "[", "i", "]"}], "[", "y", "]"}]}]}], ")"}], "^", 
         
         RowBox[{"(", 
          RowBox[{"k", "+", "2"}], ")"}]}]}], "/", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", "+", 
            RowBox[{"27", " ", "y"}]}], ")"}], " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", 
             SuperscriptBox[
              RowBox[{"ee", "[", "2", "]"}], "3"]}], "+", 
            RowBox[{"27", " ", 
             RowBox[{"(", 
              RowBox[{"1", "+", 
               RowBox[{"27", " ", "y"}]}], ")"}], " ", 
             SuperscriptBox[
              RowBox[{"ee", "[", "3", "]"}], "2"]}]}], ")"}]}], ")"}], "^", 
        "k"}]}]}], ",", 
     RowBox[{"{", 
      RowBox[{"l", ",", "0", ",", "2"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"m", ",", "0", ",", 
       RowBox[{"2", "k"}]}], "}"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.910197083641404*^9, 3.910197119229166*^9}, {
  3.9101974077636347`*^9, 3.910197407854651*^9}, {3.910197626769142*^9, 
  3.9101976268640337`*^9}},
 CellLabel->
  "In[172]:=",ExpressionUUID->"11b0ebad-b801-45cd-89c2-d547ff650df1"],

Cell[TextData[{
 "Feeding the ansatz to the solution will give a linear system for the \
unknown coefficients pp[k][l][m]. It turns out that, with the bounds above on \
the exponents appearing in the numerator and denominator, the system admits a \
unique solution up to normalisation of pp[k][0][0]. \nThe next routine solves \
the linear system arising from the ansatz, fixing the normalisation such that \
",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"pp", "[", "k", "]"}], "[", "0", "]"}], "[", "0", "]"}], "=", 
    SubscriptBox["\[Delta]", "k0"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "6200e9d6-6c9f-40f0-a377-3e2c5abae6f2"],
 ". It takes a while. The result is copied below."
}], "Text",
 CellChangeTimes->{{3.911389005676676*^9, 3.9113890276116285`*^9}, {
  3.9114096549324956`*^9, 
  3.9114097858403387`*^9}},ExpressionUUID->"90228689-f8c5-4b7a-8f20-\
445e8e0f7bcf"],

Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{
   RowBox[{"*", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"eq", ",", "d\[Phi]dy", ",", 
        RowBox[{"repl", "=", 
         RowBox[{"{", "}"}]}], ",", "temp", ",", "mat", ",", "vec", ",", 
        "sol", ",", "tabpp"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Do", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"eq", "=", 
           RowBox[{"CoefficientList", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"LLpowred", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{"Simplify", "[", 
                    RowBox[{"Coefficient", "[", 
                    RowBox[{"pf", ",", "z", ",", "k"}], "]"}], "]"}], "/.", 
                    RowBox[{"S0", "->", "S0ans"}]}], "/.", "repl"}], "//", 
                    "Together"}], "//", "Numerator"}], ")"}], "//.", 
                   "LLDerrepl"}], "//", "Together"}], "//", "Numerator"}], 
                ",", 
                RowBox[{
                 RowBox[{"LLL", "[", "i", "]"}], "[", "y", "]"}]}], "]"}], "//",
               "Numerator"}], ",", 
             RowBox[{"{", 
              RowBox[{"y", ",", 
               RowBox[{
                RowBox[{"LLL", "[", "i", "]"}], "[", "y", "]"}]}], "}"}]}], 
            "]"}]}], ";", " ", "\[IndentingNewLine]", 
          RowBox[{"repl", "=", 
           RowBox[{"Join", "[", 
            RowBox[{"repl", ",", 
             RowBox[{
              RowBox[{"Solve", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"eq", "==", "0"}], " ", "&&", " ", 
                 RowBox[{
                  RowBox[{
                   RowBox[{
                    RowBox[{"pp", "[", 
                    RowBox[{"k", "-", "1"}], "]"}], "[", "0", "]"}], "[", "0",
                    "]"}], "==", 
                  RowBox[{"KroneckerDelta", "[", 
                   RowBox[{"k", ",", "1"}], "]"}]}]}], ",", 
                RowBox[{
                 RowBox[{"Table", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{
                    RowBox[{"pp", "[", 
                    RowBox[{"k", "-", "1"}], "]"}], "[", "l", "]"}], "[", "m",
                     "]"}], ",", 
                   RowBox[{"{", 
                    RowBox[{"l", ",", "0", ",", "2"}], "}"}], ",", 
                   RowBox[{"{", 
                    RowBox[{"m", ",", "0", ",", 
                    RowBox[{
                    RowBox[{"2", "k"}], "-", "2"}]}], "}"}]}], "]"}], "//", 
                 "Flatten"}]}], "]"}], "//", "Flatten"}]}], "]"}]}], ";"}], 
         "\[IndentingNewLine]", ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", "1", ",", 
           RowBox[{"ZMAX", "+", "1"}]}], "}"}]}], "]"}], ";", " ", 
       RowBox[{"PFAsRepl", "=", "repl"}]}]}], "]"}]}], ";"}], 
  "**)"}]], "Input",
 CellChangeTimes->{{3.905245399027214*^9, 3.9052454036047497`*^9}, {
   3.905245527890751*^9, 3.90524563440898*^9}, {3.905245708543486*^9, 
   3.9052458820222716`*^9}, {3.90524597061522*^9, 3.905246020733502*^9}, {
   3.9052460738444023`*^9, 3.905246462959733*^9}, {3.9052465677228403`*^9, 
   3.9052467542041283`*^9}, {3.905246797604102*^9, 3.905246923314122*^9}, {
   3.9052469891334157`*^9, 3.9052469896055145`*^9}, {3.9052475030381956`*^9, 
   3.90524753643237*^9}, {3.9052484624758897`*^9, 3.9052484731894865`*^9}, {
   3.9052485822012253`*^9, 3.905248582341112*^9}, {3.9052725184201546`*^9, 
   3.9052725543071775`*^9}, {3.905272585709594*^9, 3.905272587002425*^9}, {
   3.9052727007564344`*^9, 3.9052727014094667`*^9}, 3.905272885404644*^9, {
   3.9053152758233457`*^9, 3.905315453592805*^9}, {3.9053155151544113`*^9, 
   3.905315515417043*^9}, 3.905315652945134*^9, {3.9053157357911463`*^9, 
   3.905315762600484*^9}, {3.905315806755951*^9, 3.905315809787309*^9}, {
   3.9053158472870054`*^9, 3.90531587700733*^9}, {3.905315930472103*^9, 
   3.905316021904464*^9}, {3.9053161191668262`*^9, 3.905316125458083*^9}, {
   3.9053178574391823`*^9, 3.9053178626272645`*^9}, {3.9053236306241145`*^9, 
   3.905323630664237*^9}, {3.9053237296445613`*^9, 3.905323731588434*^9}, {
   3.9053238593940086`*^9, 3.9053238601525908`*^9}, {3.90532694070325*^9, 
