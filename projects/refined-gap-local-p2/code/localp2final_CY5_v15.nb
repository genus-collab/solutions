Cell[TextData[{
 "The R-matrix in the fibrewise limit and in minimal form, finally. It\
\[CloseCurlyQuote]s expressed in a mixed basis ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["P", 
    RowBox[{"a", " ", "i"}]], TraditionalForm]],ExpressionUUID->
  "df4e4142-96bb-47e7-b547-64c2d953278c"],
 "=",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["Coeff", 
     SubscriptBox["e", "i"]], 
    RowBox[{"R", "(", 
     SuperscriptBox["H", "a"], ")"}]}], TraditionalForm]],ExpressionUUID->
  "210ac942-20e3-4dd4-9484-3ac33d2652c3"],
 ": we pick the flat basis for the argument, and the normalised canonical for \
the image."
}], "Text",
 CellChangeTimes->{{3.911410492246956*^9, 
  3.9114106860872755`*^9}},ExpressionUUID->"3496f797-9616-4d11-b041-\
19df8f626bff"],

