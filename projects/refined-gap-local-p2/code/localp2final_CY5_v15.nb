Cell[TextData[{
 "We have that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"C", "[", 
      RowBox[{"x", ",", "y", ",", "z"}], "]"}], 
     SubscriptBox["\[Mu]", "3"]], " ", "=", " ", 
    RowBox[{"C", "[", 
     RowBox[{
      SubscriptBox["e", "1"], ",", 
      SubscriptBox["e", "2"], ",", 
      SubscriptBox["e", "3"], ",", "o"}], "]"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "03126cc8-8df6-439a-8b07-1d0923613bc9"],
 "/(",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["o", "2"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "e69509ea-22ad-4cec-8125-bb12227c2ee7"],
 "=",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    SubsuperscriptBox["e", "1", "2"], " ", 
    SubsuperscriptBox["e", "2", "2"]}], "-", 
   RowBox[{"4", " ", 
    SubsuperscriptBox["e", "2", "3"]}], "-", 
   RowBox[{"4", " ", 
    SubsuperscriptBox["e", "1", "3"], " ", 
    SubscriptBox["e", "3"]}], "+", 
   RowBox[{"18", " ", 
    SubscriptBox["e", "1"], " ", 
    SubscriptBox["e", "2"], " ", 
    SubscriptBox["e", "3"]}], "-", 
   RowBox[{"27", " ", 
    SubsuperscriptBox["e", "3", "2"]}]}]],
  CellChangeTimes->{{3.9114398101142464`*^9, 3.911439827668459*^9}},
  ExpressionUUID->"2225b898-474e-4d19-9e76-e7c9d4f0c45d"],
 "): here ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["e", "i"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "5139e4e3-4f7e-47a7-87d4-fdd83bae70ed"],
 " is the ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["i", "th"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "62b437e9-1703-4d11-bbea-57e58f9e7944"],
 " elementary symmetric polynomial, and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"o", "(", 
     RowBox[{"x", ",", "y", ",", "z"}], ")"}], "=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"x", "-", "y"}], ")"}], 
     RowBox[{"(", 
      RowBox[{"x", "-", "z"}], ")"}], 
     RowBox[{"(", 
      RowBox[{"y", "-", "z"}], ")"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "cc1453b4-0f70-4409-8a26-9dc4922b6ec2"],
 " is cyclically invariant and odd under transposition. \
Let\[CloseCurlyQuote]s figure out what ",
 Cell[BoxData[
  FormBox[
