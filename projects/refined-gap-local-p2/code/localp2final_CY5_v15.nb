Cell["A Groebener basis for the ideal.", "Text",
 CellChangeTimes->{{3.9114392173932624`*^9, 
  3.9114392234911366`*^9}},ExpressionUUID->"b15e8297-45ff-4209-8dae-\
355068b76f90"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"grb", "=", 
  RowBox[{"DeleteCases", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"GroebnerBasis", "[", 
      RowBox[{"ngrb", ",", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"LLL", "[", "i", "]"}], "[", "y", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "0", ",", "2"}], "}"}]}], "]"}]}], "]"}], "//", 
     "Simplify"}], ",", "0"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9078214497730103`*^9, 3.9078214635130215`*^9}, {
  3.907821576256728*^9, 3.9078215855413756`*^9}},
 CellLabel->
  "In[212]:=",ExpressionUUID->"98e2b8ee-3430-492a-b759-3dd7d2fc0f53"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   FractionBox[
    RowBox[{
     RowBox[{"-", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         RowBox[{"\[Epsilon]", "[", "1", "]"}], "+", 
         RowBox[{"\[Epsilon]", "[", "2", "]"}]}], ")"}], "3"]}], "+", 
     RowBox[{"9", " ", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         RowBox[{"\[Epsilon]", "[", "1", "]"}], "+", 
         RowBox[{"\[Epsilon]", "[", "2", "]"}]}], ")"}], "2"], " ", 
      RowBox[{
       RowBox[{"LLL", "[", "2", "]"}], "[", "y", "]"}]}], "-", 
     RowBox[{"27", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"\[Epsilon]", "[", "1", "]"}], "+", 
        RowBox[{"\[Epsilon]", "[", "2", "]"}]}], ")"}], " ", 
      SuperscriptBox[
       RowBox[{
        RowBox[{"LLL", "[", "2", "]"}], "[", "y", "]"}], "2"]}], "+", 
     RowBox[{"27", " ", 
      RowBox[{"(", 
       RowBox[{"1", "+", 
        RowBox[{"27", " ", "y"}]}], ")"}], " ", 
      SuperscriptBox[
       RowBox[{
        RowBox[{"LLL", "[", "2", "]"}], "[", "y", "]"}], "3"]}]}], 
    RowBox[{"1", "+", 
     RowBox[{"27", " ", "y"}]}]], ",", 
   FractionBox[
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        RowBox[{"\[Epsilon]", "[", "1", "]"}], "+", 
        RowBox[{"\[Epsilon]", "[", "2", "]"}]}], ")"}], "2"], "+", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"3", "+", 
        RowBox[{"81", " ", "y"}]}], ")"}], " ", 
      SuperscriptBox[
       RowBox[{
        RowBox[{"LLL", "[", "1", "]"}], "[", "y", "]"}], "2"]}], "-", 
     RowBox[{"3", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"\[Epsilon]", "[", "1", "]"}], "+", 
        RowBox[{"\[Epsilon]", "[", "2", "]"}]}], ")"}], " ", 
      RowBox[{
       RowBox[{"LLL", "[", "2", "]"}], "[", "y", "]"}]}], "+", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"3", "+", 
        RowBox[{"81", " ", "y"}]}], ")"}], " ", 
      SuperscriptBox[
       RowBox[{
        RowBox[{"LLL", "[", "2", "]"}], "[", "y", "]"}], "2"]}], "-", 
     RowBox[{"3", " ", 
      RowBox[{
       RowBox[{"LLL", "[", "1", "]"}], "[", "y", "]"}], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"\[Epsilon]", "[", "1", "]"}], "+", 
        RowBox[{"\[Epsilon]", "[", "2", "]"}], "-", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "+", 
           RowBox[{"27", " ", "y"}]}], ")"}], " ", 
         RowBox[{
          RowBox[{"LLL", "[", "2", "]"}], "[", "y", "]"}]}]}], ")"}]}]}], 
    RowBox[{"1", "+", 
     RowBox[{"27", " ", "y"}]}]], ",", 
   RowBox[{
    RowBox[{
     RowBox[{"LLL", "[", "0", "]"}], "[", "y", "]"}], "+", 
    RowBox[{
     RowBox[{"LLL", "[", "1", "]"}], "[", "y", "]"}], "-", 
