  RowBox[{"replLL", "=", 
   RowBox[{"Solve", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"ee", "[", "i", "]"}], 
           RowBox[{"XX", "^", 
            RowBox[{"(", 
             RowBox[{"3", "-", "i"}], ")"}]}]}], "/.", 
          RowBox[{"LL", "->", "\[Alpha]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "1", ",", "3"}], "}"}]}], "]"}], "+", 
       RowBox[{
        RowBox[{"XX", "^", "3"}], "/", 
        RowBox[{
         RowBox[{"ll", "[", "y", "]"}], "^", "3"}]}]}], "==", "0"}], ",", 
     "XX"}], "]"}]}], ";"}]], "Input",
