Cell[TextData[{
 "Expansion of B-period (normalised by Sqrt[3]/2/Pi) at the conifold point. \
Recall that C2= ",
 Cell[BoxData[
  FormBox[
   RowBox[{"y", 
    RowBox[{
     SubscriptBox["\[Del]", "y"], 
     RowBox[{"(", 
      RowBox[{"1", "/", 
       SubscriptBox["C", "1"]}], ")"}]}], "y", 
    RowBox[{
     SubscriptBox["\[Del]", "y"], 
     SubscriptBox["\[CapitalPi]", "B"]}]}], TraditionalForm]],ExpressionUUID->
  "6a018373-c825-4714-86e7-eb6bf36cae80"],
 " = ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{"\[CapitalDelta]", "-", "1"}], ")"}], 
    RowBox[{
     SubscriptBox["\[Del]", "\[CapitalDelta]"], 
     RowBox[{"(", 
      RowBox[{"1", "/", 
