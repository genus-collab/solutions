Cell[BoxData[
 RowBox[{"Do", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"Leaf", "[", 
     RowBox[{"i", ",", "n", ",", "a"}], "]"}], "=", " ", 
    RowBox[{"Coefficient", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"PPdiag", "[", 
          RowBox[{"a", ",", "i"}], "]"}], "[", 
         RowBox[{"-", "z"}], "]"}], "/.", 
        RowBox[{
         RowBox[{"d2", "[", "y_", "]"}], "->", 
         RowBox[{
          RowBox[{"ee", "[", "1", "]"}], 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"1", "/", "2"}], " ", 
             RowBox[{"c2", "[", "y", "]"}]}], "-", 
            RowBox[{
             RowBox[{"1", "/", "2"}], 
             RowBox[{
              RowBox[{"L", "[", "y", "]"}], "^", "3"}]}]}], ")"}]}]}]}], "/.", 
       RowBox[{
        RowBox[{"c2", "[", "y", "]"}], "->", 
        RowBox[{
         RowBox[{
          RowBox[{"L", "[", "y", "]"}], "^", "3"}], "/", 
         RowBox[{
          RowBox[{"c1", "[", "y", "]"}], "^", "2"}]}]}]}], ",", "z", ",", 
      "n"}], "]"}]}], ",", 
   RowBox[{"{", 
    RowBox[{"i", ",", "0", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"n", ",", "0", ",", "ZMAX"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"a", ",", "0", ",", "2"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.904810847121047*^9, 3.90481088929408*^9}, {
