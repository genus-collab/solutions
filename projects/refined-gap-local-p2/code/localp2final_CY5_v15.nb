          RowBox[{"Numerator", "[", "temp", "]"}], ",", 
          RowBox[{"polPFLdiag", "[", 
           RowBox[{"y", ",", "var"}], "]"}], ",", "var"}], "]"}], ",", 
        "var"}], "]"}], "/", 
      RowBox[{"Collect", "[", 
