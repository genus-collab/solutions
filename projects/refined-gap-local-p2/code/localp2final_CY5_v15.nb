         RowBox[{"k", "/", "3"}], " ", "z"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"b", ",", "0", ",", 
         RowBox[{"l", "-", "1"}]}], "}"}]}], "]"}], ",", 
