    RowBox[{"(", 
     RowBox[{
      RowBox[{"3", " ", 
       RowBox[{"ee", "[", "3", "]"}]}], "+", 
      RowBox[{
       RowBox[{"ee", "[", "2", "]"}], " ", 
       RowBox[{
        RowBox[{"LLL", "[", "i", "]"}], "[", "y", "]"}]}]}], ")"}]}]}], ";", 
  RowBox[{
   RowBox[{"sqrt\[CapitalDelta]cl", "[", "i", "]"}], "=", 
   RowBox[{
    RowBox[{"Sqrt", "[", "  ", 
     RowBox[{
      RowBox[{"\[Epsilon]", "[", "1", "]"}], " ", 
      RowBox[{
       RowBox[{"\[Epsilon]", "[", "2", "]"}], "/", 
       RowBox[{"ee", "[", "3", "]"}]}]}], "]"}], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"3", " ", 
       RowBox[{"ee", "[", "3", "]"}]}], "-", 
      RowBox[{
       RowBox[{"ee", "[", "2", "]"}], " ", 
       RowBox[{"\[Alpha]", "[", "i", "]"}]}]}], ")"}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.908510688442294*^9, 3.9085107437620583`*^9}, {
   3.9085108080203514`*^9, 3.9085108104979105`*^9}, {3.908511597654254*^9, 
   3.9085115987155166`*^9}, 3.908511974431106*^9, {3.9085121064531264`*^9, 
   3.9085121076191854`*^9}, {3.908515892519456*^9, 3.908515894570402*^9}, 
   3.908516168891651*^9, {3.910342209852383*^9, 3.9103422115627475`*^9}, {
   3.910342356844843*^9, 3.9103423690189266`*^9}},
 CellLabel->
  "In[177]:=",ExpressionUUID->"8db344ff-824e-4773-bde4-a901b5a56d1e"],

Cell[TextData[{
 "Constructing the R-matrix now. The previous ansatz was not normalised such \
that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["e", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{
        SubscriptBox["u", "j"], "(", "y", ")"}]}], "/", "z"}]], 
    SubscriptBox["I", "j"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "cf549600-1c56-4313-873f-1e3f6a765af8"],
 "(y,z) -> z for y->0. We ensure that this is the case below.  "
}], "Text",
 CellChangeTimes->{{3.911389102193198*^9, 
  3.911389195294821*^9}},ExpressionUUID->"cd69730d-b087-4ac7-8dda-\
897685f2321e"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"PPunnorm", "[", 
     RowBox[{"0", ",", "i_"}], "]"}], "[", "z_", "]"}], "=", 
   RowBox[{
    RowBox[{
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"S0ans", "[", 
           RowBox[{"i", ",", "k"}], "]"}], "[", "y", "]"}], 
         RowBox[{"z", "^", "k"}]}], "/.", "PFAsRepl"}], ",", 
       RowBox[{"{", 
        RowBox[{"k", ",", "0", ",", "ZMAX"}], "}"}]}], "]"}], "+", 
     RowBox[{
      RowBox[{"O", "[", "z", "]"}], "^", 
      RowBox[{"(", 
       RowBox[{"ZMAX", "+", "1"}], ")"}]}]}], "//", "Simplify"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.905256521250121*^9, 3.9052566217005835`*^9}, {
   3.905256680047948*^9, 3.9052566871848626`*^9}, {3.905256764522191*^9, 
   3.905256764803341*^9}, {3.905257252153207*^9, 3.9052572534595175`*^9}, {
   3.9052573827343135`*^9, 3.905257395461073*^9}, 3.9052574532156353`*^9, {
   3.905258450387677*^9, 3.9052584531223927`*^9}, {3.905259562298197*^9, 
   3.9052595625272727`*^9}, 3.9052597300497346`*^9, {3.905419487289494*^9, 
   3.905419497997372*^9}, 3.9054200221515803`*^9, {3.9054209321780386`*^9, 
   3.905420934723737*^9}, {3.9054225228244867`*^9, 3.9054225324627447`*^9}, {
   3.905423091294626*^9, 3.905423115893998*^9}, 3.9055789507021427`*^9, 
   3.9084366131428857`*^9, {3.9084372131180215`*^9, 3.9084372150904093`*^9}, {
   3.9085107481207523`*^9, 3.9085107566106043`*^9}, {3.910341086290924*^9, 
   3.9103410911628523`*^9}, 3.910341148915099*^9, {3.910342105551259*^9, 
   3.910342106437503*^9}},
 CellLabel->
  "In[178]:=",ExpressionUUID->"7c445ff7-3953-4cc5-8754-8816fbee43e0"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"normLR", "[", 
    RowBox[{"i_", ",", "z_"}], "]"}], "=", 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"cnormLR", "[", 
       RowBox[{"i", ",", "k"}], "]"}], " ", 
      RowBox[{"z", "^", "k"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"k", ",", "0", ",", "ZMAX"}], "}"}]}], "]"}]}], ";"}]], "Input",\

 CellChangeTimes->{{3.9096402643556595`*^9, 3.9096402833264713`*^9}, {
  3.910342112884714*^9, 3.9103421163254433`*^9}},
 CellLabel->
  "In[179]:=",ExpressionUUID->"b0073a9c-25c0-4384-b451-e755616a9866"],

Cell[BoxData[
 RowBox[{
  RowBox[{"replnormI", "=", 
   RowBox[{
    RowBox[{"Solve", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"Take", "[", 
           RowBox[{
            RowBox[{"CoefficientList", "[", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"PPunnorm", "[", 
                 RowBox[{"0", ",", "i"}], "]"}], "[", "z", "]"}], " ", 
               RowBox[{"normLR", "[", 
                RowBox[{"i", ",", "z"}], "]"}]}], ",", "z"}], "]"}], ",", 
            RowBox[{"ZMAX", "+", "1"}]}], "]"}], "/.", 
          RowBox[{"y", "->", "0"}]}], "/.", 
         RowBox[{
          RowBox[{
           RowBox[{"LLL", "[", "i", "]"}], "[", "0", "]"}], "->", 
          RowBox[{"-", 
           RowBox[{"\[Alpha]", "[", "i", "]"}]}]}]}], ")"}], "==", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"KroneckerDelta", "[", 
           RowBox[{"k", ",", "0"}], "]"}], "/", 
          RowBox[{"sqrt\[CapitalDelta]cl", "[", "i", "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", "0", ",", "ZMAX"}], "}"}]}], "]"}]}], ",", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"cnormLR", "[", 
          RowBox[{"i", ",", "k"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", "0", ",", "ZMAX"}], "}"}]}], "]"}], "//", 
       "Simplify"}]}], "]"}], "//", "Flatten"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9096403353141365`*^9, 3.9096404358598948`*^9}, {
  3.9096404760664644`*^9, 3.9096404768594666`*^9}, {3.909657920576507*^9, 
  3.9096579216989174`*^9}, {3.909819253494282*^9, 3.909819258142222*^9}, {
  3.9098195106228933`*^9, 3.909819513942644*^9}, {3.910342217803528*^9, 
  3.9103422386107855`*^9}, {3.9103423182809687`*^9, 3.9103423250702815`*^9}},
 CellLabel->
  "In[180]:=",ExpressionUUID->"50e1c391-6aa0-423b-b80b-6b829e8ee99b"],

Cell[TextData[{
 "So PPunnorm[0,i][z] normLR[i,z] /. replnormI returns the S-matrix acting on \
the identity (times ",
 Cell[BoxData[
  FormBox[
   RowBox[{"diag", "(", 
    SuperscriptBox["e", 
     RowBox[{
      RowBox[{"-", "u"}], "/", "z"}]]}], TraditionalForm]],ExpressionUUID->
  "20e3f271-1d57-4c8a-a853-8660fe07d1cf"],
 ")). To get the identity column of the R-matrix, we need to normalise by the \
materialisation constants from quantum Riemann-Roch."
}], "Text",
 CellChangeTimes->{{3.911389230358429*^9, 3.911389318980754*^9}, {
  3.911409837539258*^9, 
  3.911409874238684*^9}},ExpressionUUID->"dc64243a-407d-42f4-8f0f-\
1cd317094f5e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"replqrr", " ", "=", " ", 
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", "ser", "}"}], ",", 
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"qrrc", "[", 
          RowBox[{"ll_", ",", "k"}], "]"}], "->", 
         RowBox[{"SeriesCoefficient", "[", 
          RowBox[{
           RowBox[{"Series", "[", 
            RowBox[{
             RowBox[{"Exp", "[", 
              RowBox[{"Sum", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"Qrrc", "[", 
                  RowBox[{"ll", ",", "k"}], "]"}], " ", 
                 RowBox[{"z", "^", 
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"2", "k"}], "+", "1"}], ")"}]}]}], ",", 
                RowBox[{"{", 
                 RowBox[{"k", ",", "0", ",", "ZMAX"}], "}"}]}], "]"}], "]"}], 
             ",", 
             RowBox[{"{", 
              RowBox[{"z", ",", "0", ",", 
               RowBox[{"ZMAX", "+", "1"}]}], "}"}]}], "]"}], ",", "k"}], 
          "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"k", ",", "0", ",", 
          RowBox[{"ZMAX", "+", "1"}]}], "}"}]}], "]"}], "//", "Flatten"}]}], 
    "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9048037076255894`*^9, 3.904803767070058*^9}, {
  3.9048038792812014`*^9, 3.9048038793630276`*^9}, {3.9048104198218994`*^9, 
  3.904810515949316*^9}, {3.90481063745613*^9, 3.904810638572482*^9}, {
  3.9055027351684976`*^9, 3.905502754680562*^9}, {3.9084375812380223`*^9, 
  3.9084375921792383`*^9}, {3.9084483325316257`*^9, 3.9084483333206096`*^9}, {
  3.9084489369652853`*^9, 3.908448938857415*^9}},
 CellLabel->
  "In[181]:=",ExpressionUUID->"985f44e9-3f5c-498e-abab-2493d92f585a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ff", "[", "i_", "]"}], "[", "z_", "]"}], "=", 
  RowBox[{
   RowBox[{
    RowBox[{"Series", "[", 
     RowBox[{
      RowBox[{"1", "+", 
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"qrrc", "[", 
           RowBox[{"i", ",", "k"}], "]"}], 
          RowBox[{"z", "^", "k"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", "1", ",", "ZMAX"}], "}"}]}], "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"z", ",", "0", ",", "ZMAX"}], "}"}]}], "]"}], "//", 
    "Simplify"}], "//", "Normal"}]}]], "Input",
 CellChangeTimes->{{3.9055791145933847`*^9, 3.9055791463864603`*^9}, 
   3.90843755740812*^9, {3.9084375878269367`*^9, 3.9084376210277557`*^9}, {
   3.9084489219734983`*^9, 3.9084489310325003`*^9}, {3.908449220737805*^9, 
   3.9084492220920377`*^9}, {3.910863712359373*^9, 3.9108637304734235`*^9}},
 CellLabel->
  "In[182]:=",ExpressionUUID->"6bf20612-0072-44a9-a70f-1248a49d8ef2"],

Cell[BoxData[
 RowBox[{"1", "+", 
  RowBox[{"z", " ", 
   RowBox[{"qrrc", "[", 
    RowBox[{"i", ",", "1"}], "]"}]}], "+", 
  RowBox[{
   SuperscriptBox["z", "2"], " ", 
   RowBox[{"qrrc", "[", 
    RowBox[{"i", ",", "2"}], "]"}]}], "+", 
  RowBox[{
   SuperscriptBox["z", "3"], " ", 
   RowBox[{"qrrc", "[", 
    RowBox[{"i", ",", "3"}], "]"}]}]}]], "Output",
 CellChangeTimes->{
  3.905579146663523*^9, 3.9055797570862265`*^9, 3.905591216150779*^9, 
   3.9059336153177347`*^9, 3.9066921693177543`*^9, 3.906733361227293*^9, 
   3.907035317476206*^9, 3.9072911945793877`*^9, 3.907464859377349*^9, 
   3.9077417012825446`*^9, 3.9078185053773212`*^9, 3.9083382141060915`*^9, 
   3.908342330102256*^9, 3.90834351059385*^9, 3.908428028180614*^9, {
   3.908437584180925*^9, 3.908437621406985*^9}, 3.9084380616370497`*^9, 
   3.9084483347272396`*^9, {3.908448926389964*^9, 3.9084489444871273`*^9}, {
   3.908449210748685*^9, 3.90844922647556*^9}, 3.9085108386152*^9, 
   3.910342438283516*^9, 3.910342649925765*^9, 3.9104496232006955`*^9, 
   3.910493575642705*^9, 3.910765521730854*^9, 3.910845150122337*^9, 
   3.9108635246256747`*^9, 3.9108637540328326`*^9, 3.910876208553606*^9, 
   3.9197435008244405`*^9, 3.9792065425319986`*^9},
 CellLabel->
  "Out[182]=",ExpressionUUID->"d86b5ae8-7808-45d3-b70f-2f9e45746f45"]
}, Open  ]],

Cell[BoxData[
 RowBox[{
  RowBox[{"w", "[", 
   RowBox[{"i_", ",", "j_"}], "]"}], ":=", 
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"j", "<", "3"}], ",", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"i", " ", "!=", " ", "j"}], ",", " ", 
      RowBox[{
       RowBox[{"\[Alpha]", "[", "j", "]"}], "-", 
       RowBox[{"\[Alpha]", "[", "i", "]"}]}], ",", " ", 
      RowBox[{"3", " ", 
       RowBox[{"\[Alpha]", "[", "i", "]"}]}]}], "]"}], ",", 
    RowBox[{"-", 
     RowBox[{"\[Epsilon]", "[", 
      RowBox[{"j", "-", "2"}], "]"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.904810018113906*^9, 3.9048100892603416`*^9}, 
   3.9096823893853884`*^9, {3.909744499493575*^9, 3.909744502424508*^9}},
 CellLabel->
  "In[183]:=",ExpressionUUID->"21b2ff0c-5999-464b-8fe5-1469617bdf22"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Qrrc", "[", 
   RowBox[{"i_", ",", "k_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"-", 
      RowBox[{"BernoulliB", "[", 
       RowBox[{
        RowBox[{"2", "k"}], "+", "2"}], "]"}]}], "/", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"2", "k"}], "+", "2"}], ")"}]}], "/", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"2", "k"}], "+", "1"}], ")"}]}], 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{"1", "/", 
      RowBox[{
       RowBox[{"w", "[", 
        RowBox[{"i", ",", "j"}], "]"}], "^", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"2", "k"}], "+", "1"}], ")"}]}]}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "0", ",", "4"}], "}"}]}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.904809887204789*^9, 3.904809970672654*^9}, {
   3.904810100289504*^9, 3.9048101354198685`*^9}, {3.904810660846523*^9, 
   3.9048106638753185`*^9}, {3.906691878062636*^9, 3.906691878126292*^9}, 
   3.908338261899887*^9, 3.9085344987669554`*^9, {3.908534560577753*^9, 
   3.9085345833574567`*^9}, 3.9096690491454153`*^9, {3.9098987980463343`*^9, 
   3.909898798480138*^9}, 3.9103442567105713`*^9, 3.9103443197135105`*^9, 
   3.9103450343154984`*^9, 3.9103451217818584`*^9, 3.920098411549912*^9, 
   3.9792209746816688`*^9},ExpressionUUID->"61186237-305b-497c-a919-\
82bd8b446586"],

Cell["\<\
The R-matrix applied to the identity, in minimal form, is then:\
\>", "Text",
 CellChangeTimes->{{3.911409902731063*^9, 
  3.911409936558587*^9}},ExpressionUUID->"55e3a893-6436-4b29-84f8-\
04fd21762ec6"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"PP", "[", 
     RowBox[{"0", ",", "i_"}], "]"}], "[", "z_", "]"}], "=", 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"LLpowred", "[", 
       RowBox[{
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"Coefficient", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"PPunnorm", "[", 
                RowBox[{"0", ",", "i"}], "]"}], "[", "z", "]"}], ",", "z", 
              ",", "k"}], "]"}], 
            RowBox[{"Coefficient", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"ff", "[", "i", "]"}], "[", "z", "]"}], ",", "z", ",", 
              "m"}], "]"}], " ", 
            RowBox[{"Coefficient", "[", 
             RowBox[{
              RowBox[{"normLR", "[", 
               RowBox[{"i", ",", "z"}], "]"}], ",", "z", ",", 
              RowBox[{"l", "-", "k", "-", "m"}]}], "]"}], "  ", 
            RowBox[{"z", "^", "l"}]}], "/.", "replnormI"}], ",", 
          RowBox[{"{", 
           RowBox[{"k", ",", "0", ",", "l"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"m", ",", "0", ",", "l"}], "}"}]}], "]"}], ",", 
        RowBox[{
         RowBox[{"LLL", "[", "i", "]"}], "[", "y", "]"}]}], "]"}], "//", 
      "Simplify"}], ",", 
     RowBox[{"{", 
      RowBox[{"l", ",", "0", ",", "ZMAX"}], "}"}]}], "]"}]}], ";"}]], "Input",\

 CellChangeTimes->{{3.910342266018207*^9, 3.910342293856865*^9}, {
   3.910342344454565*^9, 3.9103423472439313`*^9}, {3.910845558484949*^9, 
   3.9108456116471868`*^9}, {3.9108457609049206`*^9, 
   3.9108458001303115`*^9}, {3.9108484652255936`*^9, 
   3.9108484892087965`*^9}, {3.9108485319826636`*^9, 3.91084853343148*^9}, 
   3.9108518492085004`*^9, {3.9108637622706175`*^9, 3.9108637712527504`*^9}},
 CellLabel->
  "In[185]:=",ExpressionUUID->"0fc8733e-4745-41da-932d-de05bf915a21"],

Cell[TextData[{
 "I will want to restrict to the fibrewise choice \[Alpha][i]=(\[Epsilon][1]+\
\[Epsilon][2])/3 of weights now. The tricky bit is that the materialisation \
constants in ff[i][z] are ill-defined in that case. We need to take that as \
some sort of limit from the case of isolated fixed points ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Alpha]", "i"], "!=", 
    SubscriptBox["\[Alpha]", "j"]}], TraditionalForm]],ExpressionUUID->
  "fc9a41e7-e13e-4a05-848f-1f8872887d89"],
 ", and *importantly*, we need to do it without leaving the quartic ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     SubscriptBox["e", "2"], "2"], "=", 
    RowBox[{"3", " ", 
     SubscriptBox["e", "1"], 
     SubscriptBox["e", "3"]}]}], TraditionalForm]],ExpressionUUID->
  "c2f05249-d40f-429e-abbc-77b85d9df3fc"],
 " in the weight space as that constraint has been imposed while solving the \
Picard--Fuchs equations (e.g., ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Alpha]", "i"], "="}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b5272c9c-9eb5-405e-8797-0b3ee869ac76"],
 "(\[Epsilon][1]+\[Epsilon][2])/3 + ",
 StyleBox["i",
  FontSlant->"Italic"],
 " ",
 "\[Delta] doesn\[CloseCurlyQuote]t work). It turns out that choosing ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Alpha]", "i"], "="}], TraditionalForm]],ExpressionUUID->
  "be522141-3044-47b7-8220-1e65c21c3bcb"],
 "(\[Epsilon][1]+\[Epsilon][2])/(3(1-",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[Omega]", "i"], TraditionalForm]],ExpressionUUID->
  "68ad7cf0-48ee-4699-bcec-ab65605d8ffb"],
 "\[Delta])) for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Omega]", "=", 
    SuperscriptBox["e", 
     RowBox[{"2", " ", "\[Pi]", " ", 
      RowBox[{"I", "/", "3"}]}]]}], TraditionalForm]],ExpressionUUID->
  "5c87cab7-52d5-4b56-9a1b-9c40c485a24e"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Delta]", "!=", "0"}], TraditionalForm]],ExpressionUUID->
  "b5a9fcf3-018f-49a1-b112-dbf46f364c67"],
 " does the trick:"
}], "Text",
 CellChangeTimes->{{3.9114099583361034`*^9, 3.911410202670255*^9}, 
   3.911410248630891*^9, {3.9114387049595613`*^9, 
   3.911438845507243*^9}},ExpressionUUID->"c5a105af-fbb0-4a3b-9895-\
59bf0c8fadad"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"e\[Alpha]", "[", "2", "]"}], "^", "2"}], "-", 
    RowBox[{"3", 
     RowBox[{"e\[Alpha]", "[", "1", "]"}], 
     RowBox[{"e\[Alpha]", "[", "3", "]"}]}]}], "/.", 
   RowBox[{
    RowBox[{"\[Alpha]", "[", "i_", "]"}], "->", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
