Cell["\<\
The constant part in SS[0,i,k,m]. We normalise SS[0,i,k,0]=qrrc[i,k] (qrrc= \
\[OpenCurlyDoubleQuote]Quantum Riemann Roch constant\[CloseCurlyDoubleQuote] \
term).\
\>", "Text",
 CellChangeTimes->{{3.9041929738263097`*^9, 3.9041929794311495`*^9}, {
  3.904193083190825*^9, 
  3.904193113333512*^9}},ExpressionUUID->"5c6b3ff9-b2d9-42eb-9c64-\
59a25258599b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Do", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"v", "[", "i", "]"}], "=", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"-", 
          RowBox[{"Flatten", "[", 
           RowBox[{"eq", "[", "i", "]"}], "]"}]}], "/.", 
         RowBox[{
          RowBox[{"SS", "[", 
           RowBox[{"0", ",", "l_", ",", "k_", ",", "0"}], "]"}], "->", 
          RowBox[{"qrrc", "[", 
           RowBox[{"l", ",", "k"}], "]"}]}]}], "/.", 
        RowBox[{
         RowBox[{"SS", "[", 
          RowBox[{"0", ",", "l_", ",", "k_", ",", "m_"}], "]"}], "->", 
         "0"}]}], "//", "Simplify"}]}], ";"}], ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "0", ",", "2"}], "}"}]}], "]"}], ";"}]], "Input",
 CellChangeTimes->{{3.9030626031009336`*^9, 3.9030626198744297`*^9}, {
   3.9030638407692537`*^9, 3.903063874431322*^9}, 3.9030694241332984`*^9, {
   3.9030873389868193`*^9, 3.903087379879977*^9}, 3.903088837256239*^9, {
   3.9042095819851136`*^9, 3.9042095992165484`*^9}, 3.904212580194752*^9},
 CellLabel->
  "In[131]:=",ExpressionUUID->"f10dc569-a43a-4a0c-afa7-2614ab5038a1"],

Cell["The matrix of coefficients of SS[0, i, k, m]", "Text",
 CellChangeTimes->{{3.904192981166819*^9, 
  3.9041929947891645`*^9}},ExpressionUUID->"a1e00435-5843-4ed2-8acb-\
097ba5ac5b0a"],

Cell[BoxData[
 RowBox[{"Do", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"mm", "[", "i", "]"}], "=", 
     RowBox[{
      RowBox[{"Block", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"eqq", "=", 
          RowBox[{"Flatten", "[", 
           RowBox[{"eq", "[", "i", "]"}], "]"}]}], "}"}], ",", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"Flatten", "[", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"D", "[", 
              RowBox[{
               RowBox[{"eqq", "[", 
                RowBox[{"[", "n", "]"}], "]"}], ",", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"SS", "[", 
                  RowBox[{"0", ",", "i", ",", "k", ",", "m"}], "]"}], ",", 
                 "1"}], "}"}]}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"k", ",", "0", ",", "DMAX"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"m", ",", "1", ",", "DMAX"}], "}"}]}], "]"}], "]"}], 
          ",", 
          RowBox[{"{", 
           RowBox[{"n", ",", "1", ",", 
            RowBox[{"Length", "[", "eqq", "]"}]}], "}"}]}], "]"}]}], "]"}], "//",
       "Simplify"}]}], ";"}], ",", 
   RowBox[{"{", 
    RowBox[{"i", ",", "0", ",", "2"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.903063902105552*^9, 3.9030639794219704`*^9}, 
   3.9030694274513307`*^9, {3.9030873865812745`*^9, 3.903087427403867*^9}, {
   3.9030877301142764`*^9, 3.9030877307745366`*^9}},
 CellLabel->
  "In[132]:=",ExpressionUUID->"bd4def84-a947-4c0f-9b56-958faec71d8e"],

Cell["Solving for SS[0,i,k,m].", "Text",
 CellChangeTimes->{{3.9041930401576405`*^9, 
  3.904193052155443*^9}},ExpressionUUID->"8420d34a-aa13-42bb-97d3-\
8f28b0ce57d7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Do", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"solSS", "[", "i", "]"}], "=", 
      RowBox[{"LinearSolve", "[", 
       RowBox[{
        RowBox[{"mm", "[", "i", "]"}], ",", 
        RowBox[{"v", "[", "i", "]"}]}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "0", ",", "2"}], "}"}]}], "]"}], ";"}], "//", 
  "AbsoluteTiming"}]], "Input",
