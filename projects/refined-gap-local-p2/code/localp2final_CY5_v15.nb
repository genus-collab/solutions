      RowBox[{"-", 
       RowBox[{"\[Alpha]", "[", "0", "]"}]}], "+", 
      RowBox[{"y", " ", 
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"\[Mu]psol", "[", 
          RowBox[{"0", ",", "y"}], "]"}], ",", "y"}], "]"}]}]}]}]}], ",", 
   RowBox[{"{", 
    RowBox[{"y", ",", "0", ",", "DMAX"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.902982314214761*^9, 3.9029823160970244`*^9}, {
  3.902982719992897*^9, 3.9029827605245876`*^9}},
 CellLabel->
  "In[126]:=",ExpressionUUID->"593f44c6-11aa-4184-bd28-000d888277e2"],

