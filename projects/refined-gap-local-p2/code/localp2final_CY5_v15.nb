Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"ReplPToCan", "=", 
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"p", "^", "n"}], "\[Rule]", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"-", 
              RowBox[{"\[Alpha]", "[", "0", "]"}]}], ")"}], "^", "n"}], " ", 
           RowBox[{"\[Delta]", "[", "0", "]"}]}], "+", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"-", 
              RowBox[{"\[Alpha]", "[", "2", "]"}]}], ")"}], "^", "n"}], " ", 
           RowBox[{"\[Delta]", "[", "2", "]"}]}], "+", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"-", 
              RowBox[{"\[Alpha]", "[", "1", "]"}]}], ")"}], "^", "n"}], " ", 
           RowBox[{"\[Delta]", "[", "1", "]"}]}]}]}], ",", 
        RowBox[{"{", 
         RowBox[{"n", ",", "1", ",", "2"}], "}"}]}], "]"}], "//", 
      "Simplify"}]}], ";"}], " ", ";", 
   RowBox[{"ReplCanToP", "=", 
    RowBox[{
     RowBox[{
      RowBox[{"Solve", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
