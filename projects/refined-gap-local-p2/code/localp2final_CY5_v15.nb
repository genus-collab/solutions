              RowBox[{"Mod", "[", 
               RowBox[{
                RowBox[{"i", "+", "2"}], ",", "3"}], "]"}], "]"}]}], ")"}]}], 
          "]"}]}], 
        RowBox[{"(", 
         RowBox[{"1", "+", 
          RowBox[{"Sum", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"y", "^", "m"}], " ", 
             RowBox[{"SS", "[", 
              RowBox[{"0", ",", "i", ",", "0", ",", "m"}], "]"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"m", ",", "1", ",", "DMAX"}], "}"}]}], "]"}]}], ")"}]}], 
       "/.", 
       RowBox[{"SSrepl", "[", 
        RowBox[{"0", ",", "i"}], "]"}]}], "/.", 
      RowBox[{
       RowBox[{"qrrc", "[", 
        RowBox[{"l_", ",", "0"}], "]"}], "->", "1"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "0", ",", "2"}], "}"}]}], "]"}], "//", "Simplify"}], 
