        "\[CapitalDelta]"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"n", ",", 
       RowBox[{"-", "1"}], ",", "DMAX"}], "}"}]}], "]"}], "+", 
   RowBox[{
    RowBox[{"O", "[", "\[CapitalDelta]", "]"}], "^", 
    RowBox[{"(", 
