Notebook[{
Cell["Local P2 x C2: minimal genus <= 2 pipeline", "Title"],

Cell["\<\
Equivariant Gromov-Witten free energies F03, F04, F05 (genus 0, 3-5 points), \
F11 (genus 1) and F20 (genus 2) of K_P2 x C^2, extracted as the strict \
dependency chain from localp2final_CY5_v15.nb (the R-matrix coefficients cPP \
and the cyclic-projection table moncycproj are carried over as precomputed \
data; their derivations live in v15). Requires the sidecar file moncycproj.mx \
in the same directory. Evaluate linearly top to bottom. Approximate timings \
on the original machine: F03/F11 seconds-to-minutes, gr04[3] ~12 min, several \
gr05/gr20 terms take tens of minutes each (gr20 total is hours-scale).\
\>", "Text"],

Cell["Setup", "Section"],

Cell["Degree cutoff of the instanton expansion.", "Text"],

Cell[BoxData[
 RowBox[{
  RowBox[{"DMAX", "=", "4"}], ";"}]], "Input"],

Cell["\<\
Replacement for Combinatorica Partitions[n,m] (partitions of n into parts <= \
m), used by ToSymPolLL below. v15 loaded the deprecated Combinatorica package \
for this single function.\
\>", "Text"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Partitions", "[", 
   RowBox[{"n_Integer", ",", "m_Integer"}], "]"}], ":=", 
  RowBox[{"IntegerPartitions", "[", 
   RowBox[{"n", ",", "\[Infinity]", ",", 
    RowBox[{"Range", "[", "m", "]"}]}], "]"}]}]], "Input"],

Cell["\<\
Chiral ring relation (p+a0)(p+a1)(p+a2)=0 for the torus weights a_i on P2, \
and the topological metric in terms of the elementary symmetric polynomials \
ee[i] of the weights; eps[1], eps[2] are the weights on the C^2 factor.\
\>", "Text"],

Cell[BoxData[
 RowBox[{"Replp3", "=", 
  RowBox[{
   RowBox[{"-", 
    RowBox[{"Expand", "[", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"p", "+", 
        RowBox[{"\[Alpha]", "[", "0", "]"}]}], ")"}], 
      RowBox[{"(", 
       RowBox[{"p", "+", 
        RowBox[{"\[Alpha]", "[", "1", "]"}]}], ")"}], 
      RowBox[{"(", 
       RowBox[{"p", "+", 
        RowBox[{"\[Alpha]", "[", "2", "]"}]}], ")"}]}], "]"}]}], "+", 
   RowBox[{"p", "^", "3"}]}]}]], "Input"],

Cell[BoxData[
 TagBox[
  RowBox[{"\[Eta]", "=", 
   RowBox[{"-", 
    RowBox[{"(", "\[NoBreak]", GridBox[{
       {
        RowBox[{"-", 
         FractionBox["1", 
          RowBox[{"3", " ", 
           RowBox[{"ee", "[", "3", "]"}], " ", 
           RowBox[{"\[Epsilon]", "[", "1", "]"}], " ", 
           RowBox[{"\[Epsilon]", "[", "2", "]"}]}]]}], "0", "0"},
       {"0", "0", 
        FractionBox["1", 
         RowBox[{"3", " ", 
          RowBox[{"\[Epsilon]", "[", "1", "]"}], " ", 
          RowBox[{"\[Epsilon]", "[", "2", "]"}]}]]},
       {"0", 
        FractionBox["1", 
         RowBox[{"3", " ", 
          RowBox[{"\[Epsilon]", "[", "1", "]"}], " ", 
          RowBox[{"\[Epsilon]", "[", "2", "]"}]}]], 
        FractionBox[
         RowBox[{"-", 
          RowBox[{"ee", "[", "1", "]"}]}], 
         RowBox[{"3", " ", 
          RowBox[{"\[Epsilon]", "[", "1", "]"}], " ", 
          RowBox[{"\[Epsilon]", "[", "2", "]"}]}]]}
      },
      GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
      GridBoxSpacings->{"Columns" -> {
          Offset[0.27999999999999997`], {
           Offset[0.7]}, 
          Offset[0.27999999999999997`]}, "Rows" -> {
          Offset[0.2], {
           Offset[0.4]}, 
          Offset[0.2]}}], "\[NoBreak]", ")"}]}]}],
  Function[BoxForm`e$, 
   MatrixForm[BoxForm`e$]]]], "Input"],

Cell[BoxData[
 RowBox[{
  RowBox[{"e\[Alpha]", "[", "i_", "]"}], ":=", 
  RowBox[{"SymmetricPolynomial", "[", 
   RowBox[{"i", ",", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"\[Alpha]", "[", "j", "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"j", ",", "0", ",", "2"}], "}"}]}], "]"}]}], "]"}]}]], "Input"],

Cell[BoxData[
 RowBox[{"$Assumptions", "=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"z", ">", "0"}], ",", " ", 
    RowBox[{"d", "\[Element]", "Integers"}], ",", " ", 
    RowBox[{"d", ">=", "0"}]}], "}"}]}]], "Input"],

Cell["The large-radius I-function and mirror map", "Section"],

Cell["\<\
Equivariant I-function of K_P2 (x C^2), its p^k z^-n coefficients II[k,n], \
the mirror map derivative C1 (closed hypergeometric form), L, and the inverse \
mirror map invmm.\
\>", "Text"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ISummand", "[", 
   RowBox[{"d_", ",", "z_"}], "]"}], "=", 
  RowBox[{"z", " ", 
   RowBox[{"Product", "[", 
    RowBox[{
     RowBox[{"1", "/", 
      RowBox[{"Product", "[", 
       RowBox[{
        RowBox[{"p", "+", 
         RowBox[{"\[Alpha]", "[", "i", "]"}], "+", 
         RowBox[{"m", " ", "z"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"m", ",", "1", ",", "d"}], "}"}]}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "0", ",", "2"}], "}"}]}], "]"}], 
   RowBox[{"Product", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"-", "3"}], "p"}], "-", 
      RowBox[{"m", " ", "z"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"m", ",", "0", ",", 
       RowBox[{
        RowBox[{"3", "d"}], "-", "1"}]}], "}"}]}], "]"}], 
   RowBox[{"y", "^", 
    RowBox[{"(", "d", ")"}]}]}]}]], "Input"],

Cell[BoxData[
 RowBox[{
  RowBox[{"IFun", "[", "y_", "]"}], "=", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"y", "^", 
     RowBox[{"(", 
      RowBox[{"p", "/", "z"}], ")"}]}], 
    RowBox[{"(", 
     RowBox[{"z", "+", 
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{"ISummand", "[", 
         RowBox[{"d", ",", "z"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"d", ",", "1", ",", "\[Infinity]"}], "}"}]}], "]"}]}], 
     ")"}]}], "//", "FullSimplify"}]}]], "Input"],

Cell[BoxData[
 RowBox[{
  RowBox[{"II", "[", 
   RowBox[{"k_", ",", "n_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"Coefficient", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Collect", "[", 
       RowBox[{
        RowBox[{"SeriesCoefficient", "[", 
         RowBox[{
          RowBox[{"Series", "[", 
           RowBox[{
            RowBox[{"IFun", "[", "y", "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"z", ",", "\[Infinity]", ",", "2"}], "}"}]}], "]"}], ",",
           "n"}], "]"}], ",", "p"}], "]"}], "/.", 
      RowBox[{
       RowBox[{"p", "^", "3"}], "->", "Replp3"}]}], ",", "p", ",", "k"}], 
    "]"}], "//", "Simplify"}]}]], "Input"],

Cell[BoxData[
 RowBox[{
  RowBox[{"C1", "[", "y_", "]"}], "=", 
  RowBox[{
   RowBox[{"y", " ", 
    RowBox[{"D", "[", 
     RowBox[{
      RowBox[{"II", "[", 
       RowBox[{"1", ",", "0"}], "]"}], ",", "y"}], "]"}]}], "//", 
   "FullSimplify"}]}]], "Input"],

Cell[BoxData[
 RowBox[{
  RowBox[{"L", "[", "y_", "]"}], ":=", 
  RowBox[{"Power", "[", 
   RowBox[{
    RowBox[{"1", "/", 
     RowBox[{"(", 
      RowBox[{"1", " ", "+", " ", 
       RowBox[{"27", " ", "y"}]}], ")"}]}], ",", 
    RowBox[{"1", "/", "3"}]}], "]"}]}]], "Input"],

Cell[BoxData[
 RowBox[{"invmm", "=", 
  RowBox[{
   RowBox[{
    RowBox[{"Series", "[", 
     RowBox[{
      RowBox[{"Exp", "[", 
       RowBox[{"II", "[", 
        RowBox[{"1", ",", "0"}], "]"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"y", ",", "0", ",", 
        RowBox[{"4", "DMAX"}]}], "}"}]}], "]"}], "/.", 
    RowBox[{"y", "->", "Q"}]}], "//", "InverseSeries"}]}]], "Input"],

Cell["\<\
Zagier-Zinger relations (the only part of the v15 bigrepl needed downstream) \
and the cubic polPF whose roots are the canonical coordinates.\
\>", "Text"],

Cell[BoxData[
 RowBox[{"bigrepl", "=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     RowBox[{"cc2", "[", "y", "]"}], "->", 
     RowBox[{
      RowBox[{
       RowBox[{"ll", "[", "y", "]"}], "^", "3"}], "/", 
      RowBox[{
       RowBox[{"c1", "[", "y", "]"}], "^", "2"}]}]}], ",", 
    RowBox[{
     RowBox[{"dd2", "[", "y", "]"}], "->", 
     RowBox[{
      RowBox[{
       RowBox[{"ee", "[", "1", "]"}], "/", "2"}], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"cc2", "[", "y", "]"}], "-", 
        RowBox[{
         RowBox[{"ll", "[", "y", "]"}], "^", "3"}]}], ")"}]}]}]}], 
   "}"}]}]], "Input"],

Cell[BoxData[
 RowBox[{"polPF", "=", 
  RowBox[{
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"ee", "[", "j", "]"}], " ", 
      RowBox[{"XX", "[", 
       RowBox[{"3", "-", "j"}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "1", ",", "3"}], "}"}]}], "]"}], "+", 
   RowBox[{
    RowBox[{"1", "/", 
     RowBox[{
      RowBox[{"ll", "[", "y", "]"}], "^", "3"}]}], " ", 
    RowBox[{"XX", "[", "3", "]"}]}]}]}]], "Input"],

Cell["Canonical coordinates and Picard-Fuchs reduction machinery", "Section"],

Cell["\<\
Weight restriction as in the paper by Lho; the algebraic relation polPFLdiag \
for the canonical coordinates LLL[i][y] in the fibrewise specialisation \
a_i=(eps1+eps2)/3; reduction of rational functions and derivatives modulo \
that relation.\
\>", "Text"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{
    RowBox[{"ee", "[", "0", "]"}], "=", "1"}], ";", 
   RowBox[{
    RowBox[{"ee", "[", "1", "]"}], "=", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"ee", "[", "2", "]"}], "^", "2"}], "/", "3"}], "/", 
     RowBox[{"ee", "[", "3", "]"}]}]}], ";"}]}]], "Input"],

Cell[BoxData[
 RowBox[{
  RowBox[{"polPFLdiag", "[", 
   RowBox[{"y_", ",", "XX_"}], "]"}], "=", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"polPF", "/.", 
       RowBox[{
        RowBox[{"XX", "[", "i_", "]"}], "->", 
        RowBox[{"XX", "^", "i"}]}]}], "/.", 
      RowBox[{"ll", "->", "L"}]}], "/.", 
     RowBox[{"ee", "->", "e\[Alpha]"}]}], "/.", 
    RowBox[{
     RowBox[{"\[Alpha]", "[", "ll_", "]"}], "->", 
     RowBox[{
      RowBox[{
       RowBox[{"\[Epsilon]", "[", "1", "]"}], "/", "3"}], "+", 
      RowBox[{
       RowBox[{"\[Epsilon]", "[", "2", "]"}], "/", "3"}]}]}]}], "//", 
   "Simplify"}]}]], "Input"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ImplRepl", "[", 
    RowBox[{"x_", ",", "y_"}], "]"}], "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", 
      FractionBox[
       RowBox[{
        SuperscriptBox["P", 
         TagBox[
          RowBox[{"(", 
           RowBox[{"1", ",", "0"}], ")"}],
          Derivative],
         MultilineFunction->None], "[", 
        RowBox[{"x", ",", "y"}], "]"}], 
       RowBox[{
        SuperscriptBox["P", 
         TagBox[
          RowBox[{"(", 
           RowBox[{"0", ",", "1"}], ")"}],
          Derivative],
         MultilineFunction->None], "[", 
        RowBox[{"x", ",", "y"}], "]"}]]}], ",", 
     RowBox[{"-", 
      FractionBox[
       RowBox[{
        RowBox[{
         RowBox[{
          SuperscriptBox["P", 
           TagBox[
            RowBox[{"(", 
             RowBox[{"0", ",", "2"}], ")"}],
            Derivative],
           MultilineFunction->None], "[", 
          RowBox[{"x", ",", "y"}], "]"}], " ", 
         SuperscriptBox[
          RowBox[{
           SuperscriptBox["P", 
            TagBox[
             RowBox[{"(", 
              RowBox[{"1", ",", "0"}], ")"}],
             Derivative],
            MultilineFunction->None], "[", 
           RowBox[{"x", ",", "y"}], "]"}], "2"]}], "-", 
        RowBox[{"2", " ", 
         RowBox[{
          SuperscriptBox["P", 
           TagBox[
            RowBox[{"(", 
             RowBox[{"0", ",", "1"}], ")"}],
            Derivative],
           MultilineFunction->None], "[", 
          RowBox[{"x", ",", "y"}], "]"}], " ", 
         RowBox[{
          SuperscriptBox["P", 
           TagBox[
            RowBox[{"(", 
             RowBox[{"1", ",", "0"}], ")"}],
            Derivative],
           MultilineFunction->None], "[", 
          RowBox[{"x", ",", "y"}], "]"}], " ", 
         RowBox[{
          SuperscriptBox["P", 
           TagBox[
            RowBox[{"(", 
             RowBox[{"1", ",", "1"}], ")"}],
            Derivative],
           MultilineFunction->None], "[", 
          RowBox[{"x", ",", "y"}], "]"}]}], "+", 
        RowBox[{
         SuperscriptBox[
          RowBox[{
           SuperscriptBox["P", 
            TagBox[
             RowBox[{"(", 
              RowBox[{"0", ",", "1"}], ")"}],
             Derivative],
            MultilineFunction->None], "[", 
           RowBox[{"x", ",", "y"}], "]"}], "2"], " ", 
         RowBox[{
          SuperscriptBox["P", 
           TagBox[
            RowBox[{"(", 
             RowBox[{"2", ",", "0"}], ")"}],
            Derivative],
           MultilineFunction->None], "[", 
          RowBox[{"x", ",", "y"}], "]"}]}]}], 
       SuperscriptBox[
        RowBox[{
         SuperscriptBox["P", 
          TagBox[
           RowBox[{"(", 
            RowBox[{"0", ",", "1"}], ")"}],
           Derivative],
          MultilineFunction->None], "[", 
         RowBox[{"x", ",", "y"}], "]"}], "3"]]}], ",", 
     RowBox[{
      FractionBox["1", 
       SuperscriptBox[
        RowBox[{
         SuperscriptBox["P", 
          TagBox[
           RowBox[{"(", 
            RowBox[{"0", ",", "1"}], ")"}],
           Derivative],
          MultilineFunction->None], "[", 
         RowBox[{"x", ",", "y"}], "]"}], "5"]], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "3"}], " ", 
         SuperscriptBox[
          RowBox[{
           SuperscriptBox["P", 
            TagBox[
             RowBox[{"(", 
              RowBox[{"0", ",", "2"}], ")"}],
             Derivative],
            MultilineFunction->None], "[", 
           RowBox[{"x", ",", "y"}], "]"}], "2"], " ", 
         SuperscriptBox[
          RowBox[{
           SuperscriptBox["P", 
            TagBox[
             RowBox[{"(", 
              RowBox[{"1", ",", "0"}], ")"}],
             Derivative],
            MultilineFunction->None], "[", 
           RowBox[{"x", ",", "y"}], "]"}], "3"]}], "-", 
        RowBox[{"3", " ", 
         RowBox[{
          SuperscriptBox["P", 
           TagBox[
            RowBox[{"(", 
             RowBox[{"0", ",", "1"}], ")"}],
            Derivative],
           MultilineFunction->None], "[", 
          RowBox[{"x", ",", "y"}], "]"}], " ", 
         RowBox[{
          SuperscriptBox["P", 
           TagBox[
            RowBox[{"(", 
             RowBox[{"0", ",", "2"}], ")"}],
            Derivative],
           MultilineFunction->None], "[", 
          RowBox[{"x", ",", "y"}], "]"}], " ", 
         RowBox[{
