       RowBox[{"LLL", "[", "1", "]"}], "[", "y", "]"}]}], "]"}]}], ";"}], 
  "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"AbsoluteTiming", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"EdgeTerm", "[", 
     RowBox[{"0", ",", "0", ",", "1", ",", "1"}], "]"}], "=", 
    RowBox[{"LLpowreddiag", "[", 
     RowBox[{
      RowBox[{"EdgeTerm", "[", 
       RowBox[{"0", ",", "0", ",", "1", ",", "1"}], "]"}], ",", 
      RowBox[{
       RowBox[{"LLL", "[", "0", "]"}], "[", "y", "]"}]}], "]"}]}], ";"}], 
