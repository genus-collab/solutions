Cell[BoxData[
 RowBox[{
  RowBox[{"LLpowreddiag", "[", 
   RowBox[{"exp_", ",", "var_"}], "]"}], ":=", 
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"temp", "=", 
      RowBox[{"exp", "//", "Together"}]}], "}"}], ",", 
    RowBox[{
     RowBox[{
      RowBox[{"Collect", "[", 
       RowBox[{
        RowBox[{"PolynomialRemainder", "[", 
         RowBox[{
          RowBox[{"Numerator", "[", "temp", "]"}], ",", 
          RowBox[{"polPFLdiag", "[", 
           RowBox[{"y", ",", "var"}], "]"}], ",", "var"}], "]"}], ",", 
        "var"}], "]"}], "/", 
      RowBox[{"Collect", "[", 
       RowBox[{
        RowBox[{"PolynomialRemainder", "[", 
         RowBox[{
          RowBox[{"Denominator", "[", "temp", "]"}], ",", 
          RowBox[{"polPFLdiag", "[", 
           RowBox[{"y", ",", "var"}], "]"}], ",", "var"}], "]"}], ",", 
        "var"}], "]"}]}], "//", "Factor"}]}], "]"}]}]], "Input"],

Cell[BoxData[
 RowBox[{
  RowBox[{"LLDerrepldiag", "=", 
   RowBox[{
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        SuperscriptBox[
         RowBox[{"LLL", "[", "i_", "]"}], 
         TagBox[
          RowBox[{"(", "l", ")"}],
          Derivative],
         MultilineFunction->None], "[", "y", "]"}], "->", 
       RowBox[{"LLpowreddiag", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"ImplRepl", "[", 
             RowBox[{"y", ",", 
              RowBox[{
               RowBox[{"LLL", "[", "i", "]"}], "[", "y", "]"}]}], "]"}], "/.", 
            RowBox[{"P", "->", "polPFLdiag"}]}], ")"}], "[", 
          RowBox[{"[", "l", "]"}], "]"}], ",", 
         RowBox[{
          RowBox[{"LLL", "[", "i", "]"}], "[", "y", "]"}]}], "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"l", ",", "1", ",", "3"}], "}"}]}], "]"}], "//", 
    "Simplify"}]}], ";"}]], "Input"],

Cell["Cut-off in the z-expansion.", "Text"],

Cell[BoxData[
 RowBox[{"ZMAX", "=", "3"}]], "Input"],

Cell["The R-matrix", "Section"],

Cell["\<\
Closed forms of the R-matrix coefficients cPP[0,i][k] in the fibrewise limit, \
as derived in v15 (PF asymptotics + quantum Riemann-Roch normalisation + the \
delta->0 limit of the weight materialisation). The remaining rows \
PPdiag[1,.], PPdiag[2,.] follow from the flatness recursion; c1, c2, d2 are \
inert symbols at this stage.\
\>", "Text"],

