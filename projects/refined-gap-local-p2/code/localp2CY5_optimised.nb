                    RowBox[{"(", 
                    RowBox[{"1", ",", "1"}], ")"}],
                    Derivative],
                    MultilineFunction->None], "[", 
                    RowBox[{"x", ",", "y"}], "]"}], "2"]}], "-", 
                 RowBox[{"3", " ", 
                  RowBox[{
                   SuperscriptBox["P", 
