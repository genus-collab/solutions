Cell["\<\
F20 in minimal form (XX = y c1p/c1, y in terms of LL), and its instanton \
expansion in the flat coordinate.\
\>", "Text"],

Cell[BoxData[
 RowBox[{"F20red", "=", 
  RowBox[{"Collect", "[", 
   RowBox[{
    RowBox[{"Expand", "[", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         FractionBox["F20", 
          RowBox[{
           RowBox[{"\[Epsilon]", "[", "1", "]"}], " ", 
           RowBox[{"\[Epsilon]", "[", "2", "]"}]}]], "/.", "\[VeryThinSpace]", 
         RowBox[{
          RowBox[{
           SuperscriptBox["c1", "\[Prime]",
            MultilineFunction->None], "[", "y", "]"}], "\[Rule]", 
          FractionBox[
           RowBox[{"XX", " ", 
            RowBox[{"c1", "[", "y", "]"}]}], "y"]}]}], "/.", 
        "\[VeryThinSpace]", 
        RowBox[{"y", "\[Rule]", 
         FractionBox[
          RowBox[{"1", "-", 
           SuperscriptBox["LL", "3"]}], 
          RowBox[{"27", " ", 
           SuperscriptBox["LL", "3"]}]]}]}], ",", 
       RowBox[{"LL", ">", "0"}]}], "]"}], "]"}], ",", "XX"}], 
   "]"}]}]], "Input"],

Cell[BoxData[
 RowBox[{"replxy", "=", 
  RowBox[{"First", "[", 
   RowBox[{"Solve", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"xx", "\[Equal]", 
        RowBox[{
         RowBox[{"\[Epsilon]", "[", "1", "]"}], "+", 
         RowBox[{"\[Epsilon]", "[", "2", "]"}]}]}], ",", 
       RowBox[{"yy", "\[Equal]", 
        RowBox[{
         RowBox[{"\[Epsilon]", "[", "1", "]"}], " ", 
         RowBox[{"\[Epsilon]", "[", "2", "]"}]}]}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\[Epsilon]", "[", "1", "]"}], ",", 
       RowBox[{"\[Epsilon]", "[", "2", "]"}]}], "}"}]}], "]"}], 
   "]"}]}]], "Input"],

Cell[BoxData[
 RowBox[{"F20xy", "=", 
  RowBox[{"Series", "[", 
   RowBox[{
    RowBox[{"F20", "/.", "\[VeryThinSpace]", "replxy"}], ",", 
    RowBox[{"{", 
     RowBox[{"xx", ",", "0", ",", "8"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"yy", ",", "0", ",", "5"}], "}"}]}], "]"}]}]], "Input"],

Cell[BoxData[
 RowBox[{"F20Q", "=", 
  RowBox[{"Simplify", "[", 
   RowBox[{
    RowBox[{"Simplify", "[", 
     RowBox[{"Series", "[", 
      RowBox[{
       RowBox[{"F20xy", "/.", "\[VeryThinSpace]", 
        RowBox[{"c1", "\[Rule]", "C1"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"y", ",", "0", ",", 
         RowBox[{"2", " ", "DMAX"}]}], "}"}]}], "]"}], "]"}], "/.", 
    "\[VeryThinSpace]", 
    RowBox[{"y", "\[Rule]", "invmm"}]}], "]"}]}]], "Input"]
},
