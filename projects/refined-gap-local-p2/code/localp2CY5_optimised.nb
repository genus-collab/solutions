Cell[BoxData[
 RowBox[{"AbsoluteTiming", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"EdgeTerm", "[", 
     RowBox[{"0", ",", "1", ",", "1", ",", "1"}], "]"}], "=", 
    RowBox[{"LLpowreddiag", "[", 
     RowBox[{
      RowBox[{"LLpowreddiag", "[", 
       RowBox[{
        RowBox[{"EdgeTerm", "[", 
         RowBox[{"0", ",", "1", ",", "1", ",", "1"}], "]"}], ",", 
        RowBox[{
         RowBox[{"LLL", "[", "0", "]"}], "[", "y", "]"}]}], "]"}], ",", 
      RowBox[{
       RowBox[{"LLL", "[", "1", "]"}], "[", "y", "]"}]}], "]"}]}], ";"}], 
  "]"}]], "Input"],

Cell["Square-lengths of the quantum idempotents.", "Text"],

Cell[BoxData[
 RowBox[{
  RowBox[{"sqrt\[CapitalDelta]", "[", "i_", "]"}], "=", 
  RowBox[{
   RowBox[{
    RowBox[{"Sqrt", "[", "  ", 
     RowBox[{
      RowBox[{"\[Epsilon]", "[", "1", "]"}], " ", 
      RowBox[{
       RowBox[{"\[Epsilon]", "[", "2", "]"}], "/", 
       RowBox[{"ee", "[", "3", "]"}]}]}], "]"}], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"3", " ", 
       RowBox[{"ee", "[", "3", "]"}]}], "+", 
      RowBox[{
       RowBox[{"ee", "[", "2", "]"}], " ", 
       RowBox[{
        RowBox[{"LLL", "[", "i", "]"}], "[", "y", "]"}]}]}], ")"}]}], "//", 
   "Simplify"}]}]], "Input"],

Cell["Cyclic symmetrisation", "Section"],

Cell["\<\
ToSymPolLL rewrites a cyclically symmetric polynomial in the LLL[i][y] as an \
explicit function of y (the odd generator o = 3 Sqrt[3] I y \
(eps1+eps2)^3/(1+27y)^2 is hardcoded in its output). CyclicQuotOpt is the \
workhorse for graph contributions; moncycproj is its lookup table of cyclic \
projections of LLL-monomials up to total degree MONMAX, loaded from the \
sidecar moncycproj.mx (the commented-out cell regenerates it from scratch). \
WARNING: the degy/degDelta arguments of CyclicQuotOpt are trusted - \
underestimating them silently gives wrong results.\
\>", "Text"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ToSymPolLL", "[", "arg_", "]"}], ":=", 
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"arg", "===", "0"}], ",", "0", ",", "\[IndentingNewLine]", 
    RowBox[{"Block", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"argint", "=", "arg"}], ",", "par", ",", "exp", ",", "pol", 
        ",", "sol", ",", " ", "out", ",", "parodd", ",", "odd"}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"*", 
         RowBox[{"Do", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"Exponent", "[", 
                RowBox[{"argint", ",", 
                 RowBox[{
                  RowBox[{"LLL", "[", "ii", "]"}], "[", "y", "]"}]}], "]"}], 
               ">", "2"}], ",", 
              RowBox[{"argint", "=", 
               RowBox[{"LLpowreddiag", "[", 
                RowBox[{"argint", ",", 
                 RowBox[{
                  RowBox[{"LLL", "[", "ii", "]"}], "[", "y", "]"}]}], 
                "]"}]}]}], "]"}], ";"}], ",", 
           RowBox[{"{", 
            RowBox[{"ii", ",", "0", ",", "2"}], "}"}]}], "]"}]}], ";"}], 
       "**)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"exp", "=", 
        RowBox[{
         RowBox[{"Length", "[", 
          RowBox[{"CoefficientList", "[", 
           RowBox[{"argint", ",", 
            RowBox[{
             RowBox[{"LLL", "[", "0", "]"}], "[", "y", "]"}]}], "]"}], "]"}], 
         "-", "1"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"par", "=", 
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{"Flatten", "[", 
           RowBox[{
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"Partitions", "[", 
               RowBox[{"k", ",", "3"}], "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"k", ",", "0", ",", 
                RowBox[{"3", " ", "exp"}]}], "}"}]}], "]"}], ",", "1"}], 
           "]"}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"Length", "[", "#", "]"}], "<=", "exp"}], "&"}]}], 
         "]"}]}], ";", " ", "\[IndentingNewLine]", 
       RowBox[{"parodd", "=", 
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{"Flatten", "[", 
           RowBox[{
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"Partitions", "[", 
               RowBox[{"k", ",", "3"}], "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"k", ",", "0", ",", 
                RowBox[{"3", " ", 
                 RowBox[{"(", 
                  RowBox[{"exp", "-", "1"}], ")"}]}]}], "}"}]}], "]"}], ",", 
            "1"}], "]"}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"Length", "[", "#", "]"}], "<=", 
            RowBox[{"exp", "-", "2"}]}], "&"}]}], "]"}]}], ";", " ", 
       "\[IndentingNewLine]", 
       RowBox[{"odd", "=", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"LLL", "[", "0", "]"}], "[", "y", "]"}], "-", 
           RowBox[{
            RowBox[{"LLL", "[", "1", "]"}], "[", "y", "]"}]}], ")"}], 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"LLL", "[", "0", "]"}], "[", "y", "]"}], "-", 
           RowBox[{
            RowBox[{"LLL", "[", "2", "]"}], "[", "y", "]"}]}], ")"}], 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"LLL", "[", "1", "]"}], "[", "y", "]"}], "-", 
           RowBox[{
            RowBox[{"LLL", "[", "2", "]"}], "[", "y", "]"}]}], ")"}]}]}], ";",
        "\[IndentingNewLine]", 
       RowBox[{"pol", "=", 
        RowBox[{
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"AA", "[", "k", "]"}], 
            RowBox[{"Product", "[", 
             RowBox[{
              RowBox[{"SymmetricPolynomial", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"par", "[", 
                  RowBox[{"[", "k", "]"}], "]"}], "[", 
                 RowBox[{"[", "j", "]"}], "]"}], ",", 
                RowBox[{"Table", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"LLL", "[", "i", "]"}], "[", "y", "]"}], ",", 
                  RowBox[{"{", 
                   RowBox[{"i", ",", "0", ",", "2"}], "}"}]}], "]"}]}], "]"}],
               ",", 
              RowBox[{"{", 
               RowBox[{"j", ",", "1", ",", 
                RowBox[{"Length", "[", 
                 RowBox[{"par", "[", 
                  RowBox[{"[", "k", "]"}], "]"}], "]"}]}], "}"}]}], "]"}]}], 
           ",", 
           RowBox[{"{", 
            RowBox[{"k", ",", "1", ",", 
             RowBox[{"Length", "[", "par", "]"}]}], "}"}]}], "]"}], "+", 
         RowBox[{"odd", " ", 
          RowBox[{"Sum", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"AA", "[", 
              RowBox[{"k", "+", 
               RowBox[{"Length", "[", "par", "]"}]}], "]"}], 
             RowBox[{"Product", "[", 
              RowBox[{
               RowBox[{"SymmetricPolynomial", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"parodd", "[", 
                   RowBox[{"[", "k", "]"}], "]"}], "[", 
                  RowBox[{"[", "j", "]"}], "]"}], ",", 
                 RowBox[{"Table", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"LLL", "[", "i", "]"}], "[", "y", "]"}], ",", 
                   RowBox[{"{", 
                    RowBox[{"i", ",", "0", ",", "2"}], "}"}]}], "]"}]}], 
                "]"}], ",", 
               RowBox[{"{", 
                RowBox[{"j", ",", "1", ",", 
                 RowBox[{"Length", "[", 
                  RowBox[{"parodd", "[", 
                   RowBox[{"[", "k", "]"}], "]"}], "]"}]}], "}"}]}], "]"}]}], 
            ",", 
            RowBox[{"{", 
             RowBox[{"k", ",", "1", ",", 
              RowBox[{"Length", "[", "parodd", "]"}]}], "}"}]}], "]"}]}]}]}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"sol", "=", 
        RowBox[{
         RowBox[{"Solve", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"CoefficientList", "[", 
             RowBox[{
              RowBox[{"argint", "-", "pol"}], ",", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{
                 RowBox[{"LLL", "[", "0", "]"}], "[", "y", "]"}], ",", 
                RowBox[{
                 RowBox[{"LLL", "[", "1", "]"}], "[", "y", "]"}], ",", 
                RowBox[{
                 RowBox[{"LLL", "[", "2", "]"}], "[", "y", "]"}]}], "}"}]}], 
             "]"}], "==", "0"}], ",", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"AA", "[", "k", "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"k", ",", "1", ",", 
               RowBox[{
                RowBox[{"Length", "[", "par", "]"}], "+", 
                RowBox[{"Length", "[", "parodd", "]"}]}]}], "}"}]}], "]"}]}], 
          "]"}], "//", "Flatten"}]}], ";", " ", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"sol", "==", 
          RowBox[{"{", "}"}]}], ",", 
         RowBox[{
          RowBox[{
          "Print", "[", 
           "\"\<Error -- argument is not a cyclically symmetric polynomial in \
each LLL[i][y]\>\"", "]"}], ";", " ", 
          RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
       
       RowBox[{"out", "=", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"Sum", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"AA", "[", "k", "]"}], 
              RowBox[{"Product", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{"-", "1"}], ")"}], "^", 
                  RowBox[{
                   RowBox[{"par", "[", 
                    RowBox[{"[", "k", "]"}], "]"}], "[", 
                   RowBox[{"[", "j", "]"}], "]"}]}], " ", 
                 RowBox[{"e\[Alpha]", "[", 
                  RowBox[{
                   RowBox[{"par", "[", 
                    RowBox[{"[", "k", "]"}], "]"}], "[", 
                   RowBox[{"[", "j", "]"}], "]"}], "]"}], " ", 
                 RowBox[{
                  RowBox[{"L", "[", "y", "]"}], "^", "3"}]}], ",", 
                RowBox[{"{", 
                 RowBox[{"j", ",", "1", ",", 
                  RowBox[{"Length", "[", 
                   RowBox[{"par", "[", 
                    RowBox[{"[", "k", "]"}], "]"}], "]"}]}], "}"}]}], "]"}]}],
              ",", 
             RowBox[{"{", 
              RowBox[{"k", ",", "1", ",", 
               RowBox[{"Length", "[", "par", "]"}]}], "}"}]}], "]"}], "+", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"3", " ", 
              SqrtBox["3"], " ", "I", " ", 
              FractionBox[
               RowBox[{"y", " ", 
                SuperscriptBox[
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"\[Epsilon]", "[", "1", "]"}], "+", 
                   RowBox[{"\[Epsilon]", "[", "2", "]"}]}], ")"}], "3"]}], 
               SuperscriptBox[
                RowBox[{"(", 
                 RowBox[{"1", "+", 
                  RowBox[{"27", " ", "y"}]}], ")"}], "2"]]}], ")"}], 
            RowBox[{"Sum", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"AA", "[", 
                RowBox[{
                 RowBox[{"Length", "[", "par", "]"}], "+", "k"}], "]"}], 
               RowBox[{"Product", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{"-", "1"}], ")"}], "^", 
                   RowBox[{
                    RowBox[{"parodd", "[", 
                    RowBox[{"[", "k", "]"}], "]"}], "[", 
                    RowBox[{"[", "j", "]"}], "]"}]}], " ", 
                  RowBox[{"e\[Alpha]", "[", 
                   RowBox[{
                    RowBox[{"parodd", "[", 
                    RowBox[{"[", "k", "]"}], "]"}], "[", 
                    RowBox[{"[", "j", "]"}], "]"}], "]"}], " ", 
                  RowBox[{
                   RowBox[{"L", "[", "y", "]"}], "^", "3"}]}], ",", 
                 RowBox[{"{", 
                  RowBox[{"j", ",", "1", ",", 
                   RowBox[{"Length", "[", 
                    RowBox[{"parodd", "[", 
                    RowBox[{"[", "k", "]"}], "]"}], "]"}]}], "}"}]}], "]"}]}],
               ",", 
              RowBox[{"{", 
               RowBox[{"k", ",", "1", ",", 
                RowBox[{"Length", "[", "parodd", "]"}]}], "}"}]}], "]"}]}]}], 
          "/.", "sol"}], "//", "Simplify"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"*", 
          RowBox[{"Print", "[", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"AA", "[", "k", "]"}], "/.", "sol"}], ",", 
             RowBox[{"{", 
              RowBox[{"k", ",", "1", ",", 
               RowBox[{
                RowBox[{"Length", "[", "par", "]"}], "+", "1"}]}], "}"}]}], 
            "]"}], "]"}]}], ";"}], "**)"}], "\[IndentingNewLine]", "out"}]}], 
     "\[IndentingNewLine]", "]"}]}], "]"}]}]], "Input"],

Cell[BoxData[
 RowBox[{"MONMAX", "=", "12"}]], "Input"],

Cell[BoxData[
 RowBox[{
  RowBox[{"CyclicProj", "[", "arg_", "]"}], ":=", 
  RowBox[{
   RowBox[{"1", "/", "3"}], " ", 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{"arg", "/.", 
      RowBox[{
       RowBox[{
        RowBox[{"LLL", "[", "ll_", "]"}], "[", "y", "]"}], "->", 
       RowBox[{
        RowBox[{"LLL", "[", 
         RowBox[{"Mod", "[", 
          RowBox[{
           RowBox[{"ll", "+", "kk"}], ",", "3"}], "]"}], "]"}], "[", "y", 
        "]"}]}]}], ",", 
     RowBox[{"{", 
      RowBox[{"kk", ",", "1", ",", "3"}], "}"}]}], " ", "]"}]}]}]], "Input"],

Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{"*", 
   RowBox[{"AbsoluteTiming", "[", 
    RowBox[{
     RowBox[{"moncycproj", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"ToSymPolLL", "[", 
         RowBox[{"CyclicProj", "[", 
          RowBox[{"Product", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"LLL", "[", "i", "]"}], "[", "y", "]"}], "^", 
             RowBox[{"m", "[", "i", "]"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", "0", ",", "2"}], "}"}]}], "]"}], "]"}], "]"}], 
        ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"m", "[", "0", "]"}], ",", "0", ",", "MONMAX"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"m", "[", "1", "]"}], ",", "0", ",", "MONMAX"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"m", "[", "2", "]"}], ",", "0", ",", "MONMAX"}], "}"}]}], 
       "]"}]}], ";"}], "]"}]}], "**)"}]], "Input"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SetDirectory", "[", 
   RowBox[{"NotebookDirectory", "[", "]"}], "]"}], ";", 
  RowBox[{"<<", "\"\<moncycproj.mx\>\""}], ";", 
  RowBox[{"Dimensions", "[", "moncycproj", "]"}]}]], "Input"],

Cell[BoxData[
 RowBox[{
  RowBox[{"CyclicQuotOpt", "[", 
   RowBox[{"arg_", ",", " ", "degy_", ",", "deg\[CapitalDelta]_"}], "]"}], ":=",
   "\[IndentingNewLine]", 
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "num", ",", "den", ",", " ", "denc", ",", "summand", ",", " ", "sum", 
      ",", "degLL"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"num", "=", 
      RowBox[{"Numerator", "[", "arg", "]"}]}], ";", 
     RowBox[{"den", "=", 
      RowBox[{"Denominator", "[", "arg", "]"}]}], ";", "\[IndentingNewLine]", 
     
     RowBox[{"denc", "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Head", "[", "den", "]"}], "==", "Times"}], ",", " ", 
        RowBox[{"Product", "[", 
         RowBox[{
          RowBox[{"ToSymPolLL", "[", 
           RowBox[{"Product", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"den", "[", 
               RowBox[{"[", "m", "]"}], "]"}], " ", "/.", 
              RowBox[{
               RowBox[{"LLL", "[", "ll_", "]"}], "->", 
               RowBox[{"LLL", "[", 
                RowBox[{"Mod", "[", 
                 RowBox[{
                  RowBox[{"ll", "+", "kk"}], ",", "3"}], "]"}], "]"}]}]}], 
             ",", 
             RowBox[{"{", 
              RowBox[{"kk", ",", "0", ",", "2"}], "}"}]}], "]"}], "]"}], ",", 
          
          RowBox[{"{", 
           RowBox[{"m", ",", "1", ",", 
            RowBox[{"Length", "[", "den", "]"}]}], "}"}]}], "]"}], ",", " ", 
        RowBox[{"ToSymPolLL", "[", "den", "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
     "Print", "[", 
      "\"\<Cyclic symmetrisation of the denominator OK. Result: \>\"", "]"}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", "denc", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"summand", "=", 
      RowBox[{"num", " ", 
       RowBox[{"(", 
        RowBox[{"den", "/.", 
         RowBox[{
          RowBox[{
           RowBox[{"LLL", "[", "ll_", "]"}], "[", "y", "]"}], "->", 
          RowBox[{
           RowBox[{"LLL", "[", 
            RowBox[{"Mod", "[", 
             RowBox[{
              RowBox[{"ll", "+", "1"}], ",", "3"}], "]"}], "]"}], "[", "y", 
           "]"}]}]}], ")"}], " ", 
       RowBox[{"(", 
        RowBox[{"den", " ", "/.", 
         RowBox[{
          RowBox[{
           RowBox[{"LLL", "[", "ll_", "]"}], "[", "y", "]"}], "->", 
          RowBox[{
           RowBox[{"LLL", "[", 
            RowBox[{"Mod", "[", 
             RowBox[{
              RowBox[{"ll", "+", "2"}], ",", "3"}], "]"}], "]"}], "[", "y", 
           "]"}]}]}], ")"}]}]}], " ", ";", "\[IndentingNewLine]", 
     RowBox[{"degLL", "=", 
      RowBox[{"Max", "[", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Exponent", "[", 
          RowBox[{"summand", ",", 
           RowBox[{
            RowBox[{"LLL", "[", "i", "]"}], "[", "y", "]"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "0", ",", "2"}], "}"}]}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Max degree in LLL[i] is: \>\"", " ", "<>", 
       RowBox[{"ToString", "[", "degLL", "]"}], " ", "<>", "\"\<.\>\""}], 
      "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"degLL", ">", "MONMAX"}], ",", " ", 
       RowBox[{
        RowBox[{
        "Print", "[", 
         "\"\<Degree exceeds bounds. Try using a higher value for MONMAX. \
Aborting...\>\"", "]"}], ";", " ", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", 
     RowBox[{
     "Print", " ", "[", 
      "\"\<Starting cyclic symmetrisation of the numerator...\>\"", "]"}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"sum", "=", 
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Factor", "[", 
           RowBox[{
            RowBox[{"Factor", "[", 
             RowBox[{"Coefficient", "[", 
              RowBox[{
               RowBox[{"Coefficient", "[", 
                RowBox[{
                 RowBox[{"Coefficient", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"1", "+", 
                    RowBox[{"27", " ", "y"}]}], ")"}], "^", 
                    "deg\[CapitalDelta]"}], " ", 
                    RowBox[{"summand", "/", "denc"}]}], ",", " ", 
                   RowBox[{
                    RowBox[{"LLL", "[", "2", "]"}], "[", "y", "]"}], ",", 
                   RowBox[{"m", "[", "2", "]"}]}], "]"}], ",", 
                 RowBox[{
                  RowBox[{"LLL", "[", "1", "]"}], "[", "y", "]"}], ",", 
                 RowBox[{"m", "[", "1", "]"}]}], "]"}], ",", 
               RowBox[{
                RowBox[{"LLL", "[", "0", "]"}], "[", "y", "]"}], ",", 
               RowBox[{"m", "[", "0", "]"}]}], "]"}], "]"}], " ", 
            RowBox[{"moncycproj", "[", 
             RowBox[{"[", 
              RowBox[{
               RowBox[{
                RowBox[{"m", "[", "0", "]"}], "+", "1"}], ",", 
               RowBox[{
                RowBox[{"m", "[", "1", "]"}], "+", "1"}], ",", 
               RowBox[{
                RowBox[{"m", "[", "2", "]"}], "+", "1"}]}], "]"}], "]"}]}], 
           "]"}], "/.", 
          RowBox[{
           RowBox[{
            RowBox[{"c1", "'"}], "[", "y", "]"}], "->", "cc1p"}]}], "/.", 
         RowBox[{
          RowBox[{"c1", "[", "y", "]"}], "->", "cc1"}]}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"m", "[", "0", "]"}], ",", "0", ",", " ", "degLL"}], "}"}], 
        ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"m", "[", "1", "]"}], ",", "0", ",", "  ", "degLL"}], "}"}],
         ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"m", "[", "2", "]"}], ",", "0", ",", " ", "degLL"}], 
         "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
     "Print", "[", 
      "\"\<Cyclic symmetrisation of the numerator OK. Interpolating...\>\"", 
      "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"InterpolatingPolynomial", "[", 
          RowBox[{
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"sum", "/.", 
              RowBox[{"y", "->", "n"}]}], ",", 
             RowBox[{"{", 
              RowBox[{"n", ",", "1", ",", 
               RowBox[{"degy", "+", "1"}]}], "}"}]}], "]"}], ",", "y"}], 
          "]"}], "/", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", "+", 
            RowBox[{"27", " ", "y"}]}], ")"}], "^", "deg\[CapitalDelta]"}]}], 
        "/.", 
        RowBox[{"cc1", "->", 
         RowBox[{"c1", "[", "y", "]"}]}]}], "/.", 
       RowBox[{"cc1p", "->", 
        RowBox[{
         RowBox[{"c1", "'"}], "[", "y", "]"}]}]}], "  ", "//", "Factor"}]}]}],
    "\[IndentingNewLine]", "]"}]}]], "Input"],

Cell["Free energies: stable graph sums", "Section"],

