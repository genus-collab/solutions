            RowBox[{"-", "3"}], " ", 
            RowBox[{
             SuperscriptBox["P", 
              TagBox[
               RowBox[{"(", 
                RowBox[{"1", ",", "0"}], ")"}],
               Derivative],
              MultilineFunction->None], "[", 
             RowBox[{"x", ",", "y"}], "]"}], " ", 
            RowBox[{
