          RowBox[{"a", ",", "i"}], "]"}], "[", 
         RowBox[{"-", "z"}], "]"}], "/.", 
        RowBox[{
         RowBox[{"d2", "[", "y_", "]"}], "->", 
         RowBox[{
          RowBox[{"ee", "[", "1", "]"}], 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"1", "/", "2"}], " ", 
             RowBox[{"c2", "[", "y", "]"}]}], "-", 
            RowBox[{
             RowBox[{"1", "/", "2"}], 
             RowBox[{
              RowBox[{"L", "[", "y", "]"}], "^", "3"}]}]}], ")"}]}]}]}], "/.", 
       RowBox[{
        RowBox[{"c2", "[", "y", "]"}], "->", 
        RowBox[{
         RowBox[{
          RowBox[{"L", "[", "y", "]"}], "^", "3"}], "/", 
         RowBox[{
          RowBox[{"c1", "[", "y", "]"}], "^", "2"}]}]}]}], ",", "z", ",", 
      "n"}], "]"}]}], ",", 
   RowBox[{"{", 
    RowBox[{"i", ",", "0", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"n", ",", "0", ",", "ZMAX"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"a", ",", "0", ",", "2"}], "}"}]}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Do", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"PreEdgeTerm", "[", 
      RowBox[{"i", ",", "j"}], "]"}], "=", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"(", " ", 
           RowBox[{
            RowBox[{"KroneckerDelta", "[", 
             RowBox[{"i", ",", "j"}], "]"}], "-", 
            RowBox[{"Sum", "[", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"PPdiag", "[", 
                 RowBox[{"a", ",", "i"}], "]"}], "[", 
                RowBox[{"-", "ww"}], "]"}], 
               RowBox[{
                RowBox[{"Inverse", "[", "\[Eta]", "]"}], "[", 
                RowBox[{"[", 
                 RowBox[{
                  RowBox[{"a", "+", "1"}], ",", 
                  RowBox[{"b", "+", "1"}]}], "]"}], "]"}], 
               RowBox[{
                RowBox[{"PPdiag", "[", 
                 RowBox[{"b", ",", "j"}], "]"}], "[", 
                RowBox[{"-", "zz"}], "]"}]}], ",", 
              RowBox[{"{", 
               RowBox[{"a", ",", "0", ",", "2"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"b", ",", "0", ",", "2"}], "}"}]}], "]"}]}], ")"}], "/.", 
          RowBox[{
           RowBox[{"d2", "[", "y_", "]"}], "->", 
           RowBox[{
            RowBox[{"ee", "[", "1", "]"}], 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"1", "/", "2"}], " ", 
               RowBox[{"c2", "[", "y", "]"}]}], "-", 
              RowBox[{
               RowBox[{"1", "/", "2"}], 
               RowBox[{
                RowBox[{"L", "[", "y", "]"}], "^", "3"}]}]}], ")"}]}]}]}], "/.", 
         RowBox[{
          RowBox[{"c2", "[", "y", "]"}], "->", 
          RowBox[{
           RowBox[{
            RowBox[{"L", "[", "y", "]"}], "^", "3"}], "/", 
           RowBox[{
            RowBox[{"c1", "[", "y", "]"}], "^", "2"}]}]}]}], 
        "\[IndentingNewLine]", "//.", "bigrepl"}], " ", "/.", 
       RowBox[{
        RowBox[{"LL", "[", "ll_", "]"}], "->", 
        RowBox[{
         RowBox[{"LLL", "[", "ll", "]"}], "[", "y", "]"}]}]}], "/.", 
      RowBox[{"ll", "->", "L"}]}]}], ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "0", ",", "2"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"j", ",", "0", ",", "2"}], "}"}]}], "]"}], ";"}]], "Input"],

Cell["\<\
Divide id - P(-w)* P(-z) by (z+w) at the level of coefficients. This single \
loop covers all (i, j; m, n) needed below - including (i,j)=(1,1), which v15 \
computed in a session whose loop is not saved in the notebook.\
\>", "Text"],

Cell[BoxData[
 RowBox[{"Do", "[", 
  RowBox[{
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"precoeff", "=", 
       RowBox[{"CoefficientList", "[", 
        RowBox[{
         RowBox[{"PreEdgeTerm", "[", 
          RowBox[{
           RowBox[{
           "ij", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], ",", 
           
           RowBox[{
           "ij", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}], 
          "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"ww", ",", "zz"}], "}"}]}], "]"}]}], "}"}], ",", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"EdgeTerm", "[", 
         RowBox[{
          RowBox[{
          "ij", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], ",", 
          RowBox[{
          "ij", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], ",", 
          RowBox[{
          "mn", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], ",", 
          RowBox[{
          "mn", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}], 
         "]"}], "=", 
        RowBox[{"Together", "[", 
         RowBox[{
          UnderoverscriptBox["\[Sum]", 
           RowBox[{"k", "=", "0"}], 
           RowBox[{
           "mn", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]], 
          RowBox[{
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{"-", "1"}], ")"}], "k"], " ", 
           RowBox[{"precoeff", "\[LeftDoubleBracket]", 
            RowBox[{
             RowBox[{
              RowBox[{
              "mn", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
              "+", "k", "+", "2"}], ",", 
             RowBox[{
              RowBox[{
              "mn", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], 
              "-", "k", "+", "1"}]}], "\[RightDoubleBracket]"}]}]}], "]"}]}], 
       ",", 
       RowBox[{"{", 
        RowBox[{"mn", ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", "0"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"1", ",", "0"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"2", ",", "0"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"0", ",", "1"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"1", ",", "1"}], "}"}]}], "}"}]}], "}"}]}], "]"}]}], 
    "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"ij", ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "1"}], "}"}]}], "}"}]}], "}"}]}], "]"}]], "Input"],

Cell["Representing the terms used below in minimal form.", "Text"],

Cell[BoxData[
 RowBox[{"AbsoluteTiming", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"EdgeTerm", "[", 
     RowBox[{"0", ",", "0", ",", "0", ",", "0"}], "]"}], "=", 
    RowBox[{"LLpowreddiag", "[", 
     RowBox[{
      RowBox[{"EdgeTerm", "[", 
       RowBox[{"0", ",", "0", ",", "0", ",", "0"}], "]"}], ",", 
      RowBox[{
       RowBox[{"LLL", "[", "0", "]"}], "[", "y", "]"}]}], "]"}]}], ";"}], 
  "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"AbsoluteTiming", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"EdgeTerm", "[", 
     RowBox[{"0", ",", "0", ",", "1", ",", "0"}], "]"}], "=", 
    RowBox[{"LLpowreddiag", "[", 
     RowBox[{
      RowBox[{"EdgeTerm", "[", 
       RowBox[{"0", ",", "0", ",", "1", ",", "0"}], "]"}], ",", 
      RowBox[{
       RowBox[{"LLL", "[", "0", "]"}], "[", "y", "]"}]}], "]"}]}], ";"}], 
  "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"AbsoluteTiming", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"EdgeTerm", "[", 
     RowBox[{"0", ",", "0", ",", "2", ",", "0"}], "]"}], "=", 
    RowBox[{"LLpowreddiag", "[", 
     RowBox[{
      RowBox[{"EdgeTerm", "[", 
       RowBox[{"0", ",", "0", ",", "2", ",", "0"}], "]"}], ",", 
      RowBox[{
       RowBox[{"LLL", "[", "0", "]"}], "[", "y", "]"}]}], "]"}]}], ";"}], 
  "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"AbsoluteTiming", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"EdgeTerm", "[", 
     RowBox[{"0", ",", "1", ",", "0", ",", "0"}], "]"}], "=", 
    RowBox[{"LLpowreddiag", "[", 
     RowBox[{
      RowBox[{"LLpowreddiag", "[", 
       RowBox[{
        RowBox[{"EdgeTerm", "[", 
         RowBox[{"0", ",", "1", ",", "0", ",", "0"}], "]"}], ",", 
        RowBox[{
         RowBox[{"LLL", "[", "0", "]"}], "[", "y", "]"}]}], "]"}], ",", 
      RowBox[{
       RowBox[{"LLL", "[", "1", "]"}], "[", "y", "]"}]}], "]"}]}], ";"}], 
  "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"AbsoluteTiming", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"EdgeTerm", "[", 
     RowBox[{"0", ",", "1", ",", "1", ",", "0"}], "]"}], "=", 
    RowBox[{"LLpowreddiag", "[", 
     RowBox[{
      RowBox[{"LLpowreddiag", "[", 
       RowBox[{
        RowBox[{"EdgeTerm", "[", 
         RowBox[{"0", ",", "1", ",", "1", ",", "0"}], "]"}], ",", 
        RowBox[{
         RowBox[{"LLL", "[", "0", "]"}], "[", "y", "]"}]}], "]"}], ",", 
      RowBox[{
       RowBox[{"LLL", "[", "1", "]"}], "[", "y", "]"}]}], "]"}]}], ";"}], 
  "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"AbsoluteTiming", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"EdgeTerm", "[", 
     RowBox[{"1", ",", "1", ",", "0", ",", "0"}], "]"}], "=", 
    RowBox[{"LLpowreddiag", "[", 
     RowBox[{
      RowBox[{"EdgeTerm", "[", 
       RowBox[{"1", ",", "1", ",", "0", ",", "0"}], "]"}], ",", 
