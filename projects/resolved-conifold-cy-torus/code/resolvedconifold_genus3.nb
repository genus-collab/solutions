(* Beginning of Notebook Content *)
Notebook[{
Cell["\<\
Resolved conifold x C2: refined free energies to genus 3 for the general torus\
\>", "Title"],

Cell["\<\
Streamlined successor of resolvedconifold.nb, parallel to \
localp2CY5_genus3.nb. Z = Tot(O(-1)+O(-1) -> P1) x C^2 with the \
five-dimensional torus T_M: alpha0 = tangent weight of P1 at the fixed point \
p = 0, alpha1, alpha2 = weights of the two fibres there, -eps1, -eps2 = \
weights on C^2; normal weights (alpha0, alpha1, alpha2, -eps1, -eps2) at p = \
0 and (-alpha0, alpha0+alpha1, alpha0+alpha2, -eps1, -eps2) at p = -alpha0. \
The Calabi-Yau subtorus is c1 = eps1 + eps2 - alpha0 - alpha1 - alpha2 = 0; \
it is NOT imposed during the computation. Outputs: F11 = Q d/dQ F_1 (one \
divisor insertion, as in the old notebook), F20, F30, as exact rational \
functions of Q and the five weights.\
\>", "Text"],

Cell["\<\
Method. The genus-0 data (Frobenius structure, canonical coordinates as the \
two roots of a quadratic, square lengths Delta_i, mirror superpotential and \
its critical point) are those of the old notebook. The R-matrix identity \
column is the stationary-phase (Wick) expansion of the mirror integral at the \
critical point, normalised by the quantum Riemann-Roch constants over the \
five weights at each fixed point as Q -> 0 (fixed points are isolated for \
generic weights, so no limiting procedure is needed); row 1 follows by \
flatness. All quantities live in the two-dimensional algebra K[U]/(U^2 - S U \
+ P) generated by the critical value U = e^s, K = Q(Q, weights): an element a \
+ b U is stored as C[a, b], the second root is U -> S - U. Because the \
degree-d invariants for d >= 1 are equivariant integrals over the compact \
moduli spaces of maps to the rigid P1, eps1 eps2 [Q^d] F_g is a homogeneous \
polynomial of degree 2g in the weights, and F_g - F_g(Q = 0) = N_g(Q, \
weights)/((1-Q)^a eps1 eps2) with N_g polynomial in Q. The graph sum (same \
enumeration and weight conventions as for local P2, two colours) is therefore \
evaluated exactly at integer weight samples and rational Q samples, \
reconstructed in Q per sample, and the Q-coefficients of N_g are interpolated \
as symmetric (alpha1<->alpha2, eps1<->eps2) homogeneous polynomials, with \
verification on spare samples. The degree-zero term F_g(0) is rational in the \
weights and is computed symbolically from the monochromatic graphs at Q = 0.\
\>", "Text"],

Cell["\<\
Evaluate top to bottom. The sampling cell takes about 75 s per weight sample \
(100 samples are used; 83 are needed at genus 3); set recompute = False to \
load the stored results resolvedconifold_results.m instead. Requires \
StableGraph-2.bin and StableGraph-3.bin in the notebook directory.\
\>", "Text"],

Cell[BoxData[
 Sec["Setup: Frobenius structure, canonical coordinates, Delta"]], "Input"],

Cell["SetDirectory[NotebookDirectory[]]; recompute = False;", "Input"],

Cell["\<\
(* ===== Resolved conifold x C^2, general five-dimensional torus: setup =====
   Weights: alpha0 = tangent weight of P1 at the fixed point p = 0, alpha1, \
alpha2 = fibre weights there,
   -eps1, -eps2 = weights on C^2. Normal weights at the two fixed points:
     p = 0      : (alpha0, alpha1, alpha2, -eps1, -eps2)
     p = -alpha0: (-alpha0, alpha0+alpha1, alpha0+alpha2, -eps1, -eps2)
   Calabi-Yau condition: c1 = eps1 + eps2 - alpha0 - alpha1 - alpha2 = 0.  *)

a0 = \\[Alpha][0]; a1 = \\[Alpha][1]; a2 = \\[Alpha][2]; e1 = \\[Epsilon][1]; \
e2 = \\[Epsilon][2];
CYearly = False;                       (* True: impose the CY condition from \
the start *)
CYrepl = {\\[Alpha][0] -> \\[Epsilon][1] + \\[Epsilon][2] - \\[Alpha][1] - \
\\[Alpha][2]};
cy[x_] := If[CYearly, x /. CYrepl, x];

(* --- degree-zero prepotential and metric, basis {1, p}, p (p + alpha0) = 0 \
--- *)
Replp2 = -Expand[p (p + a0)] + p^2;
exp3 = Simplify[Expand[Expand[Expand[(t[0] + t[1] p)^3] /. p^4 -> p^2 Replp2] \
/. p^3 -> p Replp2] /. p^2 -> Replp2];
PrepCl = cy[Simplify[Normal[Series[((exp3/a0/(-p + a2)/(-p + a1)/e1/e2 /. p \
-> 0) + (exp3/(-a0)/(-p + a2)/(-p + a1)/e1/e2 /. p -> -a0))/6, {t[0], 0, 3}, \
{t[1], 0, 3}]]]];
eta = Table[Simplify[D[D[D[PrepCl, t[0]], t[i]], t[j]]], {i, 0, 1}, {j, 0, 1}];
etainv = Simplify[Inverse[eta]];
(* full genus-zero potential: the mirror map is trivial, Q = e^{t1} *)
Prep = PrepCl + PolyLog[3, Exp[t[1]]]/(e1 e2);
Do[cch[i, j, k] = Simplify[Sum[etainv[[i + 1, m + 1]] D[D[D[Prep, t[m]], \
t[j]], t[k]], {m, 0, 1}] /. t[1] -> Log[Q]], {i, 0, 1}, {j, 0, 1}, {k, 0, 1}];

(* --- canonical coordinates: L = du_i/dt1 are the two roots of Leq --- *)
Leq = Together[L^2 - cch[0, 1, 1] - cch[1, 1, 1] L];
Ssum = Together[cch[1, 1, 1]];        (* L1 + L2 *)
Pprod = Together[-cch[0, 1, 1]];      (* L1 L2 *)
RedLeq[arg_, var_] := Block[{out = Together[arg]},
   Together[PolynomialRemainder[Numerator[out], Leq /. L -> var, \
var]/PolynomialRemainder[Denominator[out], Leq /. L -> var, var]]];
(* reduce a rational function of LLL[1][Q], LLL[2][Q] symmetric under the \
exchange to a rational function of Q *)
SymRed[arg_] := Module[{e, num, den, denc, n2, d2},
   e = RedLeq[arg /. LLL[2][Q] -> Ssum - LLL[1][Q], LLL[1][Q]];
   num = Numerator[e]; den = Denominator[e];
   denc = den /. LLL[1][Q] -> Ssum - LLL[1][Q];
   n2 = RedLeq[num denc, LLL[1][Q]]; d2 = RedLeq[den denc, LLL[1][Q]];
   If[! FreeQ[{n2, d2}, LLL], Print[\"SymRed: result not symmetric!\"]; \
Abort[]];
   Together[n2/d2]];
(* derivative of a root with respect to Q *)
LDer[Lv_] := Together[-D[Leq, Q]/D[Leq, L] /. L -> Lv];
(* Q -> 0 limits of the roots (to first order in Q): root 1 -> 0 (fixed point \
p = 0), root 2 -> -alpha0 *)
Module[{LeqPoly = Numerator[Together[Leq]], l1, l2, sol},
  Do[sol = First[Solve[Thread[Rest[CoefficientList[Normal[Series[LeqPoly /. L \
-> L0[i] + Q l1 + Q^2 l2, {Q, 0, 2}]], Q]] == 0], {l1, l2}]];
     LLR[i] = L0[i] + Q l1 + Q^2 l2 /. sol, {i, {1, 2}}] /. {L0[1] -> 0, \
L0[2] -> -a0}];
(* square lengths of the normalised idempotents: Psi = {{1, L1}, {1, L2}}, \
Delta_i = 1/(Psi^-T eta Psi^-1)_ii *)
Module[{Psi = {{1, L1}, {1, L2}}, etacan},
  etacan = Simplify[Transpose[Inverse[Psi]] . eta . Inverse[Psi]];
  DeltaL = RedLeq[1/etacan[[1, 1]] /. L2 -> Ssum - L1 /. L1 -> L, L]];   (* \
Delta as a rational function of the root L *)
Delta[i_] := DeltaL /. L -> LLL[i][Q];
DeltaDer[i_] := Together[(D[DeltaL, Q] + D[DeltaL, L] LDer[L]) /. L -> \
LLL[i][Q]];     (* dDelta_i/dQ *)
Print[\"setup done; Leq = \", Leq];\
\>", "Input"],

Cell[BoxData[
 Sec["Arithmetic in the quadratic algebra"]], "Input"],

Cell["\<\
(* ===== exact arithmetic in K[L]/(L^2 - S L + P), K = Q(Q, alpha0, alpha1, \
alpha2, eps1, eps2) =====
   An element a + b L (L = LLL[1][Q], the first root) is represented as C[a, \
b]; the second root is S - L,
   so the \"conjugate\" of C[a, b] is C[a + b S, -b]. Requires Ssum, Pprod \
from rc_setup.wl. *)

cTog[x_] := Together[x];
cadd[C[a_, b_], C[c_, d_]] := C[cTog[a + c], cTog[b + d]];
cadd[x__] := Fold[cadd, C[0, 0], {x}];
cscale[k_, C[a_, b_]] := C[cTog[k a], cTog[k b]];
cmul[C[a_, b_], C[c_, d_]] := C[cTog[a c - b d Pprod], cTog[a d + b c + b d \
Ssum]];   (* L^2 = S L - P *)
cmul[x__] := Fold[cmul, C[1, 0], {x}];
cconj[C[a_, b_]] := C[cTog[a + b Ssum], cTog[-b]];
cnorm[C[a_, b_]] := cTog[a^2 + a b Ssum + b^2 Pprod];            (* (a + b \
L)(a + b Lbar) = a^2 + ab S + b^2 P *)
cinv[C[a_, b_]] := Module[{n = cnorm[C[a, b]]}, C[cTog[(a + b Ssum)/n], \
cTog[-b/n]]];
cpow[c_, 0] := C[1, 0];
cpow[c_, n_Integer?Positive] := cmul @@ ConstantArray[c, n];
cpow[c_, n_Integer?Negative] := cpow[cinv[c], -n];
(* convert an expression rational in L into canonical form; also accepts \
expressions already in C form *)
genSym = L;   (* generator of the quadratic algebra (L in the symbolic setup, \
U in the numeric layer) *)
toC[e_] := Module[{r, num, den, a, b, c, d, v = genSym},
   r = Together[e]; num = PolynomialRemainder[Numerator[r], v^2 - Ssum v + \
Pprod, v];
   den = PolynomialRemainder[Denominator[r], v^2 - Ssum v + Pprod, v];
   a = Coefficient[num, v, 0]; b = Coefficient[num, v, 1]; c = \
Coefficient[den, v, 0]; d = Coefficient[den, v, 1];
   cmul[C[a, b], cinv[C[c, d]]]];
(* evaluate a polynomial in symbols (with integer powers, negative allowed) \
whose values are C-elements *)
symPow[sym_, n_, symvals_] := symPow[sym, n, symvals] = cpow[symvals[sym], \
n];
termEval[t_, symvals_] := Module[{facs = If[Head[t] === Times, List @@ t, \
{t}], coef = 1, fac = C[1, 0]},
   Do[Which[KeyExistsQ[symvals, f], fac = cmul[fac, symvals[f]],
      MatchQ[f, Power[_, _Integer]] && KeyExistsQ[symvals, f[[1]]], fac = \
cmul[fac, symPow[f[[1]], f[[2]], symvals]],
      True, coef = coef f], {f, facs}];
   cscale[coef, fac]];
cEval[poly_, symvals_Association] := Module[{ex = Expand[poly], terms},
   terms = If[Head[ex] === Plus, List @@ ex, {ex}];
   cadd @@ (termEval[#, symvals] & /@ terms)];
(* canonical element -> ordinary expression (for display) *)
cExpr[C[a_, b_]] := a + b genSym;
(* symmetric part check: an element symmetric under L -> S - L has b = 0 *)
cSymQ[C[a_, b_]] := Together[b] === 0;\
\>", "Input"],

Cell[BoxData[
 Sec["R-matrix to z^6 at numeric weights; graph factors at numeric Q"]], \
"Input"],

Cell["ZMAX = 6;", "Input"],

Cell["\<\
(* ===== numeric (exact rational) evaluation of the resolved-conifold \
pipeline at given weights and Q =====
   Requires rc_algebra.wl (C-element arithmetic with global Ssum, Pprod) and \
ZMAX.
   Generator of the quadratic algebra: U = e^s at the critical point of the \
mirror superpotential,
     Q (a0+a1) U^2 - (a0 + Q (a1-a2)) U - a2 = 0,   L = -(Q (a0+a1) U + Q \
a2)/(1-Q),
   root U1 -> -a2/a0 as Q -> 0 (fixed point p = 0, weights \
(a0,a1,a2,-e1,-e2)), U2 ~ a0/(Q (a0+a1)) (the other fixed point). *)

(* --- symbolic pieces computed once --- *)
Wsym[1] = Together[U D[a1 Log[1 - Q U] - a2 Log[U] + (a0 + a2) Log[1 - U], U]];
Do[Wsym[k] = Together[U D[Wsym[k - 1], U]], {k, 2, 2 ZMAX + 2}];
Module[{ser, tot},
  ser = Series[Exp[Sum[Wk[k] x^k/(k! z), {k, 3, 2 ZMAX + 2}]], {x, 0, 6 ZMAX}];
  tot = Sum[SeriesCoefficient[ser, 2 n] (2 n)! (-z)^n/(n! 2^n Wk[2]^n), {n, \
0, 3 ZMAX}];
  wickZ = Table[Expand[Coefficient[Normal[Series[tot, {z, 0, ZMAX}]], z, m]], \
{m, 0, ZMAX}]];
LofU = -(Q (a0 + a1) U + Q a2)/(1 - Q);
etaSym = {{(a0 + a1 + a2)/(a1 (a0 + a1) a2 (a0 + a2) e1 e2), 1/((a0 + a1) (a0 \
+ a2) e1 e2)}, {1/((a0 + a1) (a0 + a2) e1 e2), -(a0/((a0 + a1) (a0 + a2) e1 \
e2))}};
etainvSym = Simplify[Inverse[etaSym]];
wtSym[1] = {a0, a1, a2, -e1, -e2}; wtSym[2] = {-a0, a0 + a1, a0 + a2, -e1, \
-e2};
QrrcSym[i_, k_] := (BernoulliB[2 k + 2]/(2 k + 2)/(2 k + 1)) Sum[1/w^(2 k + \
1), {w, wtSym[i]}];

(* --- R-matrix at numeric weights, symbolic Q (algebra over Q(Q)) --- *)
rmatrixAt[wsub_] := Module[{SU, PU, LeqU, U1ser, U2ser, lim, eqs, sol, dUC, \
etainvN, DeltaLN, m, i, k, ffcvN},
   genSym = U;
   SU = (a0 + Q (a1 - a2))/(Q (a0 + a1)) /. wsub; PU = -a2/(Q (a0 + a1)) /. \
wsub;
   SsumQ = Together[SU]; PprodQ = Together[PU]; Ssum = SsumQ; Pprod = PprodQ; \
     (* globals used by the algebra; the Q-symbolic versions are kept in \
SsumQ, PprodQ *)
   LeqU = Q (a0 + a1) U^2 - (a0 + Q (a1 - a2)) U - a2 /. wsub;
   (* roots as series in Q: U1 regular, U2 = S - U1 *)
   Module[{c, sol1}, sol1 = \
First[Solve[Thread[Rest[CoefficientList[Normal[Series[LeqU /. U -> Sum[c[j] \
Q^j, {j, 0, 4}], {Q, 0, 4}]], Q]] == 0] /. c[0] -> (-a2/a0 /. wsub), \
Table[c[j], {j, 1, 4}]]];
     U1ser = Sum[c[j] Q^j, {j, 0, 4}] /. c[0] -> (-a2/a0 /. wsub) /. sol1];
   U2ser = Together[SU - U1ser];
   Do[WcN[k] = toC[Wsym[k] /. wsub], {k, 2, 2 ZMAX + 2}];
   wsymN = Association[Table[Wk[k] -> WcN[k], {k, 2, 2 ZMAX + 2}]];
   Clear[symPow];
   symPow[sym_, n_, symvals_] := symPow[sym, n, symvals] = cpow[symvals[sym], \
n];
   Do[wickCN[m] = cEval[wickZ[[m + 1]], wsymN], {m, 0, ZMAX}];
   (* QRR normalisation constants from the Q -> 0 limit at each root *)
   Do[Module[{Wser, wickser, ff},
      Wser = Association[Table[Wk[k] -> (Wsym[k] /. wsub /. U -> If[i == 1, \
U1ser, U2ser]), {k, 2, 2 ZMAX + 2}]];
      lim = Table[Normal[Series[wickZ[[m + 1]] /. Wser, {Q, 0, 0}]], {m, 0, \
ZMAX}];
      If[! FreeQ[lim, Q], Print[\"WARNING: Q->0 limit not finite at root \", \
i, \": \", lim]];
      ff = Normal[Series[Exp[-Sum[QrrcSym[i, k] z^(2 k + 1) /. wsub, {k, 0, \
ZMAX}]], {z, 0, ZMAX}]];
      eqs = CoefficientList[Normal[Series[Sum[lim[[m + 1]] z^m, {m, 0, ZMAX}] \
(1 + Sum[ffc[k] z^k, {k, 1, ZMAX}]), {z, 0, ZMAX}]] - ff, z];
      sol = First[Solve[Thread[eqs == 0], Table[ffc[k], {k, 1, ZMAX}]]];
      ffcvN[i, 0] = 1; Do[ffcvN[i, k] = ffc[k] /. sol, {k, 1, ZMAX}]], {i, 1, \
2}];
   Do[ratCN[0, 1][m] = cadd @@ Table[cscale[ffcvN[1, k], wickCN[m - k]], {k, \
0, m}], {m, 0, ZMAX}];
   Do[ratCN[0, 2][m] = cadd @@ Table[cscale[ffcvN[2, k], cconj[wickCN[m - \
k]]], {k, 0, m}], {m, 0, ZMAX}];
   (* derivatives, Delta, L *)
   dUC = toC[-D[LeqU, Q]/D[LeqU, U]];
   cDerN[C[a_, b_]] := cadd[C[Together[D[a, Q]], Together[D[b, Q]]], \
cscale[b, dUC]];
   etainvN = etainvSym /. wsub;
   LCN[1] = toC[LofU /. wsub]; LCN[2] = cconj[LCN[1]];
   DeltaLN = DeltaL /. wsub /. L -> (LofU /. wsub);      (* DeltaL from \
rc_setup.wl: function of L and Q *)
   DeltaCN[1] = toC[DeltaLN]; DeltaCN[2] = cconj[DeltaCN[1]];
   Do[dlogDeltaN[i] = cmul[cDerN[DeltaCN[i]], cinv[cscale[2, DeltaCN[i]]]], \
{i, 1, 2}];
   Do[ratCN[1, i][0] = cmul[LCN[i], ratCN[0, i][0]];
      Do[ratCN[1, i][m] = cadd[cmul[LCN[i], ratCN[0, i][m]], cscale[Q, \
cadd[cDerN[ratCN[0, i][m - 1]], cscale[-1, cmul[ratCN[0, i][m - 1], \
dlogDeltaN[i]]]]]], {m, 1, ZMAX}], {i, 1, 2}];
   etainvCur = etainvN;
   \"ok\"];

(* --- everything at a numeric Q: factors as numeric C-elements --- *)
evalQ[Q0_] := Module[{sub = {Q -> Q0}, i, j, m, n, k, pre},
   Ssum = Together[SsumQ /. sub]; Pprod = Together[PprodQ /. sub];   (* \
numeric algebra data for this Q *)
   Do[Do[rN[a, i][m] = ratCN[a, i][m] /. sub, {m, 0, ZMAX}], {a, 0, 1}, {i, \
1, 2}];
   Do[DeltaN[i] = DeltaCN[i] /. sub, {i, 1, 2}];
   Do[DilN[i][n] = cscale[(-1)^n, rN[0, i][n - 1]], {i, 1, 2}, {n, 1, ZMAX + \
1}];
   Do[LfN[i][n] = cscale[(-1)^n, rN[1, i][n]], {i, 1, 2}, {n, 0, ZMAX}];
   Do[pre = Table[cadd @@ Flatten[Table[cscale[-(-1)^(p + q) etainvCur[[a + \
1, b + 1]], cmul[rN[a, i][p], rN[b, j][q]]], {a, 0, 1}, {b, 0, 1}]], {p, 0, \
ZMAX}, {q, 0, ZMAX}];
      Do[EdN[i, j][m, n] = cadd @@ Table[cscale[(-1)^k, pre[[m + k + 2, n - k \
+ 1]]], {k, 0, n}], {m, 0, ZMAX - 1}, {n, 0, ZMAX - 1 - m}], {i, 1, 2}, {j, \
1, 2}];
   \"ok\"];\
\>", "Input"],

Cell[BoxData[
 Sec["Decorated stable graphs and the graph sum"]], "Input"],

Cell["\<\
(* ===== decorated stable graphs and the Givental graph sum with C-element \
factors (two idempotents) =====
   Enumeration routines identical to localp2CY5_genus3.nb. Weight convention: \
1/|Aut(Gamma)| times the sum over
   all labelled psi-assignments (half-edges, legs, dilaton leaves) and all \
colourings in {1,2}^V, with the factors
   1/m_v! (legs) and 1/nd_v! (dilaton leaves) and the Witten-Kontsevich \
number at each vertex.
   Each half-edge, leg and dilaton leaf carries 1/sqrtDelta of its colour and \
the vertex sqrtDelta^(2g-2+|H|),
   so the net vertex factor is Delta_c^(g_v - 1). *)

df[n_] := If[n <= 0, 1, n df[n - 2]];
splitSum[g_, k_, rest_] := Module[{n = Length[rest], idx, tot = 0},
   Do[idx = Subsets[Range[n]][[m]];
    tot += Sum[df[2 r + 1] df[2 (k - 1 - r) + 1] Sum[wk[g1, Join[{r}, \
rest[[idx]]]] wk[g - g1, Join[{k - 1 - r}, rest[[Complement[Range[n], \
idx]]]]], {g1, 0, g}], {r, 0, k - 1}], {m, 2^n}]; tot];
wk[g_, ds_List] := wk[g, ds] = Module[{d = Sort[ds], n, k, rest, tot}, n = \
Length[d];
   If[g < 0 || n == 0 || Min[d] < 0 || Total[d] != 3 g - 3 + n || 2 g - 2 + n \
<= 0, Return[0]];
   If[g == 0 && d == {0, 0, 0}, Return[1]]; If[g == 1 && d == {1}, \
Return[1/24]];
   If[MemberQ[d, 0], rest = Delete[d, First[Position[d, 0]]]; \
Return[Sum[wk[g, ReplacePart[rest, j -> rest[[j]] - 1]], {j, \
Length[rest]}]]];
   k = d[[1]] - 1; rest = Rest[d];
   tot = Sum[df[2 k + 2 rest[[j]] + 1]/df[2 rest[[j]] - 1] wk[g, \
ReplacePart[rest, j -> rest[[j]] + k]], {j, Length[rest]}];
   tot += 1/2 Sum[df[2 r + 1] df[2 (k - 1 - r) + 1] wk[g - 1, Join[{r, k - 1 \
- r}, rest]], {r, 0, k - 1}];
   tot += 1/2 splitSum[g, k, rest]; tot/df[2 k + 3]];

tabtoadj[diag_, up_] := Module[{K = Length[diag], A}, A = ConstantArray[0, \
{K, K}];
   Do[A[[j, j]] = diag[[j]]; Do[A[[i, j]] = A[[j, i]] = up[[j, i - j]], {i, j \
+ 1, K}], {j, 1, K}]; A];
graphlist[raw_] := Module[{count = 1, K, g, m, l, atab, a, out = {}, adj},
   While[count <= Length[raw],
    K = raw[[count]]; g = Take[raw, {count + 1, count + K}]; m = Take[raw, \
{count + K + 1, count + 2 K}];
    l = Take[raw, {count + 2 K + 1, count + 3 K}]; a = {};
    If[K > 1, atab = Take[raw, {count + 3 K + 1, count + 3 K + K (K - 1)/2}];
     Do[AppendTo[a, Take[atab, K - j]]; atab = Drop[atab, K - j], {j, 1, K - \
1}]];
    adj = tabtoadj[l, a]; AppendTo[out, {g, m, adj}];
    count += 3 K + Length[Flatten[a]] + 1]; out];
loadGraphs[gg_] := \
graphlist[DeleteCases[Delete[Delete[BinaryReadList[\"StableGraph-\" <> \
ToString[gg] <> \".bin\"], 1], -1], 13]];
graphsWithLegs[0, 3] = {{{0}, {3}, {{0}}}};
graphsWithLegs[0, 4] = {{{0}, {4}, {{0}}}, {{0, 0}, {2, 2}, {{0, 1}, {1, 0}}}};
graphsWithLegs[0, 5] = {{{0}, {5}, {{0}}}, {{0, 0}, {2, 3}, {{0, 1}, {1, \
0}}}, {{0, 0, 0}, {2, 1, 2}, {{0, 1, 0}, {1, 0, 1}, {0, 1, 0}}}};
graphsWithLegs[1, 1] = {{{1}, {1}, {{0}}}, {{0}, {1}, {{1}}}};
graphsWithLegs[g_, 0] := loadGraphs[g];
edgesOf[A_] := Join[Flatten[Table[ConstantArray[{i, i}, A[[i, i]]], {i, \
Length[A]}], 1],
   Flatten[Table[ConstantArray[{i, j}, A[[i, j]]], {i, Length[A]}, {j, i + 1, \
Length[A]}], 2]];
autCount[gv_, mv_, A_] := Module[{V = Length[gv], perms},
   perms = Select[Permutations[Range[V]], gv[[#]] == gv && mv[[#]] == mv && \
A[[#, #]] == A &];
   Length[perms] Product[A[[i, j]]!, {i, 1, V}, {j, i + 1, V}] \
Product[2^A[[i, i]] A[[i, i]]!, {i, 1, V}]];
vertexOptions[g_, hs_, m_] := Module[{res = {}, dim, nd, dils, hp, lp, budget},
   Do[dim = 3 g - 3 + hs + m + nd; If[dim < 2 nd, Continue[]];
    Do[budget = dim - Total[dils];
     Do[Do[AppendTo[res, {hp, lp, dils, wk[g, Join[hp, lp, dils]]/(m! nd!)}],
       {lp, Select[Tuples[Range[0, budget - Total[hp]], m], Total[#] == \
budget - Total[hp] &]}],
      {hp, Select[Tuples[Range[0, budget], hs], Total[#] <= budget &]}],
     {dils, If[nd == 0, {{}}, Flatten[Table[Permutations /@ \
Select[IntegerPartitions[s, {nd}], Min[#] >= 2 &], {s, 2 nd, dim}], 2]]}],
    {nd, 0, Max[0, 3 g - 3 + hs + m]}];
   Select[res, #[[4]] =!= 0 &]];
prepareGraph[{gv_, mv_, A_}] := Module[{V = Length[gv], ed, H, hv, hsAt, \
opts, decs, aut},
   ed = edgesOf[A]; H = Flatten[Table[{{e, 1}, {e, 2}}, {e, Length[ed]}], 1];
   hv = Table[ed[[h[[1]], h[[2]]]], {h, H}];
   hsAt = Table[Flatten[Position[hv, v]], {v, V}];
   opts = Table[vertexOptions[gv[[v]], Length[hsAt[[v]]], mv[[v]]], {v, V}];
   decs = Tuples[opts]; aut = autCount[gv, mv, A];
   <|\"g\" -> gv, \"m\" -> mv, \"A\" -> A, \"edges\" -> ed, \"H\" -> H, \
\"hsAt\" -> hsAt, \"decs\" -> decs, \"aut\" -> aut, \"V\" -> V|>];

(* graph value as a C-element, using the numeric factors DilN, LfN, EdN, \
DeltaN set by evalQ *)
graphValueC[gr_] := Module[{V = gr[\"V\"], ed = gr[\"edges\"], H = gr[\"H\"], \
hsAt = gr[\"hsAt\"], total = C[0, 0], hp, facs},
   Do[Do[hp = ConstantArray[0, Length[H]];
     Do[Do[hp[[hsAt[[v, r]]]] = dec[[v, 1, r]], {r, Length[hsAt[[v]]]}], {v, \
V}];
     facs = Join[
       Table[cpow[DeltaN[c[[v]]], gr[\"g\"][[v]] - 1], {v, V}],
       Flatten[Table[Table[LfN[c[[v]]][b], {b, dec[[v, 2]]}], {v, V}]],
       Flatten[Table[Table[DilN[c[[v]]][d], {d, dec[[v, 3]]}], {v, V}]],
       Table[EdN[c[[ed[[e, 1]]]], c[[ed[[e, 2]]]]][hp[[2 e - 1]], hp[[2 e]]], \
{e, Length[ed]}]];
     total = cadd[total, cscale[Product[dec[[v, 4]], {v, V}], cmul @@ facs]], \
{dec, gr[\"decs\"]}], {c, Tuples[{1, 2}, V]}];
   cscale[1/gr[\"aut\"], total]];
graphSumC[prepared_] := cadd @@ (graphValueC /@ prepared);\
\>", "Input"],

Cell["\<\
Regression at a sample point: genus 0 (Li3 derivatives), genus 1 (the three \
graphs of the old notebook), symplecticity\
\>", "Subsection"],

Cell["\<\
wsub = {a0 -> 3, a1 -> 5, a2 -> 7, e1 -> 11, e2 -> 13}; rmatrixAt[wsub]; Q0 = \
1/5; evalQ[Q0];
symp = Table[cadd @@ Flatten[Table[cscale[(-1)^m etainvCur[[a + 1, c + 1]], \
cmul[rN[b, i][m], rN[c, i][n - m], cinv[DeltaN[i]]]], {i, 1, 2}, {c, 0, 1}, \
{m, 0, n}], 2], {a, 0, 1}, {b, 0, 1}, {n, 0, ZMAX}];
Print[\"symplecticity residuals: \", Union[Flatten[Table[cadd[symp[[a + 1, b \
+ 1, n + 1]], C[-KroneckerDelta[a, b] KroneckerDelta[n, 0], 0]], {a, 0, 1}, \
{b, 0, 1}, {n, 0, ZMAX}]]]];
F11old = (\[Alpha][0]^3*\[Epsilon][1] + \
\[Alpha][0]^2*\[Alpha][1]*\[Epsilon][1] + Q*\[Alpha][0]^2*\[Alpha][1]*\
\[Epsilon][1] + Q*\[Alpha][0]*\[Alpha][1]^2*\[Epsilon][1] + \[Alpha][0]^2*\
\[Alpha][2]*\[Epsilon][1] + Q*\[Alpha][0]^2*\[Alpha][2]*\[Epsilon][1] + \
\[Alpha][0]*\[Alpha][1]*\[Alpha][2]*\[Epsilon][1] + \
2*Q*\[Alpha][0]*\[Alpha][1]*\[Alpha][2]*\[Epsilon][1] + Q*\[Alpha][1]^2*\
\[Alpha][2]*\[Epsilon][1] + Q*\[Alpha][0]*\[Alpha][2]^2*\[Epsilon][1] + Q*\
\[Alpha][1]*\[Alpha][2]^2*\[Epsilon][1] + \[Alpha][0]^3*\[Epsilon][2] + \
\[Alpha][0]^2*\[Alpha][1]*\[Epsilon][2] + Q*\[Alpha][0]^2*\[Alpha][1]*\
\[Epsilon][2] + Q*\[Alpha][0]*\[Alpha][1]^2*\[Epsilon][2] + \[Alpha][0]^2*\
\[Alpha][2]*\[Epsilon][2] + Q*\[Alpha][0]^2*\[Alpha][2]*\[Epsilon][2] + \
\[Alpha][0]*\[Alpha][1]*\[Alpha][2]*\[Epsilon][2] + \
2*Q*\[Alpha][0]*\[Alpha][1]*\[Alpha][2]*\[Epsilon][2] + Q*\[Alpha][1]^2*\
\[Alpha][2]*\[Epsilon][2] + Q*\[Alpha][0]*\[Alpha][2]^2*\[Epsilon][2] + Q*\
\[Alpha][1]*\[Alpha][2]^2*\[Epsilon][2] - \[Alpha][0]^2*\[Epsilon][1]*\
\[Epsilon][2] - Q*\[Alpha][0]^2*\[Epsilon][1]*\[Epsilon][2] - \
2*Q*\[Alpha][0]*\[Alpha][1]*\[Epsilon][1]*\[Epsilon][2] - 2*Q*\[Alpha][0]*\
\[Alpha][2]*\[Epsilon][1]*\[Epsilon][2] + \
\[Alpha][1]*\[Alpha][2]*\[Epsilon][1]*\[Epsilon][2] - \
3*Q*\[Alpha][1]*\[Alpha][2]*\[Epsilon][1]*\[Epsilon][2])/(24*(-1 + Q)*(\
\[Alpha][0] + \[Alpha][1])*(\[Alpha][0] + \[Alpha][2])*\[Epsilon][1]*\
\[Epsilon][2]);
Do[Module[{prep = prepareGraph /@ graphsWithLegs @@ gn, val, ref},
   val = graphSumC[prep];
   ref = Switch[gn, {0, 3}, ((a0^2/((a0 + a1) (a0 + a2) e1 e2)) + Q/((1 - Q) \
e1 e2))/3!, {0, 4}, Q/((1 - Q)^2 e1 e2)/4!, {0, 5}, Q (1 + Q)/((1 - Q)^3 e1 \
e2)/5!, {1, 1}, F11old] /. wsub /. Q -> Q0;
   Print[gn, \": graph sum = \", val, \"   reference = \", ref, \"   \
difference = \", Together[val[[1]] - ref]]], {gn, {{0, 3}, {0, 4}, {0, 5}, \
{1, 1}}}]\
\>", "Input"],

Cell[BoxData[
 Sec["Degree-zero terms (symbolic)"]], "Input"],

Cell["\<\
(* ===== degree-zero (constant map) part F_{g,0}(weights), symbolic =====
   At Q = 0 the R-matrix is block diagonal: PP[0,i] = ff_i(z)/sD_i, PP[1,i] = \
L_i(0) PP[0,i], with ff_i the QRR exponential
   and L_1(0) = 0, L_2(0) = -a0. Only monochromatic graphs contribute; the \
vertex factor is Delta_i(0)^(g_v-1). *)
const0[gg_] := Module[{ffs, Del0, res = 0, prep},
   Do[ffs[i] = CoefficientList[Normal[Series[Exp[-Sum[QrrcSym[i, k] z^(2 k + \
1), {k, 0, ZMAX}]], {z, 0, ZMAX}]], z];
      Del0[i] = Together[DeltaL /. Q -> 0 /. L -> {0, -a0}[[i]]], {i, 1, 2}];
   prep = prepareGraph /@ graphsWithLegs[gg, 0];
   Do[Module[{i = col, tot = 0},
      (* numeric-style factors as plain expressions: Dil[n] = (-1)^n \
ff_{n-1}, Ed[m,n] = sum_k (-1)^k pre[m+k+1, n-k], pre[p,q] = -(-1)^(p+q) ff_p \
ff_q *)
      Do[Dil0[n] = (-1)^n ffs[i][[n]], {n, 1, ZMAX + 1}];
      Do[Ed0[m, n] = Del0[i] Sum[(-1)^k (-(-1)^(m + k + 1 + n - k) ffs[i][[m \
+ k + 2]] ffs[i][[n - k + 1]]), {k, 0, n}], {m, 0, ZMAX - 1}, {n, 0, ZMAX - 1 \
- m}];
      Do[Module[{V = gr[\"V\"], ed = gr[\"edges\"], H = gr[\"H\"], hsAt = gr[\
\"hsAt\"], hp, gsum},
        Do[hp = ConstantArray[0, Length[H]];
         Do[Do[hp[[hsAt[[v, r]]]] = dec[[v, 1, r]], {r, Length[hsAt[[v]]]}], \
{v, V}];
         tot += (1/gr[\"aut\"]) Product[dec[[v, 4]], {v, V}] Product[Dil0[d], \
{v, V}, {d, dec[[v, 3]]}] Product[Ed0[hp[[2 e - 1]], hp[[2 e]]], {e, \
Length[ed]}] Del0[i]^(Total[gr[\"g\"]] - V),
         {dec, gr[\"decs\"]}]], {gr, prep}];
      res += Together[tot]], {col, 1, 2}];
   Together[res]];\
\>", "Input"],

Cell["\<\
F0[2] = const0[2]; F0[3] = const0[3]; F11const = \
(-(\[Alpha][0]^3*\[Epsilon][1]) - \[Alpha][0]^2*\[Alpha][1]*\[Epsilon][1] - \
\[Alpha][0]^2*\[Alpha][2]*\[Epsilon][1] - \
\[Alpha][0]*\[Alpha][1]*\[Alpha][2]*\[Epsilon][1] - \
\[Alpha][0]^3*\[Epsilon][2] - \[Alpha][0]^2*\[Alpha][1]*\[Epsilon][2] - \
\[Alpha][0]^2*\[Alpha][2]*\[Epsilon][2] - \
\[Alpha][0]*\[Alpha][1]*\[Alpha][2]*\[Epsilon][2] + \
\[Alpha][0]^2*\[Epsilon][1]*\[Epsilon][2] - \
\[Alpha][1]*\[Alpha][2]*\[Epsilon][1]*\[Epsilon][2])/(24*(\[Alpha][0] + \
\[Alpha][1])*(\[Alpha][0] + \[Alpha][2])*\[Epsilon][1]*\[Epsilon][2]);
Print[\"F_{2,0} = \", F0[2]]; Print[\"F_{3,0} = \", F0[3]];\
\>", "Input"],

Cell[BoxData[
 Sec["Sampling, Q-reconstruction and weight interpolation"]], "Input"],

Cell["\<\
(* reconstruction of F(Q) from exact samples {q, v}: try F = P(Q)/(1-Q)^a, \
deg P <= n - 5 - ... , verified on 5 spare points *)
reconQ[pts_, amax_: 16] := Module[{n = Length[pts], qs = pts[[All, 1]], vs = \
pts[[All, 2]], a, w, P, ok, res = $Failed},
   Do[w = Table[vs[[i]] (1 - qs[[i]])^a, {i, n}];
    P = InterpolatingPolynomial[Transpose[{qs[[1 ;; n - 5]], w[[1 ;; n - \
5]]}], Q];
    ok = And @@ Table[(P /. Q -> qs[[i]]) == w[[i]], {i, n - 4, n}];
    If[ok, res = {Expand[P], a}; Return[]], {a, 0, amax}];
   res];\
\>", "Input"],

Cell["\<\
(* ===== interpolation of the instanton part over the weight samples =====
   F_g - F_{g,0} = N'_g(Q)/(1-Q)^a with N'_g(Q) = sum_{j=1}^{a} c_{g,j}(w) \
Q^j and eps1 eps2 c_{g,j}(w) a homogeneous polynomial
   of degree 2g in (a0,a1,a2,e1,e2), invariant under a1<->a2 and e1<->e2.  \
Usage: Get after loading rc_samples_*.mx files
   into `allSamples` (association i -> {wsub, \
{{N11,a11},{N20,a20},{N30,a30}}}). *)
vars = {a0, a1, a2, e1, e2};
orbitBasis[deg_] := Module[{mons, orb},
   mons = Select[Tuples[Range[0, deg], 5], Total[#] == deg &];
   orb[m_] := Union[{m, m[[{1, 3, 2, 4, 5}]], m[[{1, 2, 3, 5, 4}]], m[[{1, 3, \
2, 5, 4}]]}];
   Union[Table[Total[Times @@@ (vars^# & /@ orb[m])], {m, mons}]]];
(* fit one rational-valued function of the samples as a symmetric homogeneous \
polynomial of degree deg *)
fitPoly[values_Association, deg_] := Module[{basis = orbitBasis[deg], keys = \
Keys[values], A, rhs, sol, n, res},
   n = Length[basis];
   If[Length[keys] < n + 3, Print[\"not enough samples: \", Length[keys], \" \
< \", n + 3]; Return[$Failed]];
   A = Table[basis /. allSamples[k][[1]], {k, keys[[1 ;; n]]}]; rhs = \
Table[values[k], {k, keys[[1 ;; n]]}];
   sol = LinearSolve[A, rhs];
   res = Table[(basis /. allSamples[k][[1]]) . sol - values[k], {k, keys[[n + \
1 ;;]]}];
   If[Union[res] =!= {0}, Print[\"fitPoly: verification FAILED on \", \
Count[res, Except[0]], \" of \", Length[res], \" spare samples\"]; \
Return[$Failed]];
   Expand[basis . sol]];
(* assemble F_g for g = 1, 2, 3 (index gi = 1, 2, 3 in the sample records) *)
assemble[gi_, gdeg_] := Module[{a = Max[Table[allSamples[k][[2, gi, 2]], {k, \
Keys[allSamples]}]], cj, vals, Npoly = 0},
   Do[vals = Association[Table[k -> With[{NN = Expand[allSamples[k][[2, gi, \
1]] (1 - Q)^(a - allSamples[k][[2, gi, 2]])], w = allSamples[k][[1]]},
        Coefficient[NN - (NN /. Q -> 0) (1 - Q)^a, Q, j] (e1 e2 /. w)], {k, \
Keys[allSamples]}]];
      cj = fitPoly[vals, gdeg];
      If[cj === $Failed, Return[$Failed]];
      Npoly += cj Q^j, {j, 1, a}];
   {Npoly/(e1 e2 (1 - Q)^a), a}];\
\>", "Input"],

Cell["\<\
(* sampling driver: weight samples i1..i2 (about 75 s each); results are \
appended to the association `sample` and saved *)
runSamples[i1_, i2_, file_] := Module[{},
  Do[Module[{w = wsamples[[i]], wsub, vals, t0 = AbsoluteTime[], recs},
     wsub = {a0 -> w[[1]], a1 -> w[[2]], a2 -> w[[3]], e1 -> w[[4]], e2 -> \
w[[5]]};
     rmatrixAt[wsub];
     vals = Table[evalQ[q]; {q, graphSumC[prep11], graphSumC[prep2], \
graphSumC[prep3]}, {q, qs}];
     If[! (And @@ (cSymQ /@ Flatten[vals[[All, 2 ;;]]])), Print[\"sample \", \
i, \": NON-SYMMETRIC graph sum!\"]; Continue[]];
     recs = Table[reconQ[Table[{v[[1]], v[[k]][[1]]}, {v, vals}]], {k, 2, \
4}];
     If[MemberQ[recs, $Failed], Print[\"sample \", i, \": Q-reconstruction \
FAILED\"]; Continue[]];
     sample[i] = {wsub, recs};
     Print[\"sample \", i, \" \", w, \": pole orders \", recs[[All, 2]], \", \
numerator degrees \", Exponent[#[[1]], Q] & /@ recs, \"  (\", \
Round[AbsoluteTime[] - t0, 0.1], \" s)\"];
     DumpSave[file, {sample, wsamples}]], {i, i1, i2}]];
prep11 = prepareGraph /@ graphsWithLegs[1, 1]; prep2 = prepareGraph /@ \
graphsWithLegs[2, 0]; prep3 = prepareGraph /@ graphsWithLegs[3, 0];
SeedRandom[20260906];
okQ[w_] := And @@ (# != 0 & /@ {w[[1]], w[[2]], w[[3]], w[[1]] + w[[2]], \
w[[1]] + w[[3]], w[[4]], w[[5]], w[[1]] + w[[2]] + w[[3]], w[[4]] + w[[5]], \
w[[4]] + w[[5]] - w[[1]] - w[[2]] - w[[3]]});
wsamples = {}; While[Length[wsamples] < 400, Module[{w = RandomInteger[{-9, \
9}, 5]}, If[okQ[w] && ! MemberQ[wsamples, w], AppendTo[wsamples, w]]]];
qs = Table[1/(3 + 2 s) + 1/(50 + 3 s), {s, 0, 15}];
sample = <||>;\
\>", "Input"],

Cell["If[recompute, runSamples[1, 100, \"rc_samples_1_100.mx\"]]", "Input"],

Cell["\<\
If[recompute, allSamples = <||>;
Do[Get[f]; allSamples = Join[allSamples, sample], {f, \
FileNames[\"rc_samples_*.mx\"]}];
Print[\"samples loaded: \", Length[allSamples]];
res = <||>;
Do[Module[{r = assemble[gi, 2 gi]}, If[r === $Failed, Print[\"assembly FAILED \
for genus \", gi], res[gi] = r; Print[\"genus \", gi, \" assembled: pole \
order \", r[[2]]]]], {gi, 1, 3}];
F11inst = res[1][[1]]; F20inst = res[2][[1]]; F30inst = res[3][[1]];
F11 = F11inst + F11const; F20 = F20inst + F0[2]; F30 = F30inst + F0[3];
Put[{F11, F20, F30}, \"resolvedconifold_results.m\"];, {F11, F20, F30} = Get[\
\"resolvedconifold_results.m\"];
CYr = {a0 -> e1 + e2 - a1 - a2};
F11inst = F11 - (F11 /. Q -> 0); F20inst = F20 - (F20 /. Q -> 0); F30inst = \
F30 - (F30 /. Q -> 0);]\
\>", "Input"],

Cell[BoxData[
 Sec["Results and checks"]], "Input"],

Cell["Collect[Together[F30 - F0[3]], Q, Factor]", "Input"],

Cell["\<\
ep = (e1 + e2)/2; em = (e1 - e2)/2; c1 = e1 + e2 - a0 - a1 - a2;
paper1 = -(ep^2 + em^2)/12 + c1 ep/12;
paper2 = (3 ep^4 + 8 ep^2 em^2 + 3 em^4)/720 + c1 ep (2 a1 a2 + (a1 + a2) a0 \
+ a0^2 - 7 (a0 + a1 + a2) ep - 14 em^2)/1440;
Print[\"degree-1, genus 1 vs paper p.17 (should be 0): \", \
Simplify[SeriesCoefficient[Series[F11 e1 e2, {Q, 0, 1}], 1] - paper1]];
Print[\"degree-1, genus 2 vs paper p.17 (should be 0): \", \
Simplify[SeriesCoefficient[Series[F20 e1 e2, {Q, 0, 1}], 1] - paper2]];
deg1g3 = Factor[SeriesCoefficient[Series[F30 e1 e2, {Q, 0, 1}], 1]];
Print[\"degree-1, genus 3 (new): eps1 eps2 [Q^1] F_3 = \", deg1g3];
Print[\"   non-CY part divided by c1 e+: \", Factor[Together[(deg1g3 - \
(deg1g3 /. CYr))/(c1 ep)]]];
Pg[g_] := SeriesCoefficient[Series[e1 e2 t^2/(4 Sinh[e1 t/2] Sinh[e2 t/2]), \
{t, 0, 2 g}], 2 g];
Print[\"T_CY: F11 - F11(0) - Q dQ[P_1 Li_1(Q)]/(e1 e2) = \", \
Simplify[(F11inst /. CYr) - Q D[Pg[1] PolyLog[1, Q], Q]/(e1 e2)]];
Print[\"T_CY: F20 - F20(0) - P_2 Li_{-1}(Q)/(e1 e2) = \", Simplify[(F20inst \
/. CYr) - Pg[2] PolyLog[-1, Q]/(e1 e2)]];
Print[\"T_CY: F30 - F30(0) - P_3 Li_{-3}(Q)/(e1 e2) = \", Simplify[(F30inst \
/. CYr) - Pg[3] PolyLog[-3, Q]/(e1 e2)]];
Do[Module[{nc = Together[{F11inst, F20inst, F30inst}[[gi]] - ({F11inst, \
F20inst, F30inst}[[gi]] /. CYr)], quo},
   quo = Together[nc/(c1 ep)];
   Print[\"genus \", gi, \": (F - F|_CY)/(c1 e+) has no weight denominators \
besides eps1 eps2: \", FreeQ[Factor[Denominator[quo]], a0 | a1 | a2]]], {gi, \
1, 3}];\
\>", "Input"],

Cell["\<\
(* unrefined and Nekrasov-Shatashvili limits of the instanton parts *)
Print[\"unrefined (eps2 -> -eps1): \", Factor /@ ({F11inst, F20inst, F30inst} \
/. e2 -> -e1)];
Print[\"NS limit (eps2 -> 0) of eps1 eps2 F: \", Factor /@ (Limit[e1 e2 #, e2 \
-> 0] & /@ {F11inst, F20inst, F30inst})];\
\>", "Input"]
},
WindowSize->{1200, 900},
FrontEndVersion->"13.2 for Microsoft Windows (64-bit) (January 30, 2023)",
StyleDefinitions->"Default.nb"
]
(* End of Notebook Content *)

