(* check of lem:flh-inputs (iii): R'(-z)^T eta^-1 R'(z) = M (D(z)D(-z))^-1 M^-1 for R' = S M D^-1 M^-1, S symplectic constant isometry *)
z5 = Exp[2 Pi I/5];
nu = {0, -1, 3, 2, 1}; eps = {1, -1, -1, 1, 1};
eta = Table[If[Mod[a + b, 5] == 3, 5, 0], {a, 0, 4}, {b, 0, 4}];
etai = Inverse[eta];
Psi0 = Table[eps[[b + 1]] z5^(i (b + 1)), {b, 0, 4}, {i, 0, 4}];
nmax = 5;
Tk[k_, F_] := -F + (t/5) (k F - 4 t D[F, t]);
F0 = 1 + Sum[a[n] t^n, {n, 1, nmax}];
F1 = Tk[-1, F0]; F2 = -Tk[-2, F1]; F3 = Tk[2, F2]; F4 = -Tk[1, F3]; cl = -Tk[0, F4] - F0;
sol = Solve[Table[Coefficient[Expand[cl], t, n] == 0, {n, 1, nmax + 1}], Table[a[n], {n, 1, nmax}]][[1]];
Fs = Map[Normal[Series[#, {t, 0, nmax - 1}]] &, {F0, F1, F2, F3, F4} /. sol];
Rhat[tt_] := Table[z5^(i (b + 1)) (Fs[[b + 1]] /. t -> z5^(-i) tt), {b, 0, 4}, {i, 0, 4}];
M0[tt_] := Inverse[Psi0].Rhat[tt];
ord = 3;
trunc[m_] := Map[Normal[Series[#, {x, 0, ord}]] &, m, {2}];
Mx = trunc[M0[c x]]; Mmx = Mx /. x -> -x;
Minv = trunc[Inverse[Mx]];
D0[y_] := 1 + d1 y + d2 y^2 + d3 y^3;
Dx = DiagonalMatrix[Table[D0[z5^(-i) x], {i, 0, 4}]];
Dinv = trunc[Inverse[Dx]];
S = Inverse[DiagonalMatrix[Table[vs^(1 - nu[[b + 1]]), {b, 0, 4}]]].Psi0;
Rp = trunc[S.Mx.Dinv.Minv];
Rpm = Rp /. x -> -x;
lhs = trunc[Transpose[Rpm].etai.Rp];
DD = trunc[Inverse[Dx.(Dx /. x -> -x)]];
rhs = trunc[Mx.DD.Minv];
Print["(iii) identity mod x^4: ", Simplify[FullSimplify[lhs - rhs] == 0 IdentityMatrix[5]]];
Print["lhs - 1 at x^2, (0,0) entry: ", FullSimplify[Coefficient[lhs[[1, 1]], x, 2]]];
